---
/**
 * Maze Game Component
 * Interactive maze navigation with multiple themes and difficulty levels
 * Features: Canvas rendering, swipe/keyboard controls, collectibles, hints
 */

interface Props {
  locale?: 'de' | 'ar' | 'en' | 'tr' | 'ur';
  storyId?: string;
}

const { locale = 'de', storyId } = Astro.props;
---

<div class="maze-game-container" data-locale={locale} data-story-id={storyId || ''}>
  <!-- Setup Screen -->
  <div class="maze-setup" id="maze-setup">
    <h2 class="setup-title" data-i18n="mazeGame">Labyrinth-Spiel</h2>
    <p class="setup-description" data-i18n="mazeAdventure">
      Finde den Weg durch das Labyrinth!
    </p>

    <!-- Theme Selector -->
    <div class="theme-selector">
      <h3 data-i18n="selectTheme">Thema wählen</h3>
      <div class="theme-grid">
        <button class="theme-btn active" data-theme="forest">
          <span class="theme-emoji">🌲</span>
          <span class="theme-name" data-i18n="forestSetting">Wald</span>
        </button>
        <button class="theme-btn" data-theme="city">
          <span class="theme-emoji">🏙️</span>
          <span class="theme-name" data-i18n="citySetting">Stadt</span>
        </button>
        <button class="theme-btn" data-theme="beach">
          <span class="theme-emoji">🏖️</span>
          <span class="theme-name" data-i18n="beachSetting">Strand</span>
        </button>
        <button class="theme-btn" data-theme="space">
          <span class="theme-emoji">🚀</span>
          <span class="theme-name" data-i18n="spaceSetting">Weltraum</span>
        </button>
        <button class="theme-btn" data-theme="underwater">
          <span class="theme-emoji">🌊</span>
          <span class="theme-name" data-i18n="underwaterSetting">Unterwasser</span>
        </button>
        <button class="theme-btn" data-theme="mountain">
          <span class="theme-emoji">⛰️</span>
          <span class="theme-name" data-i18n="mountainSetting">Berge</span>
        </button>
        <button class="theme-btn" data-theme="desert">
          <span class="theme-emoji">🏜️</span>
          <span class="theme-name">Wüste</span>
        </button>
        <button class="theme-btn" data-theme="castle">
          <span class="theme-emoji">🏰</span>
          <span class="theme-name" data-i18n="castleSetting">Schloss</span>
        </button>
      </div>
    </div>

    <!-- Difficulty Selector -->
    <div class="difficulty-selector">
      <h3 data-i18n="selectDifficulty">Schwierigkeit wählen</h3>
      <div class="difficulty-buttons">
        <button class="difficulty-btn active" data-difficulty="easy">
          <span class="emoji">🟢</span>
          <div class="difficulty-info">
            <span class="difficulty-name" data-i18n="easy">Einfach</span>
            <span class="difficulty-desc">10x10 • 5 Sammelobjekte</span>
          </div>
        </button>
        <button class="difficulty-btn" data-difficulty="medium">
          <span class="emoji">🟡</span>
          <div class="difficulty-info">
            <span class="difficulty-name" data-i18n="medium">Mittel</span>
            <span class="difficulty-desc">15x15 • 10 Sammelobjekte</span>
          </div>
        </button>
        <button class="difficulty-btn" data-difficulty="hard">
          <span class="emoji">🔴</span>
          <div class="difficulty-info">
            <span class="difficulty-name" data-i18n="hard">Schwer</span>
            <span class="difficulty-desc">20x20 • 15 Sammelobjekte</span>
          </div>
        </button>
      </div>
    </div>

    <!-- Controls Info -->
    <div class="controls-info">
      <h3 data-i18n="controls">Steuerung</h3>
      <div class="control-methods">
        <div class="control-item">
          <span class="control-icon">⌨️</span>
          <span class="control-text" data-i18n="arrowKeys">Pfeiltasten oder WASD</span>
        </div>
        <div class="control-item">
          <span class="control-icon">👆</span>
          <span class="control-text" data-i18n="swipeControl">Wischen auf Touchscreen</span>
        </div>
      </div>
    </div>

    <button class="start-maze-btn" id="start-maze-btn">
      <span data-i18n="startMaze">Labyrinth starten</span>
    </button>
  </div>

  <!-- Game Screen -->
  <div class="maze-game-screen hidden" id="maze-game-screen">
    <!-- Game Header -->
    <div class="game-header">
      <div class="game-stats">
        <div class="stat-item">
          <span class="stat-icon">⏱️</span>
          <span class="stat-label" data-i18n="time">Zeit</span>
          <span class="stat-value" id="maze-time">0:00</span>
        </div>
        <div class="stat-item">
          <span class="stat-icon">👣</span>
          <span class="stat-label" data-i18n="steps">Schritte</span>
          <span class="stat-value" id="maze-steps">0</span>
        </div>
        <div class="stat-item">
          <span class="stat-icon">⭐</span>
          <span class="stat-label" data-i18n="collected">Gesammelt</span>
          <span class="stat-value" id="maze-collected">0 / 0</span>
        </div>
      </div>

      <div class="game-actions">
        <button class="icon-btn" id="hint-btn" title="Hinweis">
          <span>💡</span>
        </button>
        <button class="icon-btn" id="reset-maze-btn" title="Neustart">
          <span>🔄</span>
        </button>
        <button class="icon-btn" id="pause-btn" title="Pause">
          <span>⏸️</span>
        </button>
        <button class="icon-btn" id="back-to-setup-btn" title="Zurück">
          <span>⬅️</span>
        </button>
      </div>
    </div>

    <!-- Canvas Container -->
    <div class="canvas-container">
      <canvas id="maze-canvas" width="800" height="800"></canvas>
      
      <!-- Mini-map (optional) -->
      <div class="minimap-container" id="minimap-container">
        <canvas id="minimap-canvas" width="120" height="120"></canvas>
      </div>
    </div>

    <!-- Mobile Controls -->
    <div class="mobile-controls" id="mobile-controls">
      <div class="dpad-container">
        <button class="dpad-btn" data-direction="up">
          <span>▲</span>
        </button>
        <div class="dpad-middle">
          <button class="dpad-btn" data-direction="left">
            <span>◄</span>
          </button>
          <button class="dpad-btn" data-direction="right">
            <span>►</span>
          </button>
        </div>
        <button class="dpad-btn" data-direction="down">
          <span>▼</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Completion Modal -->
  <div class="completion-modal hidden" id="maze-completion-modal">
    <div class="modal-content">
      <div class="modal-header">
        <h2 data-i18n="mazeComplete">Labyrinth geschafft!</h2>
        <div class="stars-display" id="maze-stars-display">
          <span class="star">⭐</span>
          <span class="star">⭐</span>
          <span class="star">⭐</span>
        </div>
      </div>

      <div class="modal-body">
        <div class="completion-stats">
          <div class="stat-item">
            <span class="stat-label" data-i18n="totalSteps">Schritte</span>
            <span class="stat-value" id="final-steps">0</span>
          </div>
          <div class="stat-item">
            <span class="stat-label" data-i18n="completionTime">Zeit</span>
            <span class="stat-value" id="final-time">0:00</span>
          </div>
          <div class="stat-item">
            <span class="stat-label" data-i18n="collectiblesFound">Sammelobjekte</span>
            <span class="stat-value" id="final-collectibles">0 / 0</span>
          </div>
          <div class="stat-item">
            <span class="stat-label" data-i18n="rewardsEarned">Belohnungen</span>
            <span class="stat-value" id="maze-rewards">50 XP</span>
          </div>
        </div>

        <div class="modal-actions">
          <button class="btn-primary" id="play-again-btn">
            <span data-i18n="playAgain">Nochmal spielen</span>
          </button>
          <button class="btn-secondary" id="back-to-story-btn">
            <span data-i18n="backToStory">Zurück zur Geschichte</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .maze-game-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    font-family: 'Noto Sans', sans-serif;
  }

  /* Setup Screen */
  .maze-setup {
    text-align: center;
  }

  .setup-title {
    font-size: 2.5rem;
    color: #2c3e50;
    margin-bottom: 1rem;
  }

  .setup-description {
    font-size: 1.2rem;
    color: #7f8c8d;
    margin-bottom: 2rem;
  }

  /* Theme Selector */
  .theme-selector,
  .difficulty-selector {
    margin: 2rem 0;
  }

  .theme-selector h3,
  .difficulty-selector h3,
  .controls-info h3 {
    font-size: 1.5rem;
    color: #34495e;
    margin-bottom: 1rem;
  }

  .theme-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 1rem;
    max-width: 800px;
    margin: 0 auto;
  }

  .theme-btn {
    background: white;
    border: 3px solid #ecf0f1;
    border-radius: 12px;
    padding: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .theme-btn:hover {
    transform: translateY(-4px);
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
  }

  .theme-btn.active {
    border-color: #3498db;
    background: #ebf5fb;
    box-shadow: 0 4px 12px rgba(52, 152, 219, 0.3);
  }

  .theme-emoji {
    font-size: 2.5rem;
  }

  .theme-name {
    font-size: 1rem;
    font-weight: 600;
    color: #2c3e50;
  }

  /* Difficulty Buttons */
  .difficulty-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .difficulty-btn {
    background: white;
    border: 3px solid #ecf0f1;
    border-radius: 12px;
    padding: 1rem 1.5rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 200px;
  }

  .difficulty-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.1);
  }

  .difficulty-btn.active {
    border-color: #3498db;
    background: #ebf5fb;
  }

  .difficulty-btn .emoji {
    font-size: 2rem;
  }

  .difficulty-info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .difficulty-name {
    font-size: 1.1rem;
    font-weight: 600;
    color: #2c3e50;
  }

  .difficulty-desc {
    font-size: 0.9rem;
    color: #7f8c8d;
  }

  /* Controls Info */
  .controls-info {
    margin: 2rem 0;
  }

  .control-methods {
    display: flex;
    gap: 2rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .control-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1.5rem;
    background: #f8f9fa;
    border-radius: 8px;
  }

  .control-icon {
    font-size: 1.5rem;
  }

  .control-text {
    font-size: 1rem;
    color: #2c3e50;
  }

  /* Start Button */
  .start-maze-btn {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 12px;
    padding: 1rem 3rem;
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
    margin-top: 2rem;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.4);
  }

  .start-maze-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(102, 126, 234, 0.5);
  }

  /* Game Screen */
  .maze-game-screen {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .game-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .game-stats {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .stat-icon {
    font-size: 1.5rem;
  }

  .stat-label {
    font-size: 0.9rem;
    color: #7f8c8d;
  }

  .stat-value {
    font-size: 1.1rem;
    font-weight: 600;
    color: #2c3e50;
  }

  .game-actions {
    display: flex;
    gap: 0.5rem;
  }

  .icon-btn {
    background: white;
    border: 2px solid #ecf0f1;
    border-radius: 8px;
    padding: 0.5rem;
    cursor: pointer;
    font-size: 1.5rem;
    transition: all 0.2s ease;
  }

  .icon-btn:hover {
    background: #f8f9fa;
    transform: scale(1.1);
  }

  .icon-btn:active {
    transform: scale(0.95);
  }

  /* Canvas Container */
  .canvas-container {
    position: relative;
    background: white;
    border-radius: 12px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
  }

  #maze-canvas {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  /* Minimap */
  .minimap-container {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    background: rgba(255, 255, 255, 0.95);
    border: 2px solid #3498db;
    border-radius: 8px;
    padding: 0.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  #minimap-canvas {
    display: block;
    border-radius: 4px;
  }

  /* Mobile Controls */
  .mobile-controls {
    display: none;
    justify-content: center;
    padding: 1rem;
  }

  .dpad-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .dpad-middle {
    display: flex;
    gap: 2rem;
    align-items: center;
  }

  .dpad-btn {
    width: 60px;
    height: 60px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border: none;
    border-radius: 12px;
    font-size: 1.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
    user-select: none;
  }

  .dpad-btn:active {
    transform: scale(0.95);
    box-shadow: 0 2px 6px rgba(102, 126, 234, 0.3);
  }

  /* Completion Modal */
  .completion-modal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    backdrop-filter: blur(4px);
  }

  .modal-content {
    background: white;
    border-radius: 16px;
    padding: 2rem;
    max-width: 500px;
    width: 90%;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    animation: modalSlideIn 0.3s ease;
  }

  @keyframes modalSlideIn {
    from {
      transform: translateY(-50px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .modal-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .modal-header h2 {
    font-size: 2rem;
    color: #2c3e50;
    margin-bottom: 1rem;
  }

  .stars-display {
    font-size: 2.5rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
  }

  .stars-display .star {
    animation: starPop 0.5s ease;
    animation-fill-mode: both;
  }

  .stars-display .star:nth-child(1) {
    animation-delay: 0.1s;
  }

  .stars-display .star:nth-child(2) {
    animation-delay: 0.3s;
  }

  .stars-display .star:nth-child(3) {
    animation-delay: 0.5s;
  }

  @keyframes starPop {
    0% {
      transform: scale(0) rotate(0deg);
      opacity: 0;
    }
    50% {
      transform: scale(1.3) rotate(180deg);
    }
    100% {
      transform: scale(1) rotate(360deg);
      opacity: 1;
    }
  }

  .completion-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .completion-stats .stat-item {
    flex-direction: column;
    align-items: center;
    padding: 1rem;
    background: #f8f9fa;
    border-radius: 8px;
  }

  .completion-stats .stat-label {
    font-size: 0.9rem;
    color: #7f8c8d;
    margin-bottom: 0.5rem;
  }

  .completion-stats .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: #2c3e50;
  }

  .modal-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  .btn-primary,
  .btn-secondary {
    padding: 0.75rem 2rem;
    border-radius: 8px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    border: none;
  }

  .btn-primary {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
  }

  .btn-secondary {
    background: white;
    color: #2c3e50;
    border: 2px solid #ecf0f1;
  }

  .btn-secondary:hover {
    background: #f8f9fa;
  }

  /* Utility Classes */
  .hidden {
    display: none !important;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .maze-game-container {
      padding: 1rem;
    }

    .setup-title {
      font-size: 2rem;
    }

    .theme-grid {
      grid-template-columns: repeat(auto-fit, minmax(100px, 1fr));
    }

    .difficulty-buttons {
      flex-direction: column;
    }

    .game-stats {
      gap: 1rem;
    }

    .stat-item {
      font-size: 0.9rem;
    }

    .mobile-controls {
      display: flex;
    }

    .minimap-container {
      width: 80px;
      height: 80px;
    }

    #minimap-canvas {
      width: 80px;
      height: 80px;
    }
  }
</style>

<script>
  import {
    MazeGenerator,
    MazeProgressTracker,
    createMazeConfig,
    MAZE_THEMES,
    type MazeCell,
    type MazeTheme,
    type MazeGenerationResult
  } from '../utils/maze-generator';

  // Get base path for correct navigation
  const base = import.meta.env.BASE_URL.replace(/\/$/, '');

  class MazeGameController {
    private canvas: HTMLCanvasElement;
    private ctx: CanvasRenderingContext2D;
    private minimapCanvas: HTMLCanvasElement;
    private minimapCtx: CanvasRenderingContext2D;
    
    private maze: MazeGenerationResult | null = null;
    private currentRow: number = 0;
    private currentCol: number = 0;
    private moves: number = 0;
    private startTime: number = 0;
    private elapsedTime: number = 0;
    private timerInterval: number | null = null;
    private collectedItems: Set<string> = new Set();
    
    private cellSize: number = 40;
    private selectedTheme: MazeTheme = 'forest';
    private selectedDifficulty: 'easy' | 'medium' | 'hard' = 'easy';
    
    private hintCell: { row: number; col: number } | null = null;
    private showingHint: boolean = false;
    
    private touchStartX: number = 0;
    private touchStartY: number = 0;

    constructor() {
      this.canvas = document.getElementById('maze-canvas') as HTMLCanvasElement;
      this.ctx = this.canvas.getContext('2d')!;
      this.minimapCanvas = document.getElementById('minimap-canvas') as HTMLCanvasElement;
      this.minimapCtx = this.minimapCanvas.getContext('2d')!;
      
      this.initializeEventListeners();
    }

    private initializeEventListeners(): void {
      // Setup screen
      document.querySelectorAll('.theme-btn').forEach(btn => {
        btn.addEventListener('click', () => this.selectTheme(btn));
      });

      document.querySelectorAll('.difficulty-btn').forEach(btn => {
        btn.addEventListener('click', () => this.selectDifficulty(btn));
      });

      document.getElementById('start-maze-btn')?.addEventListener('click', () => this.startGame());

      // Game controls
      document.getElementById('hint-btn')?.addEventListener('click', () => this.showHint());
      document.getElementById('reset-maze-btn')?.addEventListener('click', () => this.resetGame());
      document.getElementById('pause-btn')?.addEventListener('click', () => this.togglePause());
      document.getElementById('back-to-setup-btn')?.addEventListener('click', () => this.backToSetup());

      // Keyboard controls
      document.addEventListener('keydown', (e) => this.handleKeyboard(e));

      // Touch controls
      this.canvas.addEventListener('touchstart', (e) => this.handleTouchStart(e), { passive: false });
      this.canvas.addEventListener('touchend', (e) => this.handleTouchEnd(e), { passive: false });

      // Mobile D-pad
      document.querySelectorAll('.dpad-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const direction = btn.getAttribute('data-direction') as 'up' | 'down' | 'left' | 'right';
          this.moveCharacter(direction);
        });
      });

      // Modal actions
      document.getElementById('play-again-btn')?.addEventListener('click', () => this.playAgain());
      document.getElementById('back-to-story-btn')?.addEventListener('click', () => this.backToStory());
    }

    private selectTheme(btn: Element): void {
      document.querySelectorAll('.theme-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      this.selectedTheme = btn.getAttribute('data-theme') as MazeTheme;
    }

    private selectDifficulty(btn: Element): void {
      document.querySelectorAll('.difficulty-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      this.selectedDifficulty = btn.getAttribute('data-difficulty') as 'easy' | 'medium' | 'hard';
    }

    private startGame(): void {
      // Hide setup, show game
      document.getElementById('maze-setup')?.classList.add('hidden');
      document.getElementById('maze-game-screen')?.classList.remove('hidden');

      // Generate maze
      const config = createMazeConfig(this.selectedDifficulty, this.selectedTheme);
      const generator = new MazeGenerator(config);
      this.maze = generator.generate();

      // Initialize game state
      this.currentRow = this.maze.startCell.row;
      this.currentCol = this.maze.startCell.col;
      this.moves = 0;
      this.collectedItems.clear();
      this.elapsedTime = 0;

      // Update UI
      this.updateStats();
      this.adjustCanvasSize();
      this.render();

      // Start timer
      this.startTimer();
    }

    private adjustCanvasSize(): void {
      if (!this.maze) return;

      const maxSize = Math.min(window.innerWidth - 40, 800);
      const gridSize = Math.max(this.maze.config.rows, this.maze.config.cols);
      this.cellSize = Math.floor(maxSize / gridSize);

      this.canvas.width = this.maze.config.cols * this.cellSize;
      this.canvas.height = this.maze.config.rows * this.cellSize;
    }

    private render(): void {
      if (!this.maze) return;

      const theme = MAZE_THEMES[this.selectedTheme];

      // Clear canvas
      this.ctx.fillStyle = theme.backgroundColor;
      this.ctx.fillRect(0, 0, this.canvas.width, this.canvas.height);

      // Draw maze
      this.maze.grid.forEach((row, rowIndex) => {
        row.forEach((cell, colIndex) => {
          const x = colIndex * this.cellSize;
          const y = rowIndex * this.cellSize;

          // Draw cell background
          this.ctx.fillStyle = theme.pathColor;
          this.ctx.fillRect(x, y, this.cellSize, this.cellSize);

          // Draw walls
          this.ctx.strokeStyle = theme.wallColor;
          this.ctx.lineWidth = 3;

          if (cell.walls.top) {
            this.ctx.beginPath();
            this.ctx.moveTo(x, y);
            this.ctx.lineTo(x + this.cellSize, y);
            this.ctx.stroke();
          }
          if (cell.walls.right) {
            this.ctx.beginPath();
            this.ctx.moveTo(x + this.cellSize, y);
            this.ctx.lineTo(x + this.cellSize, y + this.cellSize);
            this.ctx.stroke();
          }
          if (cell.walls.bottom) {
            this.ctx.beginPath();
            this.ctx.moveTo(x, y + this.cellSize);
            this.ctx.lineTo(x + this.cellSize, y + this.cellSize);
            this.ctx.stroke();
          }
          if (cell.walls.left) {
            this.ctx.beginPath();
            this.ctx.moveTo(x, y);
            this.ctx.lineTo(x, y + this.cellSize);
            this.ctx.stroke();
          }

          // Draw collectibles
          if (cell.hasCollectible && !this.collectedItems.has(`${rowIndex},${colIndex}`)) {
            this.ctx.font = `${this.cellSize * 0.5}px Arial`;
            this.ctx.textAlign = 'center';
            this.ctx.textBaseline = 'middle';
            this.ctx.fillText(theme.collectibleEmoji, x + this.cellSize / 2, y + this.cellSize / 2);
          }

          // Draw goal
          if (cell.isEnd) {
            this.ctx.font = `${this.cellSize * 0.6}px Arial`;
            this.ctx.textAlign = 'center';
            this.ctx.textBaseline = 'middle';
            this.ctx.fillText(theme.goalEmoji, x + this.cellSize / 2, y + this.cellSize / 2);
          }
        });
      });

      // Draw hint
      if (this.showingHint && this.hintCell) {
        const x = this.hintCell.col * this.cellSize;
        const y = this.hintCell.row * this.cellSize;
        this.ctx.fillStyle = 'rgba(255, 215, 0, 0.5)';
        this.ctx.fillRect(x, y, this.cellSize, this.cellSize);
      }

      // Draw character
      const charX = this.currentCol * this.cellSize;
      const charY = this.currentRow * this.cellSize;
      this.ctx.font = `${this.cellSize * 0.7}px Arial`;
      this.ctx.textAlign = 'center';
      this.ctx.textBaseline = 'middle';
      this.ctx.fillText(theme.characterEmoji, charX + this.cellSize / 2, charY + this.cellSize / 2);

      // Draw minimap
      this.renderMinimap();
    }

    private renderMinimap(): void {
      if (!this.maze) return;

      const minimapSize = 120;
      const cellSize = minimapSize / Math.max(this.maze.config.rows, this.maze.config.cols);

      this.minimapCtx.clearRect(0, 0, this.minimapCanvas.width, this.minimapCanvas.height);

      // Draw simple maze representation
      this.maze.grid.forEach((row, rowIndex) => {
        row.forEach((cell, colIndex) => {
          const x = colIndex * cellSize;
          const y = rowIndex * cellSize;

          this.minimapCtx.fillStyle = '#ddd';
          this.minimapCtx.fillRect(x, y, cellSize, cellSize);

          // Draw walls (simplified)
          this.minimapCtx.strokeStyle = '#333';
          this.minimapCtx.lineWidth = 1;
          this.minimapCtx.strokeRect(x, y, cellSize, cellSize);
        });
      });

      // Draw character position
      const charX = this.currentCol * cellSize;
      const charY = this.currentRow * cellSize;
      this.minimapCtx.fillStyle = '#3498db';
      this.minimapCtx.fillRect(charX, charY, cellSize, cellSize);

      // Draw goal
      const goalX = this.maze.endCell.col * cellSize;
      const goalY = this.maze.endCell.row * cellSize;
      this.minimapCtx.fillStyle = '#e74c3c';
      this.minimapCtx.fillRect(goalX, goalY, cellSize, cellSize);
    }

    private handleKeyboard(e: KeyboardEvent): void {
      if (!this.maze || document.getElementById('maze-game-screen')?.classList.contains('hidden')) {
        return;
      }

      const keyMap: Record<string, 'up' | 'down' | 'left' | 'right'> = {
        ArrowUp: 'up',
        ArrowDown: 'down',
        ArrowLeft: 'left',
        ArrowRight: 'right',
        w: 'up',
        W: 'up',
        s: 'down',
        S: 'down',
        a: 'left',
        A: 'left',
        d: 'right',
        D: 'right'
      };

      const direction = keyMap[e.key];
      if (direction) {
        e.preventDefault();
        this.moveCharacter(direction);
      }
    }

    private handleTouchStart(e: TouchEvent): void {
      e.preventDefault();
      const touch = e.touches[0];
      this.touchStartX = touch.clientX;
      this.touchStartY = touch.clientY;
    }

    private handleTouchEnd(e: TouchEvent): void {
      e.preventDefault();
      const touch = e.changedTouches[0];
      const deltaX = touch.clientX - this.touchStartX;
      const deltaY = touch.clientY - this.touchStartY;

      const threshold = 30;

      if (Math.abs(deltaX) > Math.abs(deltaY)) {
        // Horizontal swipe
        if (Math.abs(deltaX) > threshold) {
          this.moveCharacter(deltaX > 0 ? 'right' : 'left');
        }
      } else {
        // Vertical swipe
        if (Math.abs(deltaY) > threshold) {
          this.moveCharacter(deltaY > 0 ? 'down' : 'up');
        }
      }
    }

    private moveCharacter(direction: 'up' | 'down' | 'left' | 'right'): void {
      if (!this.maze) return;

      const isValid = MazeGenerator.isValidMove(
        this.maze.grid,
        this.currentRow,
        this.currentCol,
        direction
      );

      if (!isValid) {
        // Play collision sound/animation
        this.canvas.style.animation = 'shake 0.2s';
        setTimeout(() => {
          this.canvas.style.animation = '';
        }, 200);
        return;
      }

      // Move character
      switch (direction) {
        case 'up':
          this.currentRow--;
          break;
        case 'down':
          this.currentRow++;
          break;
        case 'left':
          this.currentCol--;
          break;
        case 'right':
          this.currentCol++;
          break;
      }

      this.moves++;

      // Check for collectibles
      const cell = this.maze.grid[this.currentRow][this.currentCol];
      if (cell.hasCollectible) {
        const key = `${this.currentRow},${this.currentCol}`;
        if (!this.collectedItems.has(key)) {
          this.collectedItems.add(key);
          // Play collect sound
        }
      }

      // Check for goal
      if (cell.isEnd) {
        this.completeGame();
      }

      // Hide hint after movement
      this.showingHint = false;
      this.hintCell = null;

      this.updateStats();
      this.render();
    }

    private showHint(): void {
      if (!this.maze) return;

      this.hintCell = MazeGenerator.getHint(
        this.maze.grid,
        { row: this.currentRow, col: this.currentCol },
        this.maze.endCell
      );

      this.showingHint = true;
      this.render();

      // Hide hint after 2 seconds
      setTimeout(() => {
        this.showingHint = false;
        this.render();
      }, 2000);
    }

    private startTimer(): void {
      this.startTime = Date.now();
      this.timerInterval = window.setInterval(() => {
        this.elapsedTime = Math.floor((Date.now() - this.startTime) / 1000);
        this.updateTimeDisplay();
      }, 1000);
    }

    private stopTimer(): void {
      if (this.timerInterval) {
        clearInterval(this.timerInterval);
        this.timerInterval = null;
      }
    }

    private updateTimeDisplay(): void {
      const minutes = Math.floor(this.elapsedTime / 60);
      const seconds = this.elapsedTime % 60;
      const timeStr = `${minutes}:${seconds.toString().padStart(2, '0')}`;
      const timeEl = document.getElementById('maze-time');
      if (timeEl) timeEl.textContent = timeStr;
    }

    private updateStats(): void {
      const stepsEl = document.getElementById('maze-steps');
      if (stepsEl) stepsEl.textContent = this.moves.toString();

      const collectedEl = document.getElementById('maze-collected');
      if (collectedEl && this.maze) {
        collectedEl.textContent = `${this.collectedItems.size} / ${this.maze.collectibles.length}`;
      }
    }

    private completeGame(): void {
      this.stopTimer();

      if (!this.maze) return;

      // Calculate stars
      const stats = {
        difficulty: this.selectedDifficulty,
        theme: this.selectedTheme,
        time: this.elapsedTime,
        moves: this.moves,
        collectibles: this.collectedItems.size,
        totalCollectibles: this.maze.collectibles.length
      };

      const stars = MazeProgressTracker.calculateStars(stats);

      // Save progress
      const mazeId = `${this.selectedDifficulty}_${this.selectedTheme}`;
      MazeProgressTracker.saveMazeCompletion(mazeId, stats);

      // Show completion modal
      this.showCompletionModal(stars, stats);
    }

    private showCompletionModal(stars: number, stats: any): void {
      const modal = document.getElementById('maze-completion-modal');
      if (!modal) return;

      // Update stars display
      const starsDisplay = document.getElementById('maze-stars-display');
      if (starsDisplay) {
        const starElements = starsDisplay.querySelectorAll('.star');
        starElements.forEach((star, index) => {
          if (index >= stars) {
            (star as HTMLElement).style.opacity = '0.3';
          }
        });
      }

      // Update stats
      const finalSteps = document.getElementById('final-steps');
      if (finalSteps) finalSteps.textContent = this.moves.toString();

      const finalTime = document.getElementById('final-time');
      if (finalTime) {
        const minutes = Math.floor(this.elapsedTime / 60);
        const seconds = this.elapsedTime % 60;
        finalTime.textContent = `${minutes}:${seconds.toString().padStart(2, '0')}`;
      }

      const finalCollectibles = document.getElementById('final-collectibles');
      if (finalCollectibles && this.maze) {
        finalCollectibles.textContent = `${this.collectedItems.size} / ${this.maze.collectibles.length}`;
      }

      const rewards = document.getElementById('maze-rewards');
      if (rewards) {
        const xp = 50 + (stars * 10);
        rewards.textContent = `${xp} XP`;
      }

      modal.classList.remove('hidden');
    }

    private resetGame(): void {
      if (!confirm('Labyrinth neu starten?')) return;
      this.startGame();
    }

    private togglePause(): void {
      // Implement pause functionality
      const pauseBtn = document.getElementById('pause-btn');
      if (this.timerInterval) {
        this.stopTimer();
        if (pauseBtn) pauseBtn.innerHTML = '<span>▶️</span>';
      } else {
        this.startTimer();
        if (pauseBtn) pauseBtn.innerHTML = '<span>⏸️</span>';
      }
    }

    private backToSetup(): void {
      this.stopTimer();
      document.getElementById('maze-game-screen')?.classList.add('hidden');
      document.getElementById('maze-setup')?.classList.remove('hidden');
    }

    private playAgain(): void {
      document.getElementById('maze-completion-modal')?.classList.add('hidden');
      this.startGame();
    }

    private backToStory(): void {
      const storyId = document.querySelector('.maze-game-container')?.getAttribute('data-story-id');
      if (storyId) {
        window.location.href = `${base}/stories/${storyId}`;
      } else {
        window.location.href = `${base}/stories`;
      }
    }
  }

  // Initialize game when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => {
      new MazeGameController();
    });
  } else {
    new MazeGameController();
  }
</script>

<style>
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-4px); }
    20%, 40%, 60%, 80% { transform: translateX(4px); }
  }
</style>
