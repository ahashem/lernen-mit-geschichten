---
/**
 * Daily Challenge Card Component
 * Displays today's challenge with progress and reward
 */
import type { Locale } from '../utils/i18n';

interface Props {
  locale?: Locale;
  compact?: boolean;
}

const { locale = 'de', compact = false } = Astro.props;
---

<div class="daily-challenge-card" data-locale={locale} data-compact={compact}>
  <div class="challenge-header">
    <div class="challenge-icon">⭐</div>
    <div class="challenge-title-wrapper">
      <h3 class="challenge-label" data-i18n="todaysChallenge">Today's Challenge</h3>
      <p class="challenge-title">Loading...</p>
    </div>
    <div class="challenge-timer">
      <span class="timer-icon">⏰</span>
      <span class="time-left">--:--</span>
    </div>
  </div>

  <div class="challenge-body">
    <p class="challenge-description">Loading challenge...</p>

    <div class="challenge-progress">
      <div class="progress-bar-wrapper">
        <div class="progress-bar">
          <div class="progress-fill" data-progress="0"></div>
        </div>
        <div class="progress-text">
          <span class="current">0</span> / <span class="goal">0</span>
        </div>
      </div>
    </div>

    <div class="challenge-reward">
      <span class="reward-label" data-i18n="reward">Reward</span>
      <div class="reward-value">
        <span class="star-icon">⭐</span>
        <span class="reward-amount">0</span>
        <span data-i18n="stars">Stars</span>
      </div>
    </div>
  </div>

  <div class="challenge-footer">
    <div class="challenge-difficulty">
      <span class="difficulty-badge">Medium</span>
    </div>
    <button class="challenge-cta" data-completed="false">
      <span data-i18n="completeToday">Complete Today</span>
    </button>
  </div>

  <div class="challenge-completed" style="display: none;">
    <div class="completion-icon">🎉</div>
    <p class="completion-text" data-i18n="challengeCompleted">Challenge Completed!</p>
    <p class="stars-earned">
      <span data-i18n="starsEarned">Stars Earned</span>:
      <strong class="earned-amount">0</strong> ⭐
    </p>
  </div>
</div>

<style>
  .daily-challenge-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border-radius: 24px;
    padding: 2rem;
    color: white;
    box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);
    position: relative;
    overflow: hidden;
  }

  .daily-challenge-card[data-compact="true"] {
    padding: 1.5rem;
  }

  .daily-challenge-card::before {
    content: '';
    position: absolute;
    top: -50%;
    right: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
    animation: rotate-glow 20s linear infinite;
  }

  @keyframes rotate-glow {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .challenge-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .challenge-icon {
    font-size: 2.5rem;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .challenge-title-wrapper {
    flex: 1;
  }

  .challenge-label {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.9;
    margin: 0 0 0.25rem 0;
  }

  .challenge-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
  }

  .challenge-timer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.2);
    padding: 0.5rem 1rem;
    border-radius: 50px;
    backdrop-filter: blur(10px);
  }

  .timer-icon {
    font-size: 1.25rem;
  }

  .time-left {
    font-weight: 600;
    font-size: 1rem;
  }

  .challenge-body {
    position: relative;
    z-index: 1;
    margin-bottom: 1.5rem;
  }

  .challenge-description {
    font-size: 1rem;
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    opacity: 0.95;
  }

  .challenge-progress {
    margin-bottom: 1.5rem;
  }

  .progress-bar-wrapper {
    position: relative;
  }

  .progress-bar {
    height: 12px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 100px;
    overflow: hidden;
    position: relative;
  }

  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #ffd93d 0%, #ff9f40 100%);
    border-radius: 100px;
    transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    box-shadow: 0 0 10px rgba(255, 217, 61, 0.5);
  }

  .progress-fill::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.3) 50%, transparent 100%);
    animation: shimmer 2s linear infinite;
  }

  @keyframes shimmer {
    0% {
      transform: translateX(-100%);
    }
    100% {
      transform: translateX(100%);
    }
  }

  .progress-text {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
  }

  .challenge-reward {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    backdrop-filter: blur(10px);
  }

  .reward-label {
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.875rem;
    opacity: 0.9;
  }

  .reward-value {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .star-icon {
    font-size: 1.5rem;
    animation: rotate-star 3s linear infinite;
  }

  @keyframes rotate-star {
    0%, 100% {
      transform: rotate(-10deg);
    }
    50% {
      transform: rotate(10deg);
    }
  }

  .challenge-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }

  .difficulty-badge {
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: capitalize;
  }

  .difficulty-badge[data-difficulty="easy"] {
    background: rgba(76, 175, 80, 0.3);
  }

  .difficulty-badge[data-difficulty="medium"] {
    background: rgba(255, 159, 64, 0.3);
  }

  .difficulty-badge[data-difficulty="hard"] {
    background: rgba(244, 67, 54, 0.3);
  }

  .challenge-cta {
    flex: 1;
    padding: 1rem 2rem;
    background: rgba(255, 255, 255, 0.25);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    color: white;
    font-weight: 700;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
  }

  .challenge-cta:hover {
    background: rgba(255, 255, 255, 0.35);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(255, 255, 255, 0.3);
  }

  .challenge-cta[data-completed="true"] {
    background: rgba(76, 175, 80, 0.3);
    border-color: rgba(76, 175, 80, 0.5);
    cursor: default;
  }

  .challenge-completed {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    z-index: 2;
    border-radius: 24px;
    padding: 2rem;
  }

  .completion-icon {
    font-size: 4rem;
    animation: celebrate 0.6s ease-in-out;
  }

  @keyframes celebrate {
    0% {
      transform: scale(0) rotate(-180deg);
    }
    70% {
      transform: scale(1.2) rotate(10deg);
    }
    100% {
      transform: scale(1) rotate(0deg);
    }
  }

  .completion-text {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
  }

  .stars-earned {
    font-size: 1.125rem;
    margin: 0;
  }

  .earned-amount {
    font-size: 1.5rem;
    color: #ffd93d;
  }

  @media (max-width: 640px) {
    .daily-challenge-card {
      padding: 1.5rem;
    }

    .challenge-icon {
      font-size: 2rem;
    }

    .challenge-title {
      font-size: 1.125rem;
    }

    .challenge-timer {
      padding: 0.375rem 0.75rem;
    }

    .time-left {
      font-size: 0.875rem;
    }

    .challenge-footer {
      flex-direction: column;
    }

    .challenge-cta {
      width: 100%;
    }
  }
</style>

<script>
  import { dailyChallengeManager } from '../utils/daily-challenges';
  import type { DailyChallenge } from '../utils/daily-challenges';

  function updateChallengeCard() {
    const card = document.querySelector('.daily-challenge-card');
    if (!card) return;

    const challenge = dailyChallengeManager.getTodayChallenge();
    const locale = card.getAttribute('data-locale') as 'de' | 'ar' | 'en' | 'tr' | 'ur' || 'de';

    // Update title
    const titleEl = card.querySelector('.challenge-title');
    if (titleEl) {
      titleEl.textContent = challenge.title[locale];
    }

    // Update description
    const descEl = card.querySelector('.challenge-description');
    if (descEl) {
      descEl.textContent = challenge.description[locale];
    }

    // Update progress
    const progressFill = card.querySelector('.progress-fill') as HTMLElement;
    const currentEl = card.querySelector('.progress-text .current');
    const goalEl = card.querySelector('.progress-text .goal');

    if (progressFill && currentEl && goalEl) {
      const percentage = (challenge.current / challenge.goal) * 100;
      progressFill.style.width = `${percentage}%`;
      progressFill.dataset.progress = percentage.toString();
      currentEl.textContent = challenge.current.toString();
      goalEl.textContent = challenge.goal.toString();
    }

    // Update reward
    const rewardAmount = card.querySelector('.reward-amount');
    if (rewardAmount) {
      rewardAmount.textContent = challenge.reward.toString();
    }

    // Update difficulty
    const difficultyBadge = card.querySelector('.difficulty-badge') as HTMLElement;
    if (difficultyBadge) {
      difficultyBadge.textContent = challenge.difficulty.charAt(0).toUpperCase() + challenge.difficulty.slice(1);
      difficultyBadge.dataset.difficulty = challenge.difficulty;
    }

    // Update timer
    updateTimer();

    // Show completion if done
    if (challenge.completed) {
      const completedEl = card.querySelector('.challenge-completed') as HTMLElement;
      const earnedAmount = card.querySelector('.earned-amount');

      if (completedEl && earnedAmount) {
        completedEl.style.display = 'flex';
        earnedAmount.textContent = challenge.reward.toString();
      }
    }
  }

  function updateTimer() {
    const timerEl = document.querySelector('.time-left');
    if (!timerEl) return;

    const now = new Date();
    const midnight = new Date();
    midnight.setHours(24, 0, 0, 0);

    const diff = midnight.getTime() - now.getTime();
    const hours = Math.floor(diff / (1000 * 60 * 60));
    const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));

    timerEl.textContent = `${hours}h ${minutes}m`;
  }

  // Initialize
  if (typeof window !== 'undefined') {
    updateChallengeCard();

    // Update timer every minute
    setInterval(updateTimer, 60000);

    // Listen for progress updates
    window.addEventListener('challenge-progress', updateChallengeCard);
  }
</script>
