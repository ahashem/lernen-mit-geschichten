---
import type { Locale } from '../utils/i18n';
import { getTranslation } from '../utils/i18n';
import { skillsCategories } from '../utils/skills-taxonomy';

interface Props {
  locale: Locale;
  currentSkills?: string[];
  currentAvailableIn?: string[];
}

const { locale, currentSkills = [], currentAvailableIn = [] } = Astro.props;

// The page already renders one locale, so offering it here would tick a box
// that changes nothing. Only the other four are a real question.
const otherLocales = [
  { code: 'de', name: 'Deutsch', flag: '🇩🇪' },
  { code: 'ar', name: 'العربية', flag: '🇸🇦' },
  { code: 'en', name: 'English', flag: '🇬🇧' },
  { code: 'tr', name: 'Türkçe', flag: '🇹🇷' },
  { code: 'ur', name: 'اردو', flag: '🇵🇰' },
].filter(lang => lang.code !== locale);
---

<aside class="filter-sidebar" data-locale={locale}>
  <h3>{getTranslation(locale, 'filterBySkill')}</h3>

  <div class="filter-section">
    {
      Object.entries(skillsCategories).map(([categoryId, category]) => (
        <details class="category-group" open>
          <summary>{category[locale]}</summary>
          <div class="skills-checkboxes">
            {category.skills.map(skill => (
              <label class="skill-checkbox">
                <input
                  type="checkbox"
                  name="skill"
                  value={skill.id}
                  checked={currentSkills.includes(skill.id)}
                />
                <span>{skill[locale]}</span>
              </label>
            ))}
          </div>
        </details>
      ))
    }
  </div>

  <h3>{getTranslation(locale, 'alsoAvailableIn')}</h3>

  <div class="filter-section">
    <div class="language-checkboxes">
      {
        otherLocales.map(lang => (
          <label class="language-checkbox">
            <input
              type="checkbox"
              name="available-in"
              value={lang.code}
              checked={currentAvailableIn.includes(lang.code)}
            />
            <span class="flag">{lang.flag}</span>
            <span>{lang.name}</span>
          </label>
        ))
      }
    </div>
  </div>

  <button type="button" class="clear-filters"
    >{locale === 'de' ? 'Filter zurücksetzen' : 'Clear filters'}</button
  >
</aside>

<script>
  document.querySelectorAll('.filter-sidebar').forEach(sidebar => {
    const checkboxes = sidebar.querySelectorAll('input[type="checkbox"]');
    const clearBtn = sidebar.querySelector('.clear-filters');

    const updateFilters = () => {
      const selectedSkills = Array.from(
        sidebar.querySelectorAll('input[name="skill"]:checked')
      ).map(cb => (cb as HTMLInputElement).value);

      const selectedAvailableIn = Array.from(
        sidebar.querySelectorAll('input[name="available-in"]:checked')
      ).map(cb => (cb as HTMLInputElement).value);

      // Store in localStorage
      localStorage.setItem('filters-skills', JSON.stringify(selectedSkills));
      localStorage.setItem('filters-available-in', JSON.stringify(selectedAvailableIn));

      // Update URL params
      const url = new URL(window.location.href);
      if (selectedSkills.length > 0) {
        url.searchParams.set('skills', selectedSkills.join(','));
      } else {
        url.searchParams.delete('skills');
      }
      if (selectedAvailableIn.length > 0) {
        url.searchParams.set('available-in', selectedAvailableIn.join(','));
      } else {
        url.searchParams.delete('available-in');
      }
      window.history.replaceState({}, '', url);

      // Dispatch custom event
      window.dispatchEvent(
        new CustomEvent('filtersChanged', {
          detail: { skills: selectedSkills, availableIn: selectedAvailableIn },
        })
      );
    };

    checkboxes.forEach(cb => {
      cb.addEventListener('change', updateFilters);
    });

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        checkboxes.forEach(cb => {
          (cb as HTMLInputElement).checked = false;
        });
        localStorage.removeItem('filters-skills');
        localStorage.removeItem('filters-available-in');

        // Clear URL params
        const url = new URL(window.location.href);
        url.searchParams.delete('skills');
        url.searchParams.delete('available-in');
        window.history.replaceState({}, '', url);

        window.dispatchEvent(
          new CustomEvent('filtersChanged', {
            detail: { skills: [], availableIn: [] },
          })
        );
      });
    }

    // The old facet filtered a story's own locale, so a stored `["de"]` hid
    // every card on a non-German homepage. Those keys and params carry no
    // meaning under the availability semantics — discard them rather than
    // migrate them, so returning visitors and old links land on a clean state.
    localStorage.removeItem('filters-languages');
    localStorage.removeItem('filters-locale');

    // Get URL params (client-side only, since we're using SSG)
    const urlParams = new URLSearchParams(window.location.search);
    const urlSkills = urlParams.get('skills')?.split(',').filter(Boolean) || [];
    const urlAvailableIn = urlParams.get('available-in')?.split(',').filter(Boolean) || [];

    if (urlParams.has('languages')) {
      const url = new URL(window.location.href);
      url.searchParams.delete('languages');
      window.history.replaceState({}, '', url);
    }

    // Priority: URL params, then localStorage
    const restore = (name: string, fromUrl: string[], storageKey: string) => {
      const saved = fromUrl.length > 0 ? null : localStorage.getItem(storageKey);
      const values: string[] = saved ? JSON.parse(saved) : fromUrl;

      values.forEach((value: string) => {
        const cb = sidebar.querySelector(
          `input[name="${name}"][value="${value}"]`
        ) as HTMLInputElement;
        if (cb) cb.checked = true;
      });

      if (fromUrl.length > 0) {
        localStorage.setItem(storageKey, JSON.stringify(fromUrl));
      }
    };

    restore('skill', urlSkills, 'filters-skills');
    restore('available-in', urlAvailableIn, 'filters-available-in');
  });
</script>

<style>
  .filter-sidebar {
    background: white;
    padding: 1.5rem;
    border-radius: var(--border-radius);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    position: sticky;
    top: 100px;
  }

  .filter-sidebar h3 {
    font-size: 1.1rem;
    color: var(--color-text);
    margin-bottom: 1rem;
    margin-top: 1.5rem;
  }

  .filter-sidebar h3:first-child {
    margin-top: 0;
  }

  .filter-section {
    margin-bottom: 1.5rem;
  }

  .category-group {
    margin-bottom: 1rem;
  }

  .category-group summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-primary);
    padding: 0.5rem;
    border-radius: 6px;
    transition: background 0.2s;
  }

  .category-group summary:hover {
    background: var(--color-background);
  }

  .skills-checkboxes,
  .language-checkboxes {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.75rem 0 0.75rem 1rem;
  }

  .skill-checkbox,
  .language-checkbox {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 4px;
    transition: background 0.2s;
    /* WCAG 2.1 AA target size; the label is the whole hit area. */
    min-height: 44px;
  }

  .skill-checkbox:hover,
  .language-checkbox:hover {
    background: var(--color-background);
  }

  .skill-checkbox input,
  .language-checkbox input {
    cursor: pointer;
  }

  .language-checkbox .flag {
    font-size: 1.2rem;
  }

  .clear-filters {
    width: 100%;
    padding: 0.75rem;
    background: var(--color-text-light);
    color: white;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    font-weight: 600;
    transition: background 0.2s;
  }

  .clear-filters:hover {
    background: var(--color-text);
  }

  @media (max-width: 768px) {
    .filter-sidebar {
      position: static;
      margin-bottom: 2rem;
    }
  }
</style>
