---
import type { EasterEgg as EasterEggType } from '../utils/story-interactions';

interface Props {
  egg: EasterEggType;
  storyId: string;
  icon?: string;
}

const { egg, storyId, icon = '⭐' } = Astro.props;

const positionStyle = `left: ${egg.position.x}; top: ${egg.position.y};`;
---

<div
  class="easter-egg"
  data-egg-id={egg.id}
  data-story-id={storyId}
  data-reward={egg.reward}
  style={positionStyle}
  role="button"
  tabindex="0"
  aria-label="Hidden surprise"
>
  <span class="egg-icon">{icon}</span>
  <span class="egg-glow"></span>
</div>

<script>
  import { soundEffects } from '../utils/sound-effects';
  import { EasterEggManager, collectiblesManager } from '../utils/story-interactions';
  import { createConfetti, triggerHaptic } from '../animations/story-animations';
  import type { Collectible } from '../utils/story-interactions';

  document.querySelectorAll('.easter-egg').forEach(eggDiv => {
    const eggId = eggDiv.getAttribute('data-egg-id') || '';
    const storyId = eggDiv.getAttribute('data-story-id') || '';
    const reward = (eggDiv.getAttribute('data-reward') || 'star') as Collectible['type'];

    const manager = new EasterEggManager(storyId);

    // Check if already discovered
    const storageKey = `story-easter-eggs-${storyId}`;
    const saved = localStorage.getItem(storageKey);
    const discovered = saved ? JSON.parse(saved).includes(eggId) : false;

    if (discovered) {
      eggDiv.classList.add('discovered');
      eggDiv.classList.remove('hidden');
    } else {
      eggDiv.classList.add('hidden');
    }

    const handleDiscovery = async () => {
      if (eggDiv.classList.contains('discovered')) {
        // Already discovered, just animate
        eggDiv.classList.add('bounce-animation');
        soundEffects.playPop();
        setTimeout(() => {
          eggDiv.classList.remove('bounce-animation');
        }, 600);
        return;
      }

      // Mark as discovered
      eggDiv.classList.remove('hidden');
      eggDiv.classList.add('discovered');

      // Haptic feedback
      triggerHaptic('medium');

      // Play discovery sound
      soundEffects.playDiscovery();

      // Confetti explosion
      createConfetti(eggDiv as HTMLElement, 40);

      // Save to localStorage
      const saved = localStorage.getItem(storageKey) || '[]';
      const eggs = JSON.parse(saved);
      if (!eggs.includes(eggId)) {
        eggs.push(eggId);
        localStorage.setItem(storageKey, JSON.stringify(eggs));
      }

      // Award collectible
      const collectible: Collectible = {
        id: `egg-${eggId}-${Date.now()}`,
        type: reward,
        name: `Easter egg: ${eggId}`,
        storyId,
        timestamp: Date.now(),
      };

      collectiblesManager.add(collectible);

      // Show discovery notification
      showDiscoveryNotification(eggId);

      // Check if all eggs found
      checkAllEggsFound(storyId);
    };

    // Click handler
    eggDiv.addEventListener('click', handleDiscovery);

    // Keyboard handler
    eggDiv.addEventListener('keydown', e => {
      if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
        e.preventDefault();
        handleDiscovery();
      }
    });

    // Hover effect
    eggDiv.addEventListener('mouseenter', () => {
      if (!eggDiv.classList.contains('discovered')) {
        soundEffects.play('magic-sparkle');
      }
    });
  });

  function showDiscoveryNotification(eggId: string) {
    const notification = document.createElement('div');
    notification.className = 'easter-egg-notification';
    notification.innerHTML = `
      <div class="notification-content">
        <span class="notification-icon">🎉</span>
        <div class="notification-text">
          <strong>Easter Egg Found!</strong>
          <p>You discovered a hidden surprise!</p>
        </div>
      </div>
    `;

    document.body.appendChild(notification);

    setTimeout(() => {
      notification.classList.add('show');
    }, 10);

    setTimeout(() => {
      notification.classList.remove('show');
      setTimeout(() => {
        notification.remove();
      }, 500);
    }, 3000);
  }

  function checkAllEggsFound(storyId: string) {
    const allEggs = document.querySelectorAll(`.easter-egg[data-story-id="${storyId}"]`);
    const discoveredEggs = document.querySelectorAll(
      `.easter-egg[data-story-id="${storyId}"].discovered`
    );

    if (allEggs.length > 0 && allEggs.length === discoveredEggs.length) {
      // All eggs found!
      showCompletionNotification();
    }
  }

  function showCompletionNotification() {
    const notification = document.createElement('div');
    notification.className = 'easter-egg-completion';
    notification.innerHTML = `
      <div class="completion-content">
        <span class="completion-icon">🏆</span>
        <div class="completion-text">
          <strong>All Easter Eggs Found!</strong>
          <p>You're an amazing explorer!</p>
        </div>
      </div>
    `;

    document.body.appendChild(notification);

    soundEffects.playCompletion();
    createConfetti(notification as HTMLElement, 60);

    setTimeout(() => {
      notification.classList.add('show');
    }, 10);

    setTimeout(() => {
      notification.classList.remove('show');
      setTimeout(() => {
        notification.remove();
      }, 500);
    }, 4000);
  }
</script>

<style>
  .easter-egg {
    position: absolute;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    z-index: 10;
    transform: translateX(-50%) translateY(-50%);
  }

  .easter-egg.hidden {
    opacity: 0.05;
  }

  .easter-egg.hidden:hover {
    opacity: 0.2;
    transform: translateX(-50%) translateY(-50%) scale(1.1);
  }

  .easter-egg.discovered {
    opacity: 1;
    animation: pulse-glow 2s ease-in-out infinite;
  }

  .easter-egg:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 4px;
    border-radius: 50%;
  }

  .egg-icon {
    font-size: 2.5rem;
    position: relative;
    z-index: 2;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
  }

  .egg-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 215, 0, 0.4) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .easter-egg.discovered .egg-glow,
  .easter-egg:hover .egg-glow {
    opacity: 1;
  }

  .easter-egg.bounce-animation {
    animation: big-bounce 0.6s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }

  @keyframes pulse-glow {
    0%,
    100% {
      filter: drop-shadow(0 0 5px rgba(255, 215, 0, 0.5));
    }
    50% {
      filter: drop-shadow(0 0 20px rgba(255, 215, 0, 0.9));
    }
  }

  @keyframes big-bounce {
    0%,
    100% {
      transform: translateX(-50%) translateY(-50%) scale(1);
    }
    50% {
      transform: translateX(-50%) translateY(-70%) scale(1.3);
    }
  }

  /* Discovery Notification */
  .easter-egg-notification,
  .easter-egg-completion {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.8);
    background: white;
    border-radius: 24px;
    padding: 2rem 2.5rem;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.3);
    z-index: 10000;
    opacity: 0;
    transition: all 0.5s cubic-bezier(0.68, -0.55, 0.265, 1.55);
  }

  .easter-egg-notification.show,
  .easter-egg-completion.show {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }

  .notification-content,
  .completion-content {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .notification-icon,
  .completion-icon {
    font-size: 4rem;
    animation: spin-tada 1s ease;
  }

  @keyframes spin-tada {
    0% {
      transform: scale(0) rotate(0deg);
    }
    50% {
      transform: scale(1.2) rotate(180deg);
    }
    100% {
      transform: scale(1) rotate(360deg);
    }
  }

  .notification-text,
  .completion-text {
    text-align: left;
  }

  .notification-text strong,
  .completion-text strong {
    display: block;
    font-size: 1.5rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
  }

  .notification-text p,
  .completion-text p {
    margin: 0;
    font-size: 1.1rem;
    color: var(--color-text);
  }

  .easter-egg-completion {
    background: linear-gradient(135deg, #ffd93d 0%, #ff9f40 100%);
  }

  .easter-egg-completion .completion-text strong {
    color: white;
  }

  .easter-egg-completion .completion-text p {
    color: rgba(255, 255, 255, 0.95);
  }

  @media (max-width: 768px) {
    .easter-egg {
      width: 40px;
      height: 40px;
    }

    .egg-icon {
      font-size: 2rem;
    }

    .egg-glow {
      width: 50px;
      height: 50px;
    }

    .easter-egg-notification,
    .easter-egg-completion {
      padding: 1.5rem 2rem;
      max-width: 90vw;
    }

    .notification-icon,
    .completion-icon {
      font-size: 3rem;
    }

    .notification-content,
    .completion-content {
      flex-direction: column;
      gap: 1rem;
    }

    .notification-text,
    .completion-text {
      text-align: center;
    }

    .notification-text strong,
    .completion-text strong {
      font-size: 1.2rem;
    }

    .notification-text p,
    .completion-text p {
      font-size: 1rem;
    }
  }
</style>
