const t = labels[locale] || labels.de;

const characterEmojis: Record<string, string> = {
  bear: '🐻',
  fox: '🦊',
  rabbit: '🐰',
  owl: '🦉',
  elephant: '🐘',
  lion: '🦁',
  squirrel: '🐿️',
  hedgehog: '🦔',
  flamingo: '🦩',
  dinosaur: '🦕',
