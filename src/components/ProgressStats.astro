    days: 'Tage',
    minutes: 'Minuten',
  },
  ar: {
    storiesRead: 'القصص المقروءة',
    quizzesCompleted: 'الاختبارات المكتملة',
    favoriteCharacter: 'الشخصية المفضلة',
    readingStreak: 'سلسلة القراءة',
    skillsMastered: 'المهارات المكتسبة',
    languagesExplored: 'اللغات المستكشفة',
    totalReadingTime: 'إجمالي وقت القراءة',
    completionRate: 'معدل النجاح',
    days: 'أيام',
    minutes: 'دقائق',
  },
  en: {
    storiesRead: 'Stories Read',
    quizzesCompleted: 'Quizzes Completed',
    favoriteCharacter: 'Favorite Character',
    readingStreak: 'Reading Streak',
    skillsMastered: 'Skills Mastered',
    languagesExplored: 'Languages Explored',
    totalReadingTime: 'Total Reading Time',
    completionRate: 'Success Rate',
    days: 'Days',
    minutes: 'Minutes',
  },
  tr: {
    storiesRead: 'Okunan Hikayeler',
    quizzesCompleted: 'Tamamlanan Testler',
    favoriteCharacter: 'Favori Karakter',
    readingStreak: 'Okuma Serisi',
    skillsMastered: 'Kazanılan Beceriler',
    languagesExplored: 'Keşfedilen Diller',
    totalReadingTime: 'Toplam Okuma Süresi',
    completionRate: 'Başarı Oranı',
    days: 'Gün',
    minutes: 'Dakika',
  },
  ur: {
    storiesRead: 'پڑھی گئی کہانیاں',
    quizzesCompleted: 'مکمل کوئز',
    favoriteCharacter: 'پسندیدہ کردار',
    readingStreak: 'پڑھنے کا سلسلہ',
    skillsMastered: 'سیکھی گئی مہارتیں',
    languagesExplored: 'دریافت شدہ زبانیں',
    totalReadingTime: 'کل پڑھنے کا وقت',
    completionRate: 'کامیابی کی شرح',
    days: 'دن',
    minutes: 'منٹ',
  },
