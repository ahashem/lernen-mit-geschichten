---
import { render } from 'astro:content';
import qrcode from 'qrcode-generator';
import BaseLayout from '@layouts/BaseLayout.astro';
import Logo from '@components/Logo.astro';
import { getCatalogue, SHELF_KEY } from '@utils/catalogue';
import { getSkillsByCategory } from '@utils/skills-taxonomy';
import { endonyms, fmt, getTranslation, isRTL, type Locale } from '@utils/i18n';
import { coverOf } from '@utils/story-art';
import { talkPrompts } from '@utils/story-pages';
import { FEEDBACK_EMAIL, localePrefix, storyNumber } from '@utils/site';
import { LOCALES } from '@utils/story-availability';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key);
const prefix = localePrefix(locale);
// SITE_URL is required for every build, so the origin is always known.
const origin = Astro.site!.origin;

const catalogue = (await getCatalogue(locale)).sort((a, b) => a.storyId.localeCompare(b.storyId));
const stories = await Promise.all(
  catalogue.map(async item => {
    const { Content } = await render(item.entry);
    const url = `${origin}${prefix}/stories/${item.slug}`;
    const qr = qrcode(0, 'M');
    qr.addData(url);
    qr.make();
    return {
      item,
      Content,
      no: storyNumber(item.storyId),
      url,
      // Printed under the QR code for a grown-up at a computer, who cannot scan their own paper.
      shortUrl: url.replace(/^https?:\/\//, ''),
      cover: coverOf(item.meta, locale),
      code: qr.createSvgTag({ cellSize: 4, margin: 0, scalable: true }),
      prompts: talkPrompts(item.entry.data, 4),
      summary: item.entry.data.summary,
      keyMessage: item.entry.data.keyMessage,
    };
  })
);

// Every printed page carries the site name at its foot and the page number on the outer side, and on a story's pages a running head with its number and title, so a loose sheet in a
// binder can always be put back. The AI-illustration note, the licence and the rest are said once, on the last page. Each story is its own named page; margin boxes do not inherit the page's font, so
// each names the reading face, which also shapes Arabic and Urdu properly. Right-to-left pages mirror the sides.
const cssText = (text: string) => text.replace(/[\\"]/g, '').replace(/\s+/g, ' ');
const [start, end] = isRTL(locale) ? ['right', 'left'] : ['left', 'right'];
const box = `font-family: var(--font-read); color: #444;`;
const foot =
  `@bottom-${start} { content: "${cssText(t('siteName'))}"; ${box} font-size: 8pt; width: 84%; text-align: ${start}; } ` +
  `@bottom-${end} { content: counter(page); ${box} font-size: 9pt; width: 12%; text-align: ${end}; }`;
const pageBox = `size: A4; margin: 15mm 12mm 18mm;`;
const pageRules = [
  `@page folio { ${pageBox} ${foot} }`,
  ...stories.map(
    ({ no, item }) =>
      `@page s${no} { ${pageBox} ${foot} @top-${start} { content: "${cssText(`${no} · ${item.title}`)}"; ${box} font-size: 8pt; width: 100%; text-align: ${start}; } }`
  ),
  `@media print { ${stories.map(({ no }) => `[data-folio] .sheets:not([data-notext]) #s-${no} { page: s${no}; }`).join(' ')} ` +
    // Without the text, stories share pages, so they cannot each be their own named page.
    `[data-folio] .sheets[data-notext] .story-sheet { page: folio; } }`,
].join('\n');
const asOf = fmt(t('folioAsOf'), {
  date: new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(new Date()),
});

const allGroups = await getSkillsByCategory(locale);
const groups = allGroups.map(group => ({
  ...group,
  skills: group.skills
    .map(skill => ({ ...skill, stories: catalogue.filter(i => i.skills.includes(skill.id)) }))
    .filter(skill => skill.stories.length > 0),
}));
const labelOf = (id: string) => groups.flatMap(g => g.skills).find(s => s.id === id)?.label ?? id;
const shelf = (band: number) => t(SHELF_KEY[band as 1 | 2 | 3 | 4]);

// What the chooser needs to read the Library's filters: the same fields the Library filters on, in list order.
const data = {
  stories: catalogue.map(i => ({
    no: storyNumber(i.storyId),
    title: i.title,
    text: `${i.summary} ${i.skills.map(labelOf).join(' ')}`,
    skills: i.skills,
    languages: i.languages,
    band: i.band,
    minutes: i.minutes,
  })),
  areaOf: Object.fromEntries(allGroups.flatMap(g => g.skills.map(s => [s.id, g.id]))),
  strings: {
    chosen: t('folioChosen'),
    pagesOne: t('folioPagesOne'),
    pagesMany: t('folioPagesMany'),
  },
};
const others = LOCALES.filter(l => l !== locale);
const website = `${origin}${prefix}/`;
---

<BaseLayout title={t('folioTitle')} locale={locale} noindex>
  <style is:inline set:html={pageRules}></style>
  <div class="container folio" data-folio>
    <section class="controls">
      <h1>{t('folioTitle')}</h1>
      <p class="lead">{t('folioLead')}</p>
      {
        stories.length === 0 ? (
          <p>{t('folioNoStories')}</p>
        ) : (
          <>
            <div class="tools">
              <button class="btn" type="button" data-all data-js-only>
                {t('folioAll')}
              </button>
              <button class="btn" type="button" data-none data-js-only>
                {t('folioNone')}
              </button>
              <a class="change" href={`${prefix}/library`} data-library>
                {t('folioChangeInLibrary')}
              </a>
            </div>
            <label class="with-text">
              <input type="checkbox" checked data-with-text />
              <span>
                <strong>{t('folioWithText')}</strong>
                <span class="hint">{t('folioWithTextHint')}</span>
              </span>
            </label>
            <fieldset>
              <legend class="visually-hidden">{t('folioSelect')}</legend>
              <ul class="picks">
                {catalogue.map(item => (
                  <li>
                    <label>
                      <input type="checkbox" checked data-pick={item.slug} />
                      <span class="no">{storyNumber(item.storyId)}</span>
                      <span class="name">{item.title}</span>
                    </label>
                    <span class="mins">
                      {item.minutes} {t('minutes')}
                    </span>
                    <a class="open" href={`${prefix}/stories/${item.slug}`}>
                      {t('folioOpen')}
                      <span class="visually-hidden">: {item.title}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </fieldset>
            <p class="others" data-others hidden>
              <span>{t('folioOtherLanguages')}</span>
              {others.map(l => (
                <a
                  data-other={l}
                  href={`${localePrefix(l)}/folio`}
                  data-folio-href={`${localePrefix(l)}/folio`}
                  hreflang={l}
                >
                  <bdi lang={l}>{endonyms[l]}</bdi> <span data-other-count />
                </a>
              ))}
            </p>
            <div class="print-bar" data-js-only>
              <p class="summary" data-summary aria-live="polite" />
              <button class="btn btn--primary" type="button" data-print>
                {t('folioPrint')}
              </button>
            </div>
          </>
        )
      }
    </section>

    {
      stories.length > 0 && (
        <div class="sheets" lang={locale}>
          <section class="sheet title-sheet" data-front>
            <div class="brand">
              <Logo size={52} />
              <span class="wordmark">{t('siteName')}</span>
            </div>
            <div class="cover-art" aria-hidden="true">
              <svg class="hills" viewBox="0 0 200 60" preserveAspectRatio="none">
                <path
                  class="hill-back"
                  d="M0 34 C40 14 80 16 120 30 C150 40 175 28 200 22 V60 H0 Z"
                />
                <path
                  class="hill-front"
                  d="M0 46 C50 30 95 34 140 44 C165 50 185 44 200 40 V60 H0 Z"
                />
              </svg>
              <Logo size={260} />
            </div>
            <h2 class="title">{t('folioTitle')}</h2>
            <p class="cover-lang" lang={locale}>
              {endonyms[locale]}
            </p>
            <p class="tagline">{t('tagline')}</p>
            <div class="cover-foot">
              <div class="newest">
                <div class="qr-code" data-newest-code aria-hidden="true" />
                <p>
                  {t('folioNewest')}
                  <br />
                  <a class="url" data-newest-link href={`${origin}${prefix}/folio`}>
                    {`${origin}${prefix}/folio`.replace(/^https?:\/\//, '')}
                  </a>
                </p>
              </div>
              <p class="as-of">{asOf}</p>
            </div>
          </section>

          <section class="sheet index-sheet" id="contents" data-front>
            <h2>{t('folioContents')}</h2>
            <p class="numbers-note">{t('folioNumbersNote')}</p>
            <ol class="overview">
              {catalogue.map(item => (
                <li data-story={item.slug}>
                  <a class="no" href={`#s-${storyNumber(item.storyId)}`}>
                    {storyNumber(item.storyId)}
                  </a>
                  <a class="name" href={`#s-${storyNumber(item.storyId)}`}>
                    {item.title}
                  </a>
                  <span class="meta">
                    {shelf(item.band)} · {item.minutes} {t('minutes')}
                  </span>
                </li>
              ))}
            </ol>
            <h2 class="skills-title">{t('skills')}</h2>
            <div class="skill-groups">
              {groups
                .filter(g => g.skills.length > 0)
                .map(group => (
                  <div class="group" data-group>
                    <h3>{group.label}</h3>
                    <ul>
                      {group.skills.map(skill => (
                        <li data-skill>
                          <span class="skill">{skill.label}</span>
                          <span class="where">
                            {skill.stories.map(s => (
                              <a data-story={s.slug} href={`#s-${storyNumber(s.storyId)}`}>
                                {storyNumber(s.storyId)}
                              </a>
                            ))}
                          </span>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
            </div>
          </section>

          {stories.map(
            ({ item, Content, no, url, shortUrl, cover, code, prompts, summary, keyMessage }) => (
              <article class="sheet story-sheet" id={`s-${no}`} data-story={item.slug}>
                <div class="story-head">
                  {cover && (
                    <img class="cover" src={cover.src} alt="" loading="lazy" decoding="async" />
                  )}
                  <div class="head-text">
                    <a class="to-contents" href="#contents" data-to-contents>
                      ↑ {t('folioContents')}
                    </a>
                    <h2 class="story-title">
                      <span class="no">{no}</span>
                      {item.title}
                    </h2>
                    <div class="notes">
                      <p class="meta">
                        {shelf(item.band)} · {item.minutes} {t('minutes')}
                        {item.skills.length > 0 && <> · {item.skills.map(labelOf).join(' · ')}</>}
                      </p>
                      {summary && <p class="summary-text">{summary}</p>}
                    </div>
                  </div>
                  <div class="qr">
                    <div class="qr-code" set:html={code} aria-hidden="true" />
                    <p>{t('folioScan')}</p>
                    <a class="url" href={url} dir="ltr">
                      {shortUrl}
                    </a>
                  </div>
                </div>
                <div class="body">
                  <Content />
                </div>
                {(keyMessage || prompts.length > 0) && (
                  <div class="story-end notes">
                    {keyMessage && <p class="key-message">{keyMessage}</p>}
                    {prompts.length > 0 && (
                      <section class="prompts">
                        <h3>{t('talkPrompts')}</h3>
                        <ol>
                          {prompts.map(p => (
                            <li>{p}</li>
                          ))}
                        </ol>
                      </section>
                    )}
                  </div>
                )}
                <p class="colophon-line" data-colophon-line>
                  {t('footerArt')} {t('folioLicence')}
                </p>
              </article>
            )
          )}

          <section class="sheet colophon" data-front>
            <h2>{t('folioAboutTitle')}</h2>
            <p>{t('footerArt')}</p>
            <p>{t('folioLicence')}</p>
            <p>
              {t('folioWebsite')}{' '}
              <a href={website} dir="ltr">
                {website.replace(/^https?:\/\//, '')}
              </a>
            </p>
            {FEEDBACK_EMAIL && (
              <p>
                {t('folioFeedback')
                  .split('{email}')
                  .flatMap((part, i) =>
                    i ? [<bdi dir="ltr">{FEEDBACK_EMAIL}</bdi>, part] : [part]
                  )}
              </p>
            )}
            <p class="as-of">{asOf}</p>
          </section>
        </div>
      )
    }
    <script type="application/json" id="folio-data" set:html={JSON.stringify(data)} />
  </div>
</BaseLayout>

<script>
  import qrcode from 'qrcode-generator';
  import { matchesFilter, skillsForAreas, type LengthBucket } from '@utils/filter-stories';

  interface Story {
    no: string;
    title: string;
    text: string;
    skills: string[];
    languages: string[];
    band: number;
    minutes: number;
  }

  const root = document.querySelector<HTMLElement>('[data-folio]');
  const sheets = root?.querySelector<HTMLElement>('.sheets');
  if (root && sheets) {
    const { stories, areaOf, strings } = JSON.parse(
      document.getElementById('folio-data')!.textContent!
    ) as { stories: Story[]; areaOf: Record<string, string>; strings: Record<string, string> };
    const fill = (text: string, values: Record<string, number>) =>
      text.replace(/\{(\w+)\}/g, (_, k: string) => String(values[k] ?? ''));
    const picks = [...root.querySelectorAll<HTMLInputElement>('[data-pick]')];
    const withText = root.querySelector<HTMLInputElement>('[data-with-text]')!;
    const summary = root.querySelector<HTMLElement>('[data-summary]')!;
    const print = root.querySelector<HTMLButtonElement>('[data-print]')!;
    const others = root.querySelector<HTMLElement>('[data-others]')!;
    const library = root.querySelector<HTMLAnchorElement>('[data-library]')!;
    const newestLink = root.querySelector<HTMLAnchorElement>('[data-newest-link]')!;
    const newestCode = root.querySelector<HTMLElement>('[data-newest-code]')!;

    // The selection comes from the link: an explicit list (`s=002,008`), the Library's own filters, or every story.
    const LIBRARY_KEYS = ['q', 'skill', 'area', 'shelf', 'length', 'lang'];
    const params = new URLSearchParams(location.search);
    const list = (key: string) => (params.get(key) ?? '').split(',').filter(Boolean);
    const libraryQuery = new URLSearchParams(
      LIBRARY_KEYS.filter(k => params.has(k)).map(k => [k, params.get(k)!])
    );
    if (params.has('s')) {
      const wanted = new Set(list('s'));
      picks.forEach((p, i) => (p.checked = wanted.has(stories[i].no)));
    } else if ([...libraryQuery.keys()].length) {
      const criteria = {
        searchQuery: params.get('q') ?? '',
        selectedSkills: skillsForAreas(list('area'), list('skill'), areaOf),
        selectedBands: list('shelf').map(Number),
        selectedLengths: list('length') as LengthBucket[],
        selectedLanguages: list('lang'),
      };
      picks.forEach((p, i) => (p.checked = matchesFilter(stories[i], criteria)));
    }
    withText.checked = params.get('text') !== '0';
    library.search = libraryQuery.toString();

    const chosen = () => picks.flatMap((p, i) => (p.checked ? [i] : []));

    function writeUrl(on: number[]) {
      const next = new URLSearchParams(libraryQuery);
      if (on.length !== picks.length) next.set('s', on.map(i => stories[i].no).join(','));
      if (!withText.checked) next.set('text', '0');
      const query = next.toString().replace(/%2C/g, ',');
      history.replaceState(null, '', location.pathname + (query ? `?${query}` : ''));
    }

    // About how many A4 pages print: the sheets are laid out off screen at the page's width in print type, and each
    // story starts a new page unless the text is left out. Chromium breaks a little earlier than the bare height says,
    // hence the 4% margin. Only an estimate; the print dialog has the real count.
    const PAGE = (264 / 25.4) * 96;
    function estimate(): number {
      sheets!.classList.add('measuring');
      const visible = [...sheets!.querySelectorAll<HTMLElement>('.sheet')].filter(s => !s.hidden);
      const height = (el: HTMLElement) => el.getBoundingClientRect().height;
      const room = PAGE * 0.96;
      // Without the text, stories never split: each goes on the current page if it fits (with the 12 mm rule and gap
      // the print stylesheet adds), otherwise it starts the next one.
      const GAP = (12 / 25.4) * 96;
      let pages = 0;
      let used = room;
      for (const sheet of visible) {
        // The cover and the last page each fill exactly one page by design.
        if (sheet.classList.contains('title-sheet') || sheet.classList.contains('colophon'))
          pages += 1;
        else if (withText.checked || sheet.hasAttribute('data-front'))
          pages += Math.max(1, Math.ceil(height(sheet) / room));
        else {
          const h = height(sheet) + GAP;
          if (used + h > room) {
            pages += 1;
            used = 0;
          }
          used += h;
        }
      }
      sheets!.classList.remove('measuring');
      return pages;
    }

    function sync() {
      const on = chosen();
      const slugs = new Set(on.map(i => picks[i].dataset.pick));
      root!
        .querySelectorAll<HTMLElement>('.sheets [data-story]')
        .forEach(el => (el.hidden = !slugs.has(el.dataset.story)));
      // A skill none of the chosen stories practise drops out of the index, and so does an empty area.
      root!.querySelectorAll<HTMLElement>('[data-skill]').forEach(row => {
        row.hidden = ![...row.querySelectorAll<HTMLElement>('[data-story]')].some(s => !s.hidden);
      });
      root!.querySelectorAll<HTMLElement>('[data-group]').forEach(group => {
        group.hidden = ![...group.querySelectorAll<HTMLElement>('[data-skill]')].some(
          r => !r.hidden
        );
      });
      // One story needs no title page or contents; an overview without the text needs no title page.
      root!.querySelectorAll<HTMLElement>('[data-front]').forEach(el => {
        el.hidden = on.length < 2 || (!withText.checked && el.classList.contains('title-sheet'));
      });
      sheets!.toggleAttribute('data-notext', !withText.checked);
      // A single story carries the colophon in small print at its end instead of a page of its own.
      sheets!
        .querySelectorAll<HTMLElement>('[data-colophon-line]')
        .forEach(p => (p.hidden = on.length >= 2));
      // The jump back to the contents only makes sense when the contents print.
      sheets!
        .querySelectorAll<HTMLElement>('[data-to-contents]')
        .forEach(a => (a.hidden = on.length < 2));

      // The same stories in another language: story numbers are shared, so the selection carries over.
      let anyOther = false;
      root!.querySelectorAll<HTMLAnchorElement>('[data-other]').forEach(a => {
        const there = on.filter(i => stories[i].languages.includes(a.dataset.other!));
        a.hidden = there.length === 0;
        anyOther ||= !a.hidden;
        const query = `s=${there.map(i => stories[i].no).join(',')}${withText.checked ? '' : '&text=0'}`;
        a.href = `${a.dataset.folioHref}?${query}`;
        a.querySelector('[data-other-count]')!.textContent = `(${there.length}/${on.length})`;
      });
      others.hidden = !anyOther;

      const pages = on.length ? estimate() : 0;
      summary.textContent = [
        fill(strings.chosen, { n: on.length, total: picks.length }),
        on.length ? fill(pages === 1 ? strings.pagesOne : strings.pagesMany, { n: pages }) : '',
      ]
        .filter(Boolean)
        .join(' · ');
      print.disabled = on.length === 0;
      writeUrl(on);

      // The title page points back to exactly this selection, so a binder can be refreshed or reprinted later.
      const here = location.href;
      if (newestLink.href !== here) {
        newestLink.href = here;
        newestLink.textContent = here.replace(/^https?:\/\//, '');
        const qr = qrcode(0, 'M');
        qr.addData(here);
        qr.make();
        newestCode.innerHTML = qr.createSvgTag({ cellSize: 4, margin: 0, scalable: true });
      }
    }

    // Covers are lazy, and a hidden sheet never scrolls into view; load the chosen ones before the dialog opens.
    async function loadCovers() {
      const covers = [...sheets!.querySelectorAll<HTMLImageElement>('img')].filter(
        img => !img.hidden && !img.closest('[hidden]')
      );
      covers.forEach(img => (img.loading = 'eager'));
      const loaded = Promise.all(covers.map(img => img.decode().catch(() => undefined)));
      await Promise.race([loaded, new Promise(done => setTimeout(done, 4000))]);
    }
    window.addEventListener('beforeprint', () => {
      sheets!.querySelectorAll<HTMLImageElement>('img').forEach(img => {
        if (!img.hidden && !img.closest('[hidden]')) img.loading = 'eager';
      });
    });

    picks.forEach(p => p.addEventListener('change', sync));
    withText.addEventListener('change', sync);
    root.querySelector('[data-all]')!.addEventListener('click', () => {
      picks.forEach(p => (p.checked = true));
      sync();
    });
    root.querySelector('[data-none]')!.addEventListener('click', () => {
      picks.forEach(p => (p.checked = false));
      sync();
    });
    print.addEventListener('click', async () => {
      print.disabled = true;
      await loadCovers();
      print.disabled = false;
      window.print();
    });
    sync();
    // The estimate depends on the print faces; measure again once they have arrived.
    document.fonts.ready.then(sync);
  }
</script>

<style>
  .folio {
    display: grid;
    /* minmax keeps one wide line (say a stray code block) from widening every sheet past the page. */
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-6);
  }
  .controls h1 {
    font-family: var(--font-display);
    font-size: var(--t-display-1);
    line-height: var(--lh-display);
    margin-block-end: var(--s-3);
  }
  .controls .lead {
    max-inline-size: var(--measure-prose);
  }
  .tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    margin-block-start: var(--s-5);
  }
  .change {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-adult);
    margin-inline-start: auto;
    color: var(--ink);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }
  fieldset {
    border: 0;
    padding: 0;
    margin-block: var(--s-3) var(--s-4);
  }
  .picks {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .picks li {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    border-block-end: 1px solid var(--rule);
  }
  .picks label {
    flex: 1;
    display: flex;
    gap: var(--s-2);
    align-items: center;
    min-block-size: var(--tap-adult);
    padding-block: var(--s-1);
  }
  .picks input,
  .with-text input {
    inline-size: 1.2em;
    block-size: 1.2em;
    flex: none;
    accent-color: var(--accent);
  }
  .picks .no {
    min-inline-size: 2.4em;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .mins {
    color: var(--ink-2);
    white-space: nowrap;
    font-size: var(--t-ui-sm);
  }
  .open {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--tap-adult);
    color: var(--ink);
    font-size: var(--t-ui-sm);
    text-underline-offset: 0.2em;
  }
  .with-text {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    margin-block-start: var(--s-3);
    padding: var(--s-3);
    background: var(--card);
    border-radius: var(--r-m);
  }
  .with-text input {
    margin-block-start: 0.25em;
  }
  .hint {
    display: block;
    color: var(--ink-2);
    font-size: var(--t-ui-sm);
  }
  .others {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-1) var(--s-3);
    margin-block-start: var(--s-3);
  }
  .others a {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-block-size: var(--tap-adult);
    color: var(--ink);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }
  /* The print button stays in reach however long the list is. */
  .print-bar {
    position: sticky;
    inset-block-end: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2) var(--s-4);
    margin-block-start: var(--s-4);
    padding: var(--s-3) var(--s-4);
    background: var(--card);
    border: 2px solid var(--edge);
    border-radius: var(--r-m);
    box-shadow: var(--e-1);
  }
  .summary {
    flex: 1 1 14ch;
    margin: 0;
    font-weight: 700;
  }
  .print-bar .btn {
    flex: none;
  }
  @media (width < 560px) {
    .print-bar {
      flex-wrap: nowrap;
      padding: var(--s-2) var(--s-3);
    }
    .summary {
      font-size: var(--t-ui-sm);
      line-height: 1.3;
    }
  }

  /* The sheets exist only on paper; the browser's print preview is the preview. They carry print type even here, so
     the chooser can lay them out off screen to estimate the page count. */
  .sheets {
    display: none;
    font-size: 11pt;
    line-height: 1.45;
  }
  .sheets.measuring {
    display: block;
    position: absolute;
    inset-block-start: 0;
    inset-inline-start: 0;
    inline-size: 186mm;
    visibility: hidden;
    pointer-events: none;
  }
  .sheet {
    background: #fff;
    color: #000;
  }
  /* Links stay clickable in a saved PDF; on paper they read as plain text. */
  .sheet a {
    color: inherit;
    text-decoration: none;
  }
  /* The site's print style spells out every link's address after it; the folio prints its own short ones. */
  .sheet a::after {
    content: none !important;
  }
  /* Two columns keep the skill index on one page for a whole language's library. */
  .skill-groups {
    columns: 2;
    column-gap: 8mm;
  }
  .skill-groups .group:first-child {
    margin-block-start: 0;
  }
  /* The cover: the site's mark and name, the chosen stories' pictures, the title and language, and at the foot the
     date and the way back to this selection. It fills the page; its band prints even with background graphics off. */
  .title-sheet {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6mm;
    /* A hair under the 264 mm the page leaves, or the foot spills onto a page of its own. */
    min-block-size: 255mm;
    text-align: center;
    /* Paper is light whatever theme the screen is in, so the cover keeps the light palette. */
    --paper: #fbf0de;
    --card: #fff9ef;
    --ink: #24212e;
    --sun: #f2b33d;
    --hill-back: #dce8cf;
    --hill-front: #f5e4ca;
    --poppy-ink: #a3311f;
  }
  .brand {
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3mm;
    padding: 6mm;
    background: var(--paper);
    border-radius: 4mm;
    print-color-adjust: exact;
  }
  .wordmark {
    font-family: var(--font-display);
    font-size: 20pt;
    font-weight: 700;
    color: var(--poppy-ink);
  }
  /* One fixed picture for every folio: the site's mark drawn large over its hills, in vector so it prints sharp. */
  .cover-art {
    position: relative;
    align-self: stretch;
    display: grid;
    place-items: center;
    block-size: 105mm;
    margin-block-start: 4mm;
    print-color-adjust: exact;
  }
  .hills {
    position: absolute;
    inset: auto 0 0;
    inline-size: 100%;
    block-size: 45mm;
  }
  .hill-back {
    fill: var(--hill-back);
  }
  .hill-front {
    fill: var(--hill-front);
  }
  .cover-art :global(.logo) {
    position: relative;
    inline-size: 80mm;
    block-size: 80mm;
    margin-block-end: 18mm;
  }
  .cover-lang {
    margin: 0;
    font-size: 16pt;
    font-weight: 700;
  }
  .tagline {
    margin: 0;
    font-size: 12pt;
    color: #444;
  }
  .cover-foot {
    margin-block-start: auto;
    align-self: stretch;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 6mm;
    padding-block-start: 5mm;
    border-block-start: 1px solid #ccc;
    text-align: start;
  }
  /* The last page, the same in every folio: what a printed copy needs to say once (pictures, licence, where it
     comes from), set at the foot like a book's imprint. */
  .colophon {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 3mm;
    min-block-size: 255mm;
    font-size: 10pt;
    line-height: 1.45;
  }
  .colophon h2 {
    font-family: var(--font-display);
    font-size: 14pt;
    margin: 0 0 2mm;
  }
  .colophon p {
    margin: 0;
    max-inline-size: 150mm;
  }
  .colophon-line {
    margin-block-start: 6mm;
    font-size: 8pt;
    color: #555;
  }
  .as-of {
    margin: 0;
    color: #444;
    font-size: 9.5pt;
  }
  .newest {
    display: flex;
    gap: 4mm;
    align-items: center;
    font-size: 9pt;
    color: #444;
  }
  .newest .qr-code {
    flex: none;
    inline-size: 22mm;
    margin: 0;
  }
  .newest p {
    flex: 0 1 90mm;
    margin: 0;
  }
  /* Index entries and the jump back are links inside the PDF; a dotted line says so on screen and on paper. */
  .overview a,
  .where a,
  .to-contents {
    text-decoration: underline dotted #999;
    text-underline-offset: 0.2em;
  }
  .to-contents {
    display: inline-block;
    font-size: 8pt;
    color: #666;
    margin-block-end: 1mm;
  }
  .url {
    font-size: 7pt;
    overflow-wrap: anywhere;
  }
  .numbers-note {
    color: #444;
    font-size: 9.5pt;
    margin-block-end: var(--s-3);
  }
  .skills-title {
    margin-block-start: 8mm;
  }
  .site,
  .meta {
    color: #444;
  }
  .title-sheet .title {
    font-family: var(--font-display);
    font-size: 34pt;
    line-height: 1.1;
    margin: 6mm 0 0;
  }
  .sheet .no {
    display: inline-block;
    min-inline-size: 2.6em;
    font-weight: 700;
  }
  .overview {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-1);
    margin-block-end: var(--s-4);
  }
  .overview li {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    align-items: baseline;
  }
  .overview .meta {
    margin-inline-start: auto;
  }
  .group {
    margin-block-start: var(--s-4);
  }
  .group ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--s-1);
  }
  .group li {
    display: flex;
    gap: var(--s-3);
    justify-content: space-between;
    border-block-end: 1px solid #ccc;
    padding-block: 2px;
  }
  .where {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }
  .story-title {
    font-family: var(--font-display);
    font-size: 18pt;
    line-height: 1.2;
    margin-block-end: var(--s-1);
  }
  .body :global(h2) {
    font-size: 1.2rem;
    margin-block: var(--s-4) var(--s-2);
  }
  /* The text to read aloud is the largest type on the sheet. */
  .body {
    font-size: 11pt;
  }
  .body :global(p),
  .body :global(li) {
    line-height: 1.45;
    margin-block: 0 0.55em;
  }
  /* The title is in the sheet head; a translation's leading `# Title` line would repeat it. */
  .body :global(h1) {
    display: none;
  }
  /* An indented line in a story file renders as a code block; on paper it is just text. */
  .body :global(pre) {
    background: none !important;
    color: inherit !important;
    font: inherit;
    white-space: pre-wrap;
    overflow: visible !important;
    padding: 0;
    margin: 0;
  }
  /* Storybook page breaks are only a pause on paper. */
  .body :global(hr) {
    border: 0;
    margin-block: var(--s-3);
  }
  /* Without the text a story is its notes: summary, key message, prompts and QR code. */
  .sheets[data-notext] .body {
    display: none;
  }
  .story-end {
    margin-block-start: 5mm;
  }
  .key-message {
    font-weight: 700;
  }
  .prompts h3 {
    font-size: 10pt;
    margin-block: 2mm 1mm;
  }
  .prompts ol {
    margin: 0;
    padding-inline-start: 5mm;
  }
  /* The head is the grown-up's: cover to recognise it by, title, and notes (shelf, minutes, skills, summary). */
  .story-head {
    display: flex;
    gap: 4mm;
    align-items: flex-start;
    margin-block-end: 4mm;
  }
  .cover {
    flex: none;
    inline-size: 22mm;
    block-size: 22mm;
    object-fit: cover;
    border-radius: 2mm;
  }
  .head-text {
    flex: 1;
    min-inline-size: 0;
  }
  .notes {
    border: 1px solid #bbb;
    border-radius: 2mm;
    padding: 2.5mm 3mm;
    font-size: 9.5pt;
    line-height: 1.4;
  }
  .notes p {
    margin: 0;
  }
  .notes .meta + .summary-text {
    margin-block-start: 1.5mm;
  }
  .qr {
    flex: none;
    inline-size: 26mm;
    font-size: 7pt;
    line-height: 1.2;
    text-align: center;
    color: #444;
  }
  .qr p {
    margin-block: 1mm 0.5mm;
  }
  .qr-code {
    inline-size: 20mm;
    margin-inline: auto;
  }
  [hidden] {
    display: none !important;
  }
  /* Choosing and printing need scripts; without them the list and the browser's own Print still work. */
  :global(:root:not([data-js])) [data-js-only] {
    display: none;
  }
</style>

<style is:global>
  @media print {
    body:has([data-folio]) > header,
    body:has([data-folio]) > footer,
    body:has([data-folio]) .controls,
    body:has([data-folio]) [data-offline-bar] {
      display: none !important;
    }
    [data-folio] {
      page: folio;
    }
    /* body raises specificity over the scoped screen rule that hides the sheets. */
    body [data-folio] .sheets {
      display: block;
    }
    [data-folio] .sheet {
      break-after: page;
    }
    [data-folio] .sheet:last-child {
      break-after: auto;
    }
    [data-folio] .story-sheet {
      break-before: page;
    }
    /* Without the text, stories follow one another, a rule between them, as many to a page as fit. */
    [data-folio] .sheets[data-notext] .story-sheet {
      break-before: auto;
      break-after: auto;
      break-inside: avoid;
      padding-block-end: 6mm;
      margin-block-end: 6mm;
      border-block-end: 1px solid #999;
    }
    [data-folio] .colophon {
      break-before: page;
    }
    [data-folio] .story-sheet h2,
    [data-folio] .story-sheet h3 {
      break-after: avoid;
    }
    [data-folio] .story-end,
    [data-folio] .group,
    [data-folio] .qr {
      break-inside: avoid;
    }
    [data-folio] .group h3 {
      break-after: avoid;
    }
    body:has([data-folio]) {
      background: #fff;
    }
  }
</style>
