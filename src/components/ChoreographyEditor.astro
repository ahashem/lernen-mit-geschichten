---
/**
 * Choreography Editor Component
 * Timeline-based dance move editor with drag-and-drop
 */

interface Props {
  lang: string;
}

const { lang } = Astro.props;
---

<div class="choreography-editor" id="choreography-editor">
  <div class="editor-header">
    <h2>🎭 Choreography Creator</h2>
    <div class="editor-actions">
      <button class="action-btn" id="save-choreo-btn">
        💾 Save
      </button>
      <button class="action-btn" id="load-choreo-btn">
        📂 Load
      </button>
      <button class="action-btn" id="play-choreo-btn">
        ▶️ Play
      </button>
      <button class="action-btn" id="clear-choreo-btn">
        🗑️ Clear
      </button>
    </div>
  </div>

  <!-- Move Palette -->
  <div class="move-palette">
    <h3>Dance Moves</h3>
    <div class="difficulty-filter">
      <button class="filter-btn active" data-difficulty="all">All</button>
      <button class="filter-btn" data-difficulty="basic">Basic</button>
      <button class="filter-btn" data-difficulty="intermediate">Intermediate</button>
      <button class="filter-btn" data-difficulty="advanced">Advanced</button>
    </div>

    <div class="moves-grid" id="moves-grid">
      <!-- Populated by JavaScript -->
    </div>
  </div>

  <!-- Character Selector -->
  <div class="character-selector">
    <h3>Characters</h3>
    <div class="characters-list" id="characters-list">
      <!-- Populated by JavaScript -->
    </div>
  </div>

  <!-- Timeline -->
  <div class="timeline-container">
    <div class="timeline-header">
      <h3>Timeline</h3>
      <div class="timeline-controls">
        <span>Zoom:</span>
        <button id="zoom-in">+</button>
        <button id="zoom-out">-</button>
        <span class="timeline-duration">Duration: <span id="timeline-duration">0</span>s</span>
      </div>
    </div>

    <div class="timeline" id="timeline">
      <div class="timeline-ruler" id="timeline-ruler">
        <!-- Beat markers generated by JS -->
      </div>

      <div class="timeline-tracks" id="timeline-tracks">
        <!-- Character tracks generated by JS -->
      </div>

      <div class="playhead" id="playhead"></div>
    </div>
  </div>

  <!-- Preview Stage -->
  <div class="preview-stage">
    <h3>Preview</h3>
    <div class="stage" id="preview-stage">
      <!-- Characters appear here during preview -->
    </div>
  </div>

  <!-- Saved Choreographies -->
  <div class="saved-choreographies" id="saved-choreographies">
    <h3>Saved Choreographies (Max 10)</h3>
    <div class="choreo-list" id="choreo-list">
      <!-- Populated by JavaScript -->
    </div>
  </div>
</div>

<style>
  .choreography-editor {
    width: 100%;
    min-height: 100vh;
    background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
    color: white;
    padding: 2rem;
  }

  .editor-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .editor-header h2 {
    font-size: 2rem;
    background: linear-gradient(135deg, #4ecdc4, #44a3db);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .editor-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .action-btn {
    padding: 0.75rem 1.5rem;
    border: 2px solid #4ecdc4;
    border-radius: 12px;
    background: rgba(78, 205, 196, 0.1);
    color: white;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .action-btn:hover {
    background: rgba(78, 205, 196, 0.2);
    transform: translateY(-2px);
  }

  .action-btn:active {
    transform: translateY(0);
  }

  /* Move Palette */
  .move-palette {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.1);
  }

  .move-palette h3 {
    margin-bottom: 1rem;
    color: #4ecdc4;
  }

  .difficulty-filter {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: 0.5rem 1rem;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    color: white;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .filter-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .filter-btn.active {
    background: #4ecdc4;
    border-color: #4ecdc4;
  }

  .moves-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
    gap: 0.75rem;
    max-height: 300px;
    overflow-y: auto;
  }

  .move-card {
    padding: 1rem;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    text-align: center;
    cursor: grab;
    transition: all 0.3s ease;
    user-select: none;
  }

  .move-card:active {
    cursor: grabbing;
  }

  .move-card:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  .move-card.basic {
    border-color: #4ecdc4;
  }

  .move-card.intermediate {
    border-color: #ffd93d;
  }

  .move-card.advanced {
    border-color: #ff6b6b;
  }

  .move-emoji {
    font-size: 2rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .move-name {
    font-size: 0.9rem;
    font-weight: bold;
  }

  .move-duration {
    font-size: 0.8rem;
    opacity: 0.7;
    margin-top: 0.25rem;
  }

  /* Character Selector */
  .character-selector {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.1);
  }

  .character-selector h3 {
    margin-bottom: 1rem;
    color: #4ecdc4;
  }

  .characters-list {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .character-item {
    padding: 1rem;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.05);
    font-size: 2rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .character-item:hover {
    background: rgba(255, 255, 255, 0.1);
    transform: scale(1.05);
  }

  .character-item.selected {
    border-color: #4ecdc4;
    background: rgba(78, 205, 196, 0.2);
    box-shadow: 0 0 20px rgba(78, 205, 196, 0.4);
  }

  /* Timeline */
  .timeline-container {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.1);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .timeline-header h3 {
    color: #4ecdc4;
  }

  .timeline-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .timeline-controls button {
    padding: 0.5rem 0.75rem;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .timeline-controls button:hover {
    background: rgba(255, 255, 255, 0.2);
  }

  .timeline {
    position: relative;
    min-height: 400px;
    background: rgba(0, 0, 0, 0.3);
    border-radius: 8px;
    overflow-x: auto;
    overflow-y: auto;
  }

  .timeline-ruler {
    height: 40px;
    background: rgba(255, 255, 255, 0.05);
    border-bottom: 2px solid rgba(255, 255, 255, 0.2);
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
  }

  .beat-marker {
    flex: 0 0 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .beat-marker.major {
    background: rgba(78, 205, 196, 0.1);
    border-right: 2px solid rgba(78, 205, 196, 0.3);
    font-weight: bold;
  }

  .timeline-tracks {
    position: relative;
  }

  .track {
    height: 80px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    position: relative;
    display: flex;
  }

  .track-label {
    position: sticky;
    left: 0;
    width: 100px;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    border-right: 2px solid rgba(255, 255, 255, 0.2);
    z-index: 5;
  }

  .track-content {
    flex: 1;
    position: relative;
    display: flex;
  }

  .track-beat {
    flex: 0 0 60px;
    border-right: 1px solid rgba(255, 255, 255, 0.05);
    position: relative;
  }

  .track-beat.major {
    background: rgba(78, 205, 196, 0.05);
  }

  .timeline-move {
    position: absolute;
    top: 10px;
    height: 60px;
    padding: 0.5rem;
    background: linear-gradient(135deg, #4ecdc4, #44a3db);
    border-radius: 8px;
    border: 2px solid #4ecdc4;
    cursor: move;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 4px 15px rgba(78, 205, 196, 0.3);
    transition: all 0.2s ease;
    user-select: none;
  }

  .timeline-move:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(78, 205, 196, 0.5);
  }

  .timeline-move.dragging {
    opacity: 0.5;
    z-index: 20;
  }

  .playhead {
    position: absolute;
    top: 0;
    left: 0;
    width: 2px;
    height: 100%;
    background: #ff6b6b;
    box-shadow: 0 0 10px rgba(255, 107, 107, 0.8);
    z-index: 15;
    pointer-events: none;
  }

  .playhead.playing {
    animation: playheadMove 4s linear infinite;
  }

  @keyframes playheadMove {
    from { left: 100px; }
    to { left: 100%; }
  }

  /* Preview Stage */
  .preview-stage {
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.1);
  }

  .preview-stage h3 {
    margin-bottom: 1rem;
    color: #4ecdc4;
  }

  .stage {
    width: 100%;
    height: 300px;
    background: linear-gradient(to bottom, #2d1b69 0%, #1a0f3d 100%);
    border-radius: 12px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 2rem;
    gap: 2rem;
  }

  .stage-character {
    font-size: 4rem;
    transition: all 0.3s ease;
    filter: drop-shadow(0 8px 16px rgba(0, 0, 0, 0.5));
  }

  /* Saved Choreographies */
  .saved-choreographies {
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    border: 2px solid rgba(255, 255, 255, 0.1);
  }

  .saved-choreographies h3 {
    margin-bottom: 1rem;
    color: #4ecdc4;
  }

  .choreo-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .choreo-card {
    padding: 1.5rem;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 12px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .choreo-card:hover {
    background: rgba(255, 255, 255, 0.15);
    transform: translateY(-2px);
  }

  .choreo-name {
    font-size: 1.1rem;
    font-weight: bold;
    margin-bottom: 0.5rem;
  }

  .choreo-info {
    font-size: 0.9rem;
    opacity: 0.7;
    margin-bottom: 0.25rem;
  }

  .choreo-stars {
    margin-top: 0.5rem;
    font-size: 1.2rem;
  }

  .choreo-actions {
    margin-top: 1rem;
    display: flex;
    gap: 0.5rem;
  }

  .choreo-btn {
    flex: 1;
    padding: 0.5rem;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.05);
    color: white;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .choreo-btn:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .choreo-btn.delete {
    background: rgba(255, 107, 107, 0.2);
    border-color: #ff6b6b;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .choreography-editor {
      padding: 1rem;
    }

    .moves-grid {
      grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
    }

    .track-label {
      width: 60px;
      font-size: 1.2rem;
    }

    .stage {
      height: 200px;
    }

    .stage-character {
      font-size: 2.5rem;
    }
  }
</style>

<script>
  import {
    danceMoves,
    saveChoreography,
    getChoreographies,
    deleteChoreography,
    type Choreography,
    type ChoreographyStep,
  } from '../utils/dance-party';

  let selectedCharacters: string[] = [];
  let currentChoreography: ChoreographyStep[] = [];
  let zoomLevel = 1;
  let isPlaying = false;

  const storyCharacters = [
    { emoji: '🐻', name: 'Bruno', id: 'bruno' },
    { emoji: '🐿️', name: 'Fritz', id: 'fritz' },
    { emoji: '🦁', name: 'Leo', id: 'leo' },
    { emoji: '🐭', name: 'Moritz', id: 'moritz' },
    { emoji: '👧', name: 'Lina', id: 'lina' },
    { emoji: '👦', name: 'Tobi', id: 'tobi' },
  ];

  document.addEventListener('DOMContentLoaded', () => {
    initializeMovesGrid();
    initializeCharacterSelector();
    initializeTimeline();
    loadSavedChoreographies();
    setupEventListeners();
  });

  function initializeMovesGrid() {
    const grid = document.getElementById('moves-grid');
    if (!grid) return;

    danceMoves.forEach((move) => {
      const card = document.createElement('div');
      card.className = `move-card ${move.difficulty}`;
      card.draggable = true;
      card.dataset.moveId = move.id;
      card.dataset.duration = move.duration.toString();

      card.innerHTML = `
        <span class="move-emoji">${move.emoji}</span>
        <div class="move-name">${move.name.en}</div>
        <div class="move-duration">${move.duration} beats</div>
      `;

      card.addEventListener('dragstart', handleMoveragStart);
      grid.appendChild(card);
    });
  }

  function initializeCharacterSelector() {
    const list = document.getElementById('characters-list');
    if (!list) return;

    storyCharacters.forEach((char) => {
      const item = document.createElement('div');
      item.className = 'character-item';
      item.textContent = char.emoji;
      item.title = char.name;
      item.dataset.charId = char.id;
      item.dataset.emoji = char.emoji;

      item.addEventListener('click', () => {
        if (selectedCharacters.includes(char.id)) {
          selectedCharacters = selectedCharacters.filter((id) => id !== char.id);
          item.classList.remove('selected');
        } else {
          selectedCharacters.push(char.id);
          item.classList.add('selected');
        }
        updateTimeline();
        updatePreviewStage();
      });

      list.appendChild(item);
    });
  }

  function initializeTimeline() {
    const ruler = document.getElementById('timeline-ruler');
    const tracks = document.getElementById('timeline-tracks');

    if (!ruler || !tracks) return;

    // Create beat markers
    for (let i = 0; i < 60; i++) {
      const marker = document.createElement('div');
      marker.className = `beat-marker ${i % 4 === 0 ? 'major' : ''}`;
      marker.textContent = i % 4 === 0 ? i.toString() : '';
      ruler.appendChild(marker);
    }
  }

  function updateTimeline() {
    const tracks = document.getElementById('timeline-tracks');
    if (!tracks) return;

    tracks.innerHTML = '';

    selectedCharacters.forEach((charId) => {
      const char = storyCharacters.find((c) => c.id === charId);
      if (!char) return;

      const track = document.createElement('div');
      track.className = 'track';
      track.dataset.charId = charId;

      const label = document.createElement('div');
      label.className = 'track-label';
      label.textContent = char.emoji;

      const content = document.createElement('div');
      content.className = 'track-content';

      // Create beat cells
      for (let i = 0; i < 60; i++) {
        const beat = document.createElement('div');
        beat.className = `track-beat ${i % 4 === 0 ? 'major' : ''}`;
        beat.dataset.beat = i.toString();
        beat.addEventListener('dragover', handleDragOver);
        beat.addEventListener('drop', (e) => handleDrop(e, charId, i));
        content.appendChild(beat);
      }

      track.appendChild(label);
      track.appendChild(content);
      tracks.appendChild(track);
    });

    // Render existing choreography steps
    renderChoreographySteps();
  }

  function renderChoreographySteps() {
    currentChoreography.forEach((step) => {
      const track = document.querySelector(
        `.track[data-char-id="${step.characterId}"] .track-content`
      );
      if (!track) return;

      const move = danceMoves.find((m) => m.id === step.moveId);
      if (!move) return;

      const moveEl = document.createElement('div');
      moveEl.className = 'timeline-move';
      moveEl.textContent = move.emoji;
      moveEl.style.left = `${step.beat * 60}px`;
      moveEl.style.width = `${step.duration * 60}px`;
      moveEl.draggable = true;
      moveEl.dataset.stepId = `${step.characterId}-${step.beat}`;

      moveEl.addEventListener('dragstart', (e) => {
        moveEl.classList.add('dragging');
        e.dataTransfer!.effectAllowed = 'move';
      });

      moveEl.addEventListener('dragend', () => {
        moveEl.classList.remove('dragging');
      });

      moveEl.addEventListener('dblclick', () => {
        // Remove step
        currentChoreography = currentChoreography.filter(
          (s) => !(s.characterId === step.characterId && s.beat === step.beat)
        );
        updateTimeline();
      });

      track.appendChild(moveEl);
    });
  }

  function handleDragStart(e: DragEvent) {
    const target = e.target as HTMLElement;
    e.dataTransfer!.setData('moveId', target.dataset.moveId || '');
    e.dataTransfer!.setData('duration', target.dataset.duration || '1');
    e.dataTransfer!.effectAllowed = 'copy';
  }

  function handleDragOver(e: DragEvent) {
    e.preventDefault();
    e.dataTransfer!.dropEffect = 'copy';
  }

  function handleDrop(e: DragEvent, characterId: string, beat: number) {
    e.preventDefault();

    const moveId = e.dataTransfer!.getData('moveId');
    const duration = parseInt(e.dataTransfer!.getData('duration')) || 1;

    if (!moveId) return;

    // Check if slot is occupied
    const conflictExists = currentChoreography.some(
      (step) =>
        step.characterId === characterId &&
        ((step.beat <= beat && beat < step.beat + step.duration) ||
          (beat <= step.beat && step.beat < beat + duration))
    );

    if (conflictExists) {
      alert('This time slot is already occupied!');
      return;
    }

    // Add step to choreography
    const newStep: ChoreographyStep = {
      beat,
      characterId,
      moveId,
      duration,
    };

    currentChoreography.push(newStep);
    currentChoreography.sort((a, b) => a.beat - b.beat);

    updateTimeline();
    updateDuration();
  }

  function updatePreviewStage() {
    const stage = document.getElementById('preview-stage');
    if (!stage) return;

    stage.innerHTML = '';

    selectedCharacters.forEach((charId) => {
      const char = storyCharacters.find((c) => c.id === charId);
      if (!char) return;

      const charEl = document.createElement('div');
      charEl.className = 'stage-character';
      charEl.textContent = char.emoji;
      charEl.dataset.charId = charId;

      stage.appendChild(charEl);
    });
  }

  function updateDuration() {
    const maxBeat = Math.max(...currentChoreography.map((s) => s.beat + s.duration), 0);
    const duration = Math.ceil(maxBeat * 0.5); // Assuming 120 BPM
    const durationEl = document.getElementById('timeline-duration');
    if (durationEl) durationEl.textContent = duration.toString();
  }

  function setupEventListeners() {
    // Save choreography
    document.getElementById('save-choreo-btn')?.addEventListener('click', () => {
      const name = prompt('Enter choreography name:');
      if (!name) return;

      const choreography: Choreography = {
        id: `choreo-${Date.now()}`,
        name,
        trackId: 'pop-dance', // Default track
        steps: currentChoreography,
        characters: selectedCharacters,
        createdAt: Date.now(),
        stars: 0,
      };

      saveChoreography(choreography);
      loadSavedChoreographies();
      alert('Choreography saved!');
    });

    // Play choreography
    document.getElementById('play-choreo-btn')?.addEventListener('click', playChoreography);

    // Clear choreography
    document.getElementById('clear-choreo-btn')?.addEventListener('click', () => {
      if (confirm('Clear all moves?')) {
        currentChoreography = [];
        updateTimeline();
        updateDuration();
      }
    });

    // Difficulty filter
    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const target = e.currentTarget as HTMLElement;
        document.querySelectorAll('.filter-btn').forEach((b) => b.classList.remove('active'));
        target.classList.add('active');

        const difficulty = target.dataset.difficulty;
        filterMoves(difficulty || 'all');
      });
    });

    // Zoom controls
    document.getElementById('zoom-in')?.addEventListener('click', () => {
      zoomLevel = Math.min(zoomLevel + 0.25, 2);
      applyZoom();
    });

    document.getElementById('zoom-out')?.addEventListener('click', () => {
      zoomLevel = Math.max(zoomLevel - 0.25, 0.5);
      applyZoom();
    });
  }

  function filterMoves(difficulty: string) {
    const moves = document.querySelectorAll('.move-card');
    moves.forEach((move) => {
      const card = move as HTMLElement;
      if (difficulty === 'all' || card.classList.contains(difficulty)) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function applyZoom() {
    const timeline = document.getElementById('timeline');
    if (timeline) {
      timeline.style.transform = `scaleX(${zoomLevel})`;
      timeline.style.transformOrigin = 'left top';
    }
  }

  function playChoreography() {
    if (currentChoreography.length === 0) {
      alert('No moves to play! Add some moves to the timeline.');
      return;
    }

    isPlaying = true;
    const playhead = document.getElementById('playhead');
    if (playhead) playhead.classList.add('playing');

    // Animate characters
    currentChoreography.forEach((step) => {
      setTimeout(() => {
        const charEl = document.querySelector(
          `.stage-character[data-char-id="${step.characterId}"]`
        ) as HTMLElement;
        if (!charEl) return;

        const move = danceMoves.find((m) => m.id === step.moveId);
        if (!move) return;

        charEl.style.animation = `${move.animation} ${move.duration * 0.5}s ease-in-out`;

        setTimeout(() => {
          charEl.style.animation = '';
        }, move.duration * 500);
      }, step.beat * 500); // 120 BPM = 500ms per beat
    });

    // Stop after duration
    const maxDuration = Math.max(...currentChoreography.map((s) => s.beat + s.duration)) * 500;
    setTimeout(() => {
      isPlaying = false;
      if (playhead) playhead.classList.remove('playing');
    }, maxDuration);
  }

  function loadSavedChoreographies() {
    const list = document.getElementById('choreo-list');
    if (!list) return;

    list.innerHTML = '';
    const saved = getChoreographies();

    if (saved.length === 0) {
      list.innerHTML = '<p style="opacity: 0.6;">No saved choreographies yet</p>';
      return;
    }

    saved.forEach((choreo) => {
      const card = document.createElement('div');
      card.className = 'choreo-card';

      card.innerHTML = `
        <div class="choreo-name">${choreo.name}</div>
        <div class="choreo-info">${choreo.steps.length} moves</div>
        <div class="choreo-info">${choreo.characters.length} characters</div>
        <div class="choreo-stars">${'⭐'.repeat(choreo.stars || 0)}</div>
        <div class="choreo-actions">
          <button class="choreo-btn load">Load</button>
          <button class="choreo-btn delete">Delete</button>
        </div>
      `;

      card.querySelector('.load')?.addEventListener('click', () => {
        currentChoreography = [...choreo.steps];
        selectedCharacters = [...choreo.characters];

        // Update UI
        document.querySelectorAll('.character-item').forEach((item) => {
          const charId = (item as HTMLElement).dataset.charId;
          if (charId && selectedCharacters.includes(charId)) {
            item.classList.add('selected');
          } else {
            item.classList.remove('selected');
          }
        });

        updateTimeline();
        updatePreviewStage();
        updateDuration();
      });

      card.querySelector('.delete')?.addEventListener('click', () => {
        if (confirm(`Delete "${choreo.name}"?`)) {
          deleteChoreography(choreo.id);
          loadSavedChoreographies();
        }
      });

      list.appendChild(card);
    });
  }
</script>
