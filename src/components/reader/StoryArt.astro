---
import type { Picture } from '@utils/story-art';

interface Props {
  picture?: Picture;
  emoji: string;
  palette: [string, string];
  eager?: boolean;
}
const { picture, emoji, palette, eager = false } = Astro.props;
---

{
  picture ? (
    <img
      src={picture.src}
      alt={picture.alt}
      lang={picture.altLang}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <div class="art-fallback" style={`--a:${palette[0]};--b:${palette[1]}`} aria-hidden="true">
      <span class="sun" />
      <span class="hill" />
      <span class="emoji">{emoji}</span>
    </div>
  )
}

<style>
  img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }
  /* Two flat inks, no gradient (ux/02): a plate, a sun printed slightly off-register, a hill to stand on. */
  .art-fallback {
    position: relative;
    inline-size: 100%;
    block-size: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: var(--a);
  }
  .sun {
    position: absolute;
    inline-size: 58cqi;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--b);
    translate: calc(5cqi * var(--shadow-x)) -6%;
    box-shadow: inset 0 0 0 3px rgb(255 255 255 / 0.35);
  }
  .hill {
    position: absolute;
    inset-inline: -10%;
    inset-block-end: -30%;
    block-size: 48%;
    border-radius: 50%;
    background: color-mix(in srgb, var(--card) 60%, var(--a));
  }
  .emoji {
    position: relative;
    font-size: clamp(56px, 30cqi, 160px);
    line-height: 1;
    text-decoration: none;
  }
  /* Pop-up depth (global.css, card physics). A card that lifts sets --pop and, under a mouse, --tilt-x/--tilt-y
     (-1 to 1). Layers then move by depth: the sun far back barely, against the pointer; the hill a little; the emoji
     rises off the page and follows the pointer most. A picture drifts against the pointer and leans in. Outside a
     card (the hero, the story cover) nothing is set, so nothing moves. */
  @media (prefers-reduced-motion: no-preference) {
    img,
    .sun,
    .hill,
    .emoji {
      transition: transform var(--dur-base) var(--ease-out);
    }
    img {
      transform: translate(calc(var(--tilt-x, 0) * -2cqi), calc(var(--tilt-y, 0) * -2cqi))
        scale(calc(1 + var(--pop, 0) * 0.05));
    }
    .sun {
      transform: translate(calc(var(--tilt-x, 0) * -3cqi), calc(var(--tilt-y, 0) * -3cqi));
    }
    .hill {
      transform: translate(calc(var(--tilt-x, 0) * 2cqi), calc(var(--pop, 0) * -2cqi));
    }
    .emoji {
      transform: translate(
          calc(var(--tilt-x, 0) * 5cqi),
          calc(var(--tilt-y, 0) * 4cqi - var(--pop, 0) * 5cqi)
        )
        scale(calc(1 + var(--pop, 0) * 0.12));
    }
  }
</style>
