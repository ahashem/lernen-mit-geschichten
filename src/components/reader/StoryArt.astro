---
import type { Picture } from '@utils/story-art';

interface Props {
  picture?: Picture;
  emoji: string;
  palette: [string, string];
  eager?: boolean;
}
const { picture, emoji, palette, eager = false } = Astro.props;
---

{
  picture ? (
    <img
      src={picture.src}
      alt={picture.alt}
      lang={picture.altLang}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  ) : (
    <div class="art-fallback" style={`--a:${palette[0]};--b:${palette[1]}`} aria-hidden="true">
      <span>{emoji}</span>
    </div>
  )
}

<style>
  img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }
  .art-fallback {
    inline-size: 100%;
    block-size: 100%;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--a), var(--b));
    font-size: clamp(64px, 18cqi, 160px);
  }
</style>
