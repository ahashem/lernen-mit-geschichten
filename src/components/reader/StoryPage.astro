  }

  <script type="application/json" id="reader-data" set:html={JSON.stringify(clientData)} />
</BaseLayout>

<script>
  import { startReader } from './reader';

  startReader();

  document.querySelectorAll<HTMLButtonElement>('.export-booklet-btn').forEach(button => {
    button.addEventListener('click', async () => {
      const content = document.querySelector<HTMLElement>('.story-content');
      const view = content?.closest<HTMLElement>('.view');
      if (!content || !view) return;
      const wasHidden = view.hidden;
      view.hidden = false;
      // The PDF libraries are most of this page's script; they load only when a grown-up asks for the booklet.
      const { exportAsBooklet, showExportProgress, hideExportProgress, detectOrientation } =
        await import('@utils/booklet-export');
      const overlay = showExportProgress(button.dataset.progress ?? '');
      try {
        await exportAsBooklet(content, {
          orientation: detectOrientation(content),
          pageSize: 'a5',
          title: button.dataset.storyTitle ?? 'Story',
          addCover: true,
          addPageNumbers: true,
        });
      } finally {
        view.hidden = wasHidden;
        hideExportProgress(overlay);
      }
    });
  });
</script>

