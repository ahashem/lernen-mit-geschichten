---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getPublishedStories, getStoryMeta, readMinutes } from '@utils/stories';
import { endonyms, fmt, getTranslation, isRTL, type Locale } from '@utils/i18n';
import { getSkillsByIds } from '@utils/skills-taxonomy';
import { BASE_PATH } from '@utils/site';
import {
  alignTo,
  chapterTitles,
  firstSentence,
  paginate,
  wordsOf,
  type BookPage,
} from '@utils/story-pages';
import { coverOf, frameFor, narrationFor, paletteFor } from '@utils/story-art';
import Icon from './Icon.astro';
import StoryArt from './StoryArt.astro';
import EducatorTools from './EducatorTools.astro';
import PrintSheets from './PrintSheets.astro';
import FeedbackLink from './FeedbackLink.astro';

interface Props {
  story: CollectionEntry<'stories'>;
}

const { story } = Astro.props;
const locale = story.id.split('/')[0] as Locale;
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key);
const { storyId, title } = story.data;

const meta = await getStoryMeta(storyId);
const emoji = story.data.emoji ?? meta?.emoji ?? '📖';
const band = meta?.band ?? 1;
const palette = paletteFor(storyId, meta);
const { Content } = await render(story);
const { pages, explicit } = paginate(story.body ?? '', locale, band, story.data.pages);
const hasBook = band <= 2 && pages.length > 0;
// Bands 3-4 read as chapters (the `##` headings); a story without them stays a full text.
const chapters = band >= 3 ? chapterTitles(story.body ?? '') : [];
const narration = narrationFor(storyId, locale, pages.length, explicit);
const cover = coverOf(meta, locale);
const minutes = readMinutes(story.body);
const skills = await getSkillsByIds(story.data.skills ?? meta?.skills ?? [], locale);
const summary = story.data.summary ?? firstSentence(story.body ?? '', locale);
const prompts = (story.data.discussion ?? story.data.questions?.map(q => q.text) ?? []).slice(0, 3);

const storyUrl = `${Astro.site?.origin ?? ''}${Astro.url.pathname}`;
const colouring = (meta?.frames ?? [])
  .map((_, i) => frameFor(meta, i + 1, locale))
  .filter((p): p is NonNullable<typeof p> => !!p);

const home = locale === 'de' ? `${BASE_PATH}/` : `${BASE_PATH}/${locale}`;
const siblings = (await getPublishedStories(s => s.data.storyId === storyId)).filter(
  s => s.id !== story.id
);
const otherLanguages = siblings.map(s => {
  const loc = s.id.split('/')[0] as Locale;
  const slug = s.id.replace(`${loc}/`, '');
  return {
    locale: loc,
    href: loc === 'de' ? `${BASE_PATH}/stories/${slug}` : `${BASE_PATH}/${loc}/stories/${slug}`,
  };
});

// Every translation that can be cut into exactly these pages can be read beside this one.
const aligned: Record<string, BookPage[]> = { [locale]: pages };
for (const sibling of siblings) {
  const loc = sibling.id.split('/')[0] as Locale;
  const other = alignTo({ pages, explicit }, sibling.body ?? '', loc, band, sibling.data.pages);
  if (other) aligned[loc] = other;
}
const allLocales: Locale[] = ['de', 'ar', 'en', 'tr', 'ur'];
const canPair = hasBook && Object.keys(aligned).length >= 2;

const keys = [
  'pageOf',
  'noVoiceFor',
  'noSoundNow',
  'timerMinutes',
  'goodNight',
  'theEnd',
  'readAloud',
  'lampTip',
  'chapterOf',
  'chapterShort',
  'chapterDoneNext',
  'toCover',
  'dismiss',
  'previousPage',
  'nextPage',
  'voiceOpen',
  'voiceIntro',
  'voiceContinue',
  'voiceRecord',
  'voiceAgain',
  'voiceStop',
  'voicePlay',
  'voiceKeep',
  'voiceDelete',
  'voiceDeleteAll',
  'voiceConfirm',
  'voiceConfirmYes',
  'voiceConfirmNo',
  'voiceRecorded',
  'voiceNone',
  'voiceRecording',
  'voiceStopped',
  'voiceSaved',
  'voiceDeleted',
  'voiceDenied',
  'voiceFailed',
] as const;
const strings = Object.fromEntries(keys.map(k => [k, t(k)]));
const clientData = {
  storyId,
  locale,
  title,
  siteName: t('siteName'),
  endonyms,
  aligned: Object.keys(aligned),
  audio: narration?.audio ?? null,
  timings: narration?.timings ?? null,
  pageCount: pages.length,
  strings,
};
const description = summary || `${title} | ${t('siteName')}`;
---

<BaseLayout
  title={title}
  locale={locale}
  description={description}
  type="article"
  image={cover ? `${Astro.site?.origin ?? ''}${cover.src}` : undefined}
  storyHrefs={Object.fromEntries([
    [locale, Astro.url.pathname],
    ...otherLanguages.map(l => [l.locale, l.href]),
  ])}
>
  <div
    class="story-app"
    data-band={band}
    data-has-book={hasBook}
    data-chapters={chapters.length || undefined}
    data-view="cover"
    data-story-id={storyId}
  >
    <section class="view cover" data-view="cover" aria-labelledby="story-title" tabindex="-1">
      <div class="container cover-grid">
        <div class="cover-art surface">
          <StoryArt picture={cover} emoji={emoji} palette={palette} eager />
        </div>
        <div class="cover-main">
          <h1 id="story-title" class="cover-title">{title}</h1>
          {
            hasBook && (
              <div class="cover-actions" data-js-only>
                <button class="btn btn--listen btn--lg" data-action="read-with-me" type="button">
                  <Icon name="play" size={28} />
                  <span>{narration ? t('readWithMe') : t('readWithDeviceVoice')}</span>
                </button>
                <div class="cover-secondary">
                  <button class="btn" data-action="read-myself" type="button">
                    {t('readMyself')}
                  </button>
                  {canPair && (
                    <button class="btn" data-action="pair-setup" type="button">
                      {t('twoLanguages')}
                    </button>
                  )}
                  <button class="btn" data-action="full-text" type="button">
                    {t('fullText')}
                  </button>
                </div>
              </div>
            )
          }
          {
            chapters.length > 0 && (
              <div class="cover-actions" data-js-only>
                <button class="btn btn--primary btn--lg" data-action="start-chapters" type="button">
                  <span
                    data-resume-label
                    data-start={t('startReading')}
                    data-continue={t('continueReading')}
                  >
                    {t('startReading')}
                  </span>
                </button>
                <div class="cover-secondary">
                  <button class="btn" data-action="full-text" type="button">
                    {t('fullText')}
                  </button>
                </div>
                <h2 class="small-heading">{t('chaptersHeading')}</h2>
                <ol class="chapter-list">
                  {chapters.map((c, i) => (
                    <li>
                      <button class="chapter-link" type="button" data-chapter={i}>
                        <span class="chapter-no">{i + 1}</span>
                        {c}
                      </button>
                    </li>
                  ))}
                </ol>
              </div>
            )
          }
          <details class="grownups surface">
            <summary>{t('forGrownUps')}</summary>
            <div class="grownups-body">
              <ul class="chips" aria-label={t('skills')}>
                {skills.map(skill => <li>{skill.label}</li>)}
              </ul>
              <p>{summary}</p>
              <p class="meta">
                {minutes}
                {t('minutes')} · {t('ageGroup')}: {story.data.ageGroup}
              </p>
              {
                !narration && (
                  <p class="meta" data-no-voice>
                    {t('noRecordedVoice')}
                  </p>
                )
              }
              {
                prompts.length > 0 && (
                  <>
                    <h2 class="small-heading">{t('talkPrompts')}</h2>
                    <ul>
                      {prompts.map(p => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </>
                )
              }
              <EducatorTools locale={locale} url={storyUrl} hasPack={true} />
              {
                (hasBook || chapters.length > 0) && (
                  <button class="btn" type="button" data-action="class-room" data-js-only>
                    {t('classRoom')}
                  </button>
                )
              }
              {
                hasBook && (
                  <button class="btn" type="button" data-action="record-voice" data-js-only hidden>
                    {t('voiceOpen')}
                  </button>
                )
              }
              <button
                class="btn export-booklet-btn"
                type="button"
                data-story-title={title}
                data-locale={locale}
                data-progress={t('exportingBooklet')}>{t('exportBooklet')}</button
              >
            </div>
          </details>
          <FeedbackLink locale={locale} title={title} band={band} />
          {
            otherLanguages.length > 0 && (
              <nav class="other-languages" aria-label={t('alsoAvailableIn')}>
                <span>{t('alsoAvailableIn')}</span>
                {otherLanguages.map(l => (
                  <a href={l.href} lang={l.locale} hreflang={l.locale}>
                    {endonyms[l.locale]}
                  </a>
                ))}
              </nav>
            )
          }
        </div>
      </div>
    </section>

    {
      hasBook && (
        <section
          class="view book"
          data-view="book"
          hidden
          aria-roledescription="storybook"
          aria-label={title}
        >
          <h1 class="visually-hidden">{title}</h1>
          <div class="topbar" data-topbar>
            <a class="icon-btn" href={home} aria-label={t('home')}>
              <Icon name="home" size={28} />
            </a>
            <div class="topbar-end">
              <button
                class="icon-btn icon-btn--listen"
                type="button"
                data-action="toggle-narration"
                aria-pressed="false"
                aria-label={t('readAloud')}
              >
                <span data-icon="play">
                  <Icon name="play" size={28} />
                </span>
                <span data-icon="pause" hidden>
                  <Icon name="pause" size={28} />
                </span>
              </button>
              <button
                class="icon-btn"
                type="button"
                data-action="lights-out"
                hidden
                aria-label={t('lightsOut')}
              >
                <Icon name="moon" size={28} />
              </button>
              <button
                class="icon-btn"
                type="button"
                data-action="menu"
                aria-expanded="false"
                aria-controls="reader-menu"
                aria-label={t('moreOptions')}
              >
                <Icon name="more" size={28} />
              </button>
            </div>
          </div>

          <div
            class="menu surface"
            id="reader-menu"
            hidden
            role="group"
            aria-label={t('moreOptions')}
          >
            <div class="menu-row">
              <button class="btn" type="button" data-text-step="-1" aria-label={t('textSmaller')}>
                <span class="a-small" aria-hidden="true">
                  A
                </span>
              </button>
              <button class="btn" type="button" data-text-step="1" aria-label={t('textLarger')}>
                <span class="a-large" aria-hidden="true">
                  A
                </span>
              </button>
            </div>
            <label class="menu-check">
              <input type="checkbox" data-pref="spacing" />
              {t('widerSpacing')}
            </label>
            <label class="menu-check">
              <input type="checkbox" data-pref="highlight" />
              {t('highlightWords')}
            </label>
            <label class="menu-check">
              <input type="checkbox" data-pref="autoTurn" />
              {t('autoTurn')}
            </label>
            <label class="menu-select">
              {t('speed')}
              <select data-pref="speed">
                <option value="0.75">0.75×</option>
                <option value="0.9">0.9×</option>
                <option value="1">1×</option>
                <option value="1.15">1.15×</option>
              </select>
            </label>
            <label class="menu-select">
              {t('sleepTimer')}
              <select data-pref="sleep">
                <option value="0">{t('timerOff')}</option>
                {[10, 20, 30].map(n => (
                  <option value={n}>{fmt(t('timerMinutes'), { n })}</option>
                ))}
              </select>
            </label>
            <label class="menu-select" data-pair-only>
              {t('voiceOrder')}
              <select data-pref="voice">
                <option value="both">{t('voiceBoth')}</option>
                <option value="first">{t('voiceFirst')}</option>
                <option value="second">{t('voiceSecond')}</option>
              </select>
            </label>
            <label class="menu-check">
              <input type="checkbox" data-pref="lamp" />
              {t('lampMode')}
            </label>
            {canPair && (
              <button class="btn" type="button" data-action="pair-setup">
                {t('twoLanguages')}
              </button>
            )}
            <button class="btn" type="button" data-action="repeat">
              <Icon name="repeat" size={20} />
              {t('repeatPage')}
            </button>
            <button class="btn" type="button" data-action="to-cover">
              {t('leaveBook')}
            </button>
          </div>

          <div class="pages">
            {pages.map((_, i) => {
              return (
                <section
                  class="page"
                  data-page={i}
                  hidden={i > 0}
                  tabindex="-1"
                  aria-label={fmt(t('pageOf'), { n: i + 1, total: pages.length })}
                >
                  <div class="frame">
                    <StoryArt
                      picture={frameFor(meta, i + 1, locale)}
                      emoji={emoji}
                      palette={palette}
                      eager={i === 0}
                    />
                  </div>
                  <div class="texts">
                    {Object.entries(aligned).map(([loc, locPages]) => {
                      let w = 0;
                      return (
                        <div
                          class="text-block"
                          data-lang-block={loc}
                          lang={loc}
                          dir={isRTL(loc as Locale) ? 'rtl' : 'ltr'}
                          hidden={loc !== locale}
                        >
                          <p class="lang-label">{endonyms[loc as Locale]}</p>
                          <p class="story-text">
                            {locPages[i].sentences.map((sentence, s) => (
                              <>
                                <span class="s" data-s={s}>
                                  {wordsOf(sentence).map(word => (
                                    <>
                                      <span class="w" data-w={w++}>
                                        {word}
                                      </span>{' '}
                                    </>
                                  ))}
                                </span>{' '}
                              </>
                            ))}
                          </p>
                        </div>
                      );
                    })}
                  </div>
                </section>
              );
            })}
          </div>

          <p class="notice notice--problem" data-status role="status" hidden />
          <button class="restart" type="button" data-action="restart" hidden>
            {t('startAgain')}
          </button>

          <div class="pagebar">
            <button class="nav-btn" type="button" data-action="prev" aria-label={t('previousPage')}>
              <Icon name="prev" size={32} />
              <span class="nav-label">{t('backLabel')}</span>
            </button>
            <div
              class="dots"
              role="img"
              data-dots
              aria-label={fmt(t('pageOf'), { n: 1, total: pages.length })}
            >
              {pages.map(() => (
                <span />
              ))}
            </div>
            <button class="nav-btn" type="button" data-action="next" aria-label={t('nextPage')}>
              <span class="nav-label">{t('nextLabel')}</span>
              <Icon name="next" size={32} />
            </button>
          </div>
          <div class="blackout" data-blackout aria-hidden="true">
            <Icon name="moon" size={24} />
          </div>
        </section>
      )
    }

    {
      hasBook && (
        <section class="view end" data-view="end" hidden tabindex="-1" aria-labelledby="end-title">
          <div class="container end-inner">
            <div class="end-art surface">
              <StoryArt picture={cover} emoji={emoji} palette={palette} />
            </div>
            <h2 id="end-title" data-end-title>
              {t('theEnd')}
            </h2>
            <p class="meta" data-lamp-only hidden>
              {story.data.keyMessage}
            </p>
            <div class="end-choices">
              {prompts.length > 0 && (
                <button class="btn btn--lg" type="button" data-action="talk">
                  {t('letsTalk')}
                </button>
              )}
              <button class="btn btn--lg" type="button" data-action="again">
                {t('readAgain')}
              </button>
            </div>
            <a class="quiet-link" href={home}>
              {t('home')}
            </a>
          </div>
        </section>
      )
    }

    {
      hasBook && prompts.length > 0 && (
        <section
          class="view cards"
          data-view="cards"
          hidden
          tabindex="-1"
          aria-labelledby="cards-title"
        >
          <div class="container">
            <h2 id="cards-title" class="visually-hidden">
              {t('letsTalk')}
            </h2>
            {prompts.map((prompt, i) => (
              <article class="card surface" data-card={i} hidden={i > 0}>
                <p class="card-text">{prompt}</p>
                <button class="btn btn--primary" type="button" data-action="next-card">
                  {i < prompts.length - 1 ? t('nextCard') : t('weTalked')}
                </button>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      canPair && (
        <section
          class="view pair"
          data-view="pair"
          hidden
          tabindex="-1"
          aria-labelledby="pair-title"
        >
          <div class="container pair-inner">
            <h2 id="pair-title">{t('twoLanguages')}</h2>
            {(['first', 'second'] as const).map(which => (
              <fieldset class="pair-group">
                <legend>{t(which === 'first' ? 'firstLanguage' : 'secondLanguage')}</legend>
                {allLocales.map(loc => (
                  <label class="pair-choice">
                    <input
                      type="radio"
                      name={`pair-${which}`}
                      value={loc}
                      disabled={!aligned[loc]}
                    />
                    <span lang={loc} dir={isRTL(loc) ? 'rtl' : 'ltr'}>
                      {endonyms[loc]}
                    </span>
                    {!aligned[loc] && <small>{t('notYet')}</small>}
                  </label>
                ))}
              </fieldset>
            ))}
            <div class="end-choices">
              <button class="btn btn--primary btn--lg" type="button" data-action="start-pair">
                {t('startPair')}
              </button>
              <button class="btn btn--lg" type="button" data-action="to-cover">
                {t('backLabel')}
              </button>
            </div>
          </div>
        </section>
      )
    }

    {
      chapters.length > 0 && (
        <section class="view chapters" data-view="chapters" hidden tabindex="-1" aria-label={title}>
          <h1 class="visually-hidden">{title}</h1>
          <header class="chapter-bar">
            <button class="btn" type="button" data-action="chapters-back" aria-label={t('toCover')}>
              <Icon name="prev" size={20} />
            </button>
            <span class="chapter-bar-title">{title}</span>
            <span class="chapter-bar-pos" data-chapter-pos />
            <button class="btn" type="button" data-text-step="-1" aria-label={t('textSmaller')}>
              A−
            </button>
            <button class="btn" type="button" data-text-step="1" aria-label={t('textLarger')}>
              A+
            </button>
            <button class="btn" type="button" data-action="chapters-lamp" aria-pressed="false">
              <>
                <Icon name="moon" size={20} />
                <span class="visually-hidden">{t('lampMode')}</span>
              </>
            </button>
          </header>
          <div class="chapter-progress" aria-hidden="true">
            <div data-chapter-fill />
          </div>
          <div class="container chapter-wrap">
            <div class="chapter-body" data-chapter-body lang={locale} />
            <nav class="chapter-nav" aria-label={t('chaptersHeading')}>
              <button class="btn" type="button" data-action="chapter-prev">
                <>
                  <Icon name="prev" size={20} />
                  <span>{t('previousChapter')}</span>
                </>
              </button>
              <button class="btn btn--primary" type="button" data-action="chapter-next">
                <>
                  <span data-next-label />
                  <Icon name="next" size={20} />
                </>
              </button>
            </nav>
          </div>
        </section>
      )
    }

    {
      (hasBook || chapters.length > 0) && (
        <section
          class="view classroom"
          data-view="classroom"
          hidden
          tabindex="-1"
          aria-label={t('classRoom')}
        >
          <div class="cr-stage" data-stage>
            <div class="cr-frame" data-frame />
            <p class="cr-caption" data-caption hidden />
            <div class="cr-shared" data-shared lang={locale} />
            <div class="cr-black" data-black hidden />
          </div>
          <div
            class="cr-notes"
            data-notes
            hidden
            role="group"
            tabindex="0"
            aria-label={t('classNotes')}
          >
            <p class="cr-notes-text" data-notes-text />
            {prompts.length > 0 && (
              <>
                <h2>{t('talkPrompts')}</h2>
                <ul>
                  {prompts.map(p => (
                    <li>{p}</li>
                  ))}
                </ul>
              </>
            )}
            <div class="cr-next" data-next-frame aria-hidden="true" />
          </div>
          <div class="cr-bar">
            <button class="btn" type="button" data-action="class-exit">
              {t('classExit')}
            </button>
            <button
              class="btn"
              type="button"
              data-action="class-prev"
              aria-label={t('previousPage')}
            >
              <Icon name="prev" size={24} />
            </button>
            <span class="cr-pos" data-pos aria-live="polite" />
            <button class="btn" type="button" data-action="class-next" aria-label={t('nextPage')}>
              <Icon name="next" size={24} />
            </button>
            {hasBook && (
              <button class="btn" type="button" data-action="class-captions">
                {t('classCaptions')}
              </button>
            )}
            {!hasBook && (
              <button class="btn" type="button" data-action="class-mark">
                {t('classMark')}
              </button>
            )}
            <button class="btn" type="button" data-action="class-notes">
              {t('classNotes')}
            </button>
            <button class="btn" type="button" data-action="class-black">
              {t('classBlackout')}
            </button>
          </div>
        </section>
      )
    }

    <PrintSheets
      locale={locale}
      title={title}
      summary={summary}
      skills={skills.map(s => s.label)}
      prompts={prompts}
      url={storyUrl}
      cover={cover}
      frames={colouring}
      emoji={emoji}
      palette={palette}
    />

    <section class="view text" data-view="text" aria-label={t('fullText')}>
      <div class="container">
        {
          chapters.length > 0 && (
            <button class="btn" type="button" data-action="chapters-back" data-js-only>
              {t('toCover')}
            </button>
          )
        }
        <article class="story-content" lang={locale}>
          <Content />
        </article>
        <a class="back-link" href={home}>{t('allStories')}</a>
      </div>
    </section>
  </div>

  {
    hasBook && (
      <dialog class="voice surface" data-voice aria-labelledby="voice-title">
        <h2 id="voice-title">{t('voiceOpen')}</h2>
        <div data-voice-intro>
          <p>{t('voiceIntro')}</p>
          <button class="btn btn--primary" type="button" data-voice-continue>
            {t('voiceContinue')}
          </button>
        </div>
        <div data-voice-main hidden class="voice-main">
          <p class="meta" data-voice-page />
          <p class="voice-text" data-voice-text tabindex="0" />
          <p class="meta" data-voice-state />
          <div class="voice-row">
            <button class="btn btn--primary voice-record" type="button" data-voice-record>
              {t('voiceRecord')}
            </button>
            <button class="btn btn--primary voice-record" type="button" data-voice-stop hidden>
              {t('voiceStop')}
            </button>
            <button class="btn" type="button" data-voice-play hidden>
              {t('voicePlay')}
            </button>
