---
/**
 * Crystal Ball Component - Mystical story revelation
 */
interface Props {
  locale?: string;
}

const { locale = 'de' } = Astro.props;
---

<div class="crystal-ball-container">
  <div class="crystal-ball" id="crystalBall">
    <div class="ball-glow"></div>
    <div class="ball-sphere">
      <div class="mist" id="mist"></div>
      <div class="revelation hidden" id="revelation"></div>
    </div>
    <div class="ball-base"></div>
  </div>

  <button class="gaze-button" id="gazeButton" data-i18n="gazeIntoBall">
    Gaze into the ball
  </button>

  <div class="mystical-voice hidden" id="mysticalVoice">
    <p class="voice-text"></p>
  </div>
</div>

<style>
  .crystal-ball-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 500px;
    padding: 2rem;
  }

  .crystal-ball {
    position: relative;
    width: 300px;
    height: 350px;
    margin-bottom: 3rem;
  }

  .ball-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 320px;
    height: 320px;
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      rgba(138, 43, 226, 0.4) 0%,
      rgba(75, 0, 130, 0.2) 50%,
      transparent 70%
    );
    animation: pulse 2s ease-in-out infinite;
  }

  .ball-sphere {
    position: absolute;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    width: 250px;
    height: 250px;
    border-radius: 50%;
    background: radial-gradient(
      circle at 30% 30%,
      rgba(255, 255, 255, 0.8) 0%,
      rgba(138, 43, 226, 0.6) 30%,
      rgba(75, 0, 130, 0.8) 100%
    );
    box-shadow:
      inset 0 -30px 50px rgba(0, 0, 0, 0.3),
      0 20px 40px rgba(0, 0, 0, 0.4),
      0 0 50px rgba(138, 43, 226, 0.5);
    overflow: hidden;
  }

  .mist {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(
      circle at center,
      transparent 0%,
      rgba(255, 255, 255, 0.3) 50%,
      transparent 100%
    );
    animation: swirl 3s linear infinite;
  }

  .revelation {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 4rem;
    opacity: 0;
    animation: fadeInGlow 2s ease-in forwards;
  }

  .ball-base {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 200px;
    height: 80px;
    background: linear-gradient(
      to bottom,
      #4a148c 0%,
      #6a1b9a 50%,
      #4a148c 100%
    );
    border-radius: 50%;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .ball-base::before {
    content: '';
    position: absolute;
    top: 10px;
    left: 50%;
    transform: translateX(-50%);
    width: 180px;
    height: 15px;
    background: linear-gradient(
      to bottom,
      #7b1fa2,
      #4a148c
    );
    border-radius: 50%;
  }

  .gaze-button {
    padding: 1.25rem 2.5rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: white;
    background: linear-gradient(135deg, #8a2be2 0%, #4b0082 100%);
    border: none;
    border-radius: 50px;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 10px 30px rgba(138, 43, 226, 0.4);
  }

  .gaze-button:hover {
    transform: scale(1.1);
    box-shadow: 0 15px 40px rgba(138, 43, 226, 0.6);
  }

  .gaze-button:active {
    transform: scale(0.95);
  }

  .mystical-voice {
    margin-top: 2rem;
    padding: 2rem;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    border: 2px solid rgba(255, 255, 255, 0.3);
    max-width: 500px;
    animation: fadeIn 1s ease-in;
  }

  .voice-text {
    color: white;
    font-size: 1.25rem;
    font-style: italic;
    text-align: center;
    margin: 0;
    line-height: 1.6;
  }

  .hidden {
    display: none !important;
  }

  /* Animations */
  @keyframes pulse {
    0%, 100% {
      opacity: 0.6;
      transform: translate(-50%, -50%) scale(1);
    }
    50% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1.1);
    }
  }

  @keyframes swirl {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  @keyframes fadeInGlow {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.5);
    }
    100% {
      opacity: 1;
      transform: translate(-50%, -50%) scale(1);
      filter: drop-shadow(0 0 20px rgba(255, 215, 0, 1));
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .crystal-ball {
      width: 250px;
      height: 300px;
    }

    .ball-sphere {
      width: 200px;
      height: 200px;
    }

    .ball-glow {
      width: 270px;
      height: 270px;
    }

    .ball-base {
      width: 160px;
      height: 60px;
    }

    .gaze-button {
      padding: 1rem 2rem;
      font-size: 1.1rem;
    }
  }
</style>

<script>
  const gazeButton = document.getElementById('gazeButton');
  const mist = document.getElementById('mist');
  const revelation = document.getElementById('revelation');
  const mysticalVoice = document.getElementById('mysticalVoice');
  const voiceText = mysticalVoice?.querySelector('.voice-text');

  gazeButton?.addEventListener('click', async () => {
    // Hide button
    gazeButton.style.opacity = '0';
    gazeButton.style.pointerEvents = 'none';

    // Intensify mist animation
    if (mist) {
      mist.style.animation = 'swirl 1s linear infinite';
    }

    // Wait for dramatic effect
    await sleep(2000);

    // Show revelation (emoji or symbol)
    if (revelation) {
      revelation.textContent = '✨';
      revelation.classList.remove('hidden');
    }

    await sleep(1500);

    // Show mystical voice message
    if (mysticalVoice && voiceText) {
      const message = 'The crystal ball reveals your destiny...';
      voiceText.textContent = message;
      mysticalVoice.classList.remove('hidden');

      // Text-to-speech
      if ('speechSynthesis' in window) {
        const utterance = new SpeechSynthesisUtterance(message);
        utterance.rate = 0.8;
        utterance.pitch = 0.8;
        speechSynthesis.speak(utterance);
      }
    }

    // Emit custom event for parent component
    window.dispatchEvent(new CustomEvent('crystalBallRevealed'));
  });

  function sleep(ms: number) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }
</script>
