---
import BaseLayout from '@layouts/BaseLayout.astro';
import StoryTile from '@components/StoryTile.astro';
import { getCatalogue, SHELF_KEY } from '@utils/catalogue';
import { getSkillsByCategory, getSkillsByIds, getSkills } from '@utils/skills-taxonomy';
import { endonyms, fmt, getTranslation, type Locale } from '@utils/i18n';
import { LOCALES } from '@utils/story-availability';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key);
const items = await getCatalogue(locale);
const allSkills = await getSkillsByIds(
  (await getSkills()).map(s => s.id),
  locale
);
const label = new Map(allSkills.map(s => [s.id, s.label]));

const counts = new Map<string, number>();
for (const item of items) for (const id of item.skills) counts.set(id, (counts.get(id) ?? 0) + 1);
// Areas first; ticking one shows its skills, most used first. Only skills with a story here are offered.
const areas = (await getSkillsByCategory(locale))
  .map(g => ({
    ...g,
    skills: g.skills
      .filter(s => counts.has(s.id))
      .sort((a, b) => counts.get(b.id)! - counts.get(a.id)!),
  }))
  .filter(g => g.skills.length > 0);
const areaOf = Object.fromEntries(areas.flatMap(g => g.skills.map(s => [s.id, g.id])));

const bands = [1, 2, 3, 4].filter(b => items.some(i => i.band === b));
// A length is offered only when it adds stories the shorter one does not; one length alone filters nothing.
const reach = [5, 15, 30, Infinity];
const lengths = [
  { id: '5', text: fmt(t('lengthUpTo'), { n: 5 }) },
  { id: '15', text: fmt(t('lengthUpTo'), { n: 15 }) },
  { id: '30', text: fmt(t('lengthUpTo'), { n: 30 }) },
  { id: '30+', text: fmt(t('lengthOver'), { n: 30 }) },
].filter((_, i) => items.some(it => it.minutes > (reach[i - 1] ?? 0) && it.minutes <= reach[i]));
const languages = LOCALES.filter(l => items.some(i => i.languages.includes(l)));
// Length and language are rarely what a grown-up comes for, so they wait behind "More filters".
const hasMore = lengths.length > 1 || languages.length > 1;
const countText = (n: number) => fmt(n === 1 ? t('libraryCountOne') : t('libraryCount'), { n });

const data = items.map(i => ({
  title: i.title,
  text: `${i.summary} ${i.skills.map(id => label.get(id) ?? '').join(' ')}`,
  skills: i.skills,
  languages: i.languages,
  band: i.band,
  minutes: i.minutes,
}));
const strings = {
  count: t('libraryCount'),
  countOne: t('libraryCountOne'),
  more: t('moreFilters'),
  moreWith: t('moreFiltersWithCount'),
  noFit: t('noStoryFits'),
  removeNamed: t('removeFilterNamed'),
  searchWord: t('searchWord'),
  shelfLabel: t('shelfLabel'),
  lengthLabel: t('lengthLabel'),
  skills: t('skills'),
  availableIn: t('availableInLabel'),
  show: t('showStories'),
  showOne: t('showStoriesOne'),
};
---

<BaseLayout title={t('library')} locale={locale}>
  <div class="container library" data-strings={JSON.stringify(strings)}>
    <h1 class="squiggle">{t('library')}</h1>

    <form class="search" role="search" method="get" data-search>
      <label class="visually-hidden" for="q">{t('searchStories')}</label>
      <input id="q" name="q" type="search" autocomplete="off" placeholder={t('searchStories')} />
      <button class="btn btn--primary" type="submit">{t('searchWord')}</button>
    </form>

    <!-- Filters (ux/03 §2): what a story is about comes first, who it is for second, and the rarely used ones wait
         behind "More filters". A choice stays where it was made, and each option shows how many stories it leaves. -->
    <div class="filters" data-filters>
      <fieldset class="topics">
        <legend class="visually-hidden">{t('skills')}</legend>
        <div class="chips row">
          {
            areas.map(a => (
              <label class="chip" data-group={a.id}>
                <input type="checkbox" name="area" value={a.id} />
                <span>
                  {a.label}
                  <small class="n" data-n />
                </span>
              </label>
            ))
          }
        </div>
        <!-- A ticked area opens its skills on the row below, so the two levels never stack into a column. -->
        <div class="chips row sub" data-sub hidden>
          {
            areas.map(a => (
              <div class="sub-group" data-area={a.id} role="group" aria-label={a.label} hidden>
                {a.skills.map(sk => (
                  <label class="chip" data-group={a.id}>
                    <input type="checkbox" name="skill" value={sk.id} />
                    <span>
                      {sk.label}
                      <small class="n" data-n />
                    </span>
                  </label>
                ))}
              </div>
            ))
          }
        </div>
      </fieldset>

      <div class="bar">
        <p class="count" role="status" data-count>{countText(items.length)}</p>
        {
          bands.length > 1 && (
            <fieldset class="shelves">
              <legend class="visually-hidden">{t('shelfLabel')}</legend>
              {bands.map(b => (
                <label class="segment">
                  <input type="checkbox" name="shelf" value={b} />
                  <span>
                    {t(SHELF_KEY[b as 1 | 2 | 3 | 4])}
                    <small class="n" data-n />
                  </span>
                </label>
              ))}
            </fieldset>
          )
        }
        <span class="bar-end">
          {
            hasMore && (
              <button class="btn more" type="button" popovertarget="more-filters" data-more>
                {t('moreFilters')}
              </button>
            )
          }
          <button class="btn" type="button" data-clear hidden>{t('clearFilters')}</button>
        </span>
      </div>

      {
        hasMore && (
          <div id="more-filters" class="more-panel" popover aria-labelledby="more-title">
            <h2 id="more-title">{t('moreFilters')}</h2>
            {lengths.length > 1 && (
              <fieldset>
                <legend>{t('lengthLabel')}</legend>
                <div class="chips">
                  {lengths.map(l => (
                    <label class="chip">
                      <input type="checkbox" name="length" value={l.id} />
                      <span>
                        {l.text}
                        <small class="n" data-n />
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )}
            {languages.length > 1 && (
              <fieldset>
                <legend>{t('availableInLabel')}</legend>
                <div class="chips">
                  {languages.map(l => (
                    <label class="chip">
                      <input type="checkbox" name="lang" value={l} />
                      <span>
                        <span lang={l}>{endonyms[l]}</span>
                        <small class="n" data-n />
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>
            )}
            <button
              class="btn btn--primary show"
              type="button"
              popovertarget="more-filters"
              popovertargetaction="hide"
              data-show
            >
              {fmt(t('showStories'), { n: items.length })}
            </button>
          </div>
        )
      }
    </div>

    <section class="results" aria-labelledby="results-heading">
      <h2 id="results-heading" class="visually-hidden">{t('library')}</h2>
      <ul class="grid-tiles" data-grid>
        {
          items.map((item, i) => (
            <li data-i={i}>
              <StoryTile
                locale={locale}
                slug={item.slug}
                storyId={item.storyId}
                title={item.title}
                meta={item.meta}
                emoji={item.emoji}
                summary={item.summary}
                skillLabels={item.skills.map(id => label.get(id)).filter((x): x is string => !!x)}
                minutes={item.minutes}
                shelf={t(SHELF_KEY[item.band as 1 | 2 | 3 | 4])}
                row
              />
            </li>
          ))
        }
      </ul>

      <div class="empty surface" data-empty hidden>
        <p data-empty-text></p>
        <button class="btn btn--primary" type="button" data-empty-remove hidden></button>
      </div>
    </section>
    <script type="application/json" id="library-data" set:html={JSON.stringify(data)} />
    <script type="application/json" id="library-areas" set:html={JSON.stringify(areaOf)} />
  </div>
</BaseLayout>

<script>
  import {
    LENGTH_BUCKETS,
    countWith,
    matchesFilter,
    mostRestrictiveFilter,
    skillsForAreas,
    type FilterCriteria,
    type FilterKey,
    type LengthBucket,
  } from '@utils/filter-stories';

  const root = document.querySelector<HTMLElement>('.library')!;
  const s = JSON.parse(root.dataset.strings!);
  const data = JSON.parse(document.getElementById('library-data')!.textContent!);
  const areaOf: Record<string, string> = JSON.parse(
    document.getElementById('library-areas')!.textContent!
  );
  const form = root.querySelector<HTMLFormElement>('[data-search]')!;
  const q = form.elements.namedItem('q') as HTMLInputElement;
  const boxes = [
    ...root.querySelectorAll<HTMLInputElement>('[data-filters] input[type="checkbox"]'),
  ];
  const tiles = [...root.querySelectorAll<HTMLElement>('[data-grid] > li')];
  const count = root.querySelector<HTMLElement>('[data-count]')!;
  const clear = root.querySelector<HTMLButtonElement>('[data-clear]')!;
  const more = root.querySelector<HTMLButtonElement>('[data-more]');
  const show = root.querySelector<HTMLButtonElement>('[data-show]');
  const sub = root.querySelector<HTMLElement>('[data-sub]')!;
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  const emptyText = root.querySelector<HTMLElement>('[data-empty-text]')!;
  const emptyRemove = root.querySelector<HTMLButtonElement>('[data-empty-remove]')!;
  const grid = root.querySelector<HTMLElement>('[data-grid]')!;
  const fmt = (text: string, v: Record<string, string | number>) =>
    text.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));

  const names: Record<FilterKey, string> = {
    searchQuery: s.searchWord,
    selectedSkills: s.skills,
    selectedBands: s.shelfLabel,
    selectedLengths: s.lengthLabel,
    selectedLanguages: s.availableIn,
  };
  const keyOf: Record<string, FilterKey> = {
    area: 'selectedSkills',
    skill: 'selectedSkills',
    shelf: 'selectedBands',
    length: 'selectedLengths',
    lang: 'selectedLanguages',
  };

  const values = (name: string) =>
    boxes.filter(b => b.name === name && b.checked).map(b => b.value);
  const read = (): FilterCriteria => ({
    searchQuery: q.value,
    selectedSkills: skillsForAreas(values('area'), values('skill'), areaOf),
    selectedBands: values('shelf').map(Number),
    selectedLengths: values('length') as LengthBucket[],
    selectedLanguages: values('lang'),
  });

  // What one option would choose on its own, for the count beside it.
  const alone = (b: HTMLInputElement) => {
    switch (b.name) {
      case 'area':
        return skillsForAreas([b.value], [], areaOf);
      case 'skill':
        return [b.value];
      case 'shelf':
        return [Number(b.value)];
      default:
        return [b.value];
    }
  };

  // The URL is the state, so a shared link reproduces the view. replaceState keeps Back from stepping through every tick.
  function writeUrl(c: FilterCriteria) {
    const p = new URLSearchParams();
    if (c.searchQuery?.trim()) p.set('q', c.searchQuery.trim());
    if (values('area').length) p.set('area', values('area').join(','));
    if (values('skill').length) p.set('skill', values('skill').join(','));
    if (c.selectedBands?.length) p.set('shelf', c.selectedBands.join(','));
    if (c.selectedLengths?.length) p.set('length', c.selectedLengths.join(','));
    if (c.selectedLanguages?.length) p.set('lang', c.selectedLanguages.join(','));
    const query = p.toString();
    history.replaceState(null, '', location.pathname + (query ? `?${query}` : ''));
  }

  function fromUrl() {
    const p = new URLSearchParams(location.search);
    q.value = p.get('q') ?? '';
    const skills = (p.get('skill') ?? '').split(',');
    const sets: Record<string, string[]> = {
      // A skill from a shared link opens its area, so the ticked chip is visible.
      area: [...(p.get('area') ?? '').split(','), ...skills.map(id => areaOf[id])],
      skill: skills,
      shelf: (p.get('shelf') ?? '').split(','),
      length: (p.get('length') ?? '')
        .split(',')
        .filter(v => (LENGTH_BUCKETS as string[]).includes(v)),
      lang: (p.get('lang') ?? '').split(','),
    };
    for (const b of boxes) b.checked = sets[b.name].includes(b.value);
  }

  // A ticked area opens its skills on the row below; unticking it clears them.
  function syncAreas() {
    for (const group of sub.querySelectorAll<HTMLElement>('[data-area]')) {
      const on = boxes.some(b => b.name === 'area' && b.value === group.dataset.area && b.checked);
      group.hidden = !on;
      if (!on) group.querySelectorAll('input').forEach(b => (b.checked = false));
    }
    sub.hidden = !values('area').length;
  }

  function render() {
    syncAreas();
    const c = read();
    writeUrl(c);
    const shown = data.map((d: never) => matchesFilter(d, c));
    tiles.forEach(li => (li.hidden = !shown[Number(li.dataset.i)]));
    const n = shown.filter(Boolean).length;
    count.textContent = fmt(n === 1 ? s.countOne : s.count, { n });
    grid.hidden = n === 0;
    if (show) show.textContent = n === 1 ? s.showOne : fmt(s.show, { n });

    // Each option: how many stories it would show with everything else as it is. One that would show none is
    // dimmed and cannot be ticked, unless it already is, so it can always be unticked.
    for (const b of boxes) {
      const k = countWith(
        data,
        c,
        keyOf[b.name] as Exclude<FilterKey, 'searchQuery'>,
        alone(b) as never
      );
      b.closest('label')!.querySelector('[data-n]')!.textContent = String(k);
      b.disabled = k === 0 && !b.checked;
    }

    const query = c.searchQuery?.trim() ?? '';
    const set = boxes.filter(b => b.checked);
    clear.hidden = set.length === 0 && !query;
    const hidden = set.filter(b => b.name === 'length' || b.name === 'lang').length;
    if (more) more.textContent = hidden ? fmt(s.moreWith, { n: hidden }) : s.more;

    empty.hidden = n > 0;
    if (n === 0) {
      const key = mostRestrictiveFilter(data, c);
      emptyRemove.hidden = !key;
      emptyText.textContent = s.noFit;
      if (key) {
        emptyRemove.textContent = fmt(s.removeNamed, { name: names[key] });
        emptyRemove.onclick = () => {
          if (key === 'searchQuery') q.value = '';
          else for (const b of boxes) if (keyOf[b.name] === key) b.checked = false;
          render();
        };
      }
    }
  }

  fromUrl();
  render();
  form.addEventListener('submit', e => {
    e.preventDefault();
    render();
  });
  boxes.forEach(b => b.addEventListener('change', render));
  clear.addEventListener('click', () => {
    q.value = '';
    boxes.forEach(b => (b.checked = false));
    render();
  });
  window.addEventListener('popstate', () => {
    fromUrl();
    render();
  });
</script>

<style>
  h1 {
    font-family: var(--font-display);
    font-size: var(--t-display-2);
    line-height: var(--lh-display);
    margin-block-end: var(--s-5);
    --squiggle: var(--lagoon);
  }
  .search {
    display: flex;
    gap: var(--s-3);
    margin-block-end: var(--s-4);
  }
  .search input {
    flex: 1;
    min-inline-size: 0;
    min-block-size: var(--tap-adult);
    padding-inline: var(--s-4);
    border: var(--outline);
    border-radius: var(--r-m);
    background: var(--card);
    color: var(--ink);
    font: inherit;
    box-shadow: var(--e-1);
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-inline-size: 0;
  }
  legend {
    font-weight: 700;
    margin-block-end: var(--s-2);
    padding: 0;
  }

  /* The toolbar above a full-width grid. */
  .filters {
    display: grid;
    gap: var(--s-3);
    margin-block-end: var(--s-5);
  }
  .topics {
    display: grid;
    gap: var(--s-3);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
  }
  /* The skills of the ticked areas: one row, set in from the areas so the two levels read as one tree. */
  .sub {
    padding-inline-start: var(--s-3);
    border-inline-start: 3px solid var(--edge);
  }
  .sub[hidden],
  .sub-group[hidden] {
    display: none;
  }
  .sub-group {
    display: contents;
  }
  .chip,
  .segment {
    position: relative;
    display: inline-flex;
  }
  .chip input,
  .segment input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }
  .chip > span {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: var(--tap-adult);
    padding: var(--s-1) var(--s-4);
    border: 2px solid var(--edge);
    border-radius: var(--r-m);
    background: var(--chip, var(--card));
    color: var(--ink);
    font-size: var(--t-ui-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  .chip[data-group='self'] {
    --chip: var(--plum-tint);
  }
  .chip[data-group='emotions'] {
    --chip: var(--poppy-tint);
  }
  .chip[data-group='thinking'] {
    --chip: var(--sky-tint);
  }
  .chip[data-group='everyday'] {
    --chip: var(--honey-tint);
  }
  .chip[data-group='social'] {
    --chip: var(--lagoon-tint);
  }
  .chip[data-group='responsibility'] {
    --chip: var(--moss-tint);
  }
  /* Selected is an ink outline plus a check (ux/02 Semantic roles), never colour alone. */
  .chip input:checked + span {
    border-color: var(--ink);
    box-shadow:
      inset 0 0 0 1px var(--ink),
      var(--e-1);
    font-weight: 700;
  }
  .chip input:checked + span::before,
  .segment input:checked + span::before {
    content: '✓';
    font-weight: 700;
  }
  /* How many stories an option leaves: quiet, after the label. An option that leaves none is dimmed. */
  .n {
    font-size: 0.85em;
    font-weight: 600;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }
  .n:empty {
    display: none;
  }
  .chip:has(input:disabled) > span,
  .segment:has(input:disabled) > span {
    opacity: 0.45;
  }
  .chip input:disabled,
  .segment input:disabled {
    cursor: not-allowed;
  }
  .chip input:focus-visible + span,
  .search input:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
  }
  .count {
    font-weight: 700;
  }
  .bar-end {
    display: flex;
    gap: var(--s-2);
    margin-inline-start: auto;
  }

  /* Shelf: one outlined control; a picked shelf is filled and ticked. */
  .shelves {
    display: inline-flex;
    border: var(--outline);
    border-radius: var(--r-m);
    background: var(--card);
    box-shadow: var(--e-1);
    overflow: hidden;
  }
  .segment + .segment {
    border-inline-start: 2px solid var(--edge);
  }
  .segment > span {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: calc(var(--tap-adult) - 4px);
    padding-inline: var(--s-4);
    color: var(--ink);
    font-size: var(--t-ui-sm);
    font-weight: 600;
    white-space: nowrap;
  }
  .segment input:checked + span {
    background: var(--honey-tint);
    font-weight: 700;
  }
  .segment input:focus-visible + span {
    outline: 3px solid var(--focus);
    outline-offset: -4px;
  }

  /* More filters: a popover under its button (anchor positioning; centred where that is missing), a bottom sheet
     on phones. Native popover: Escape and a click outside close it without script. */
  .more {
    anchor-name: --more-filters;
  }
  .more-panel {
    inline-size: min(26rem, calc(100vw - 2 * var(--s-4)));
    padding: var(--s-4);
    border: var(--outline);
    border-radius: var(--r-l);
    background: var(--card);
    color: var(--ink);
    box-shadow: var(--e-2);
  }
  @supports (position-area: block-end) {
    .more-panel {
      inset: auto;
      margin: var(--s-2) 0 0;
      position-anchor: --more-filters;
      position-area: block-end span-inline-start;
      position-try-fallbacks: flip-inline;
    }
  }
  .more-panel:popover-open {
    display: grid;
    gap: var(--s-4);
  }
  .more-panel h2 {
    font-size: var(--t-ui);
  }
  .show {
    justify-content: center;
  }
  @media (prefers-reduced-motion: no-preference) {
    .more-panel {
      transition:
        opacity var(--dur-quick) var(--ease-out),
        transform var(--dur-quick) var(--ease-out),
        display var(--dur-quick) allow-discrete,
        overlay var(--dur-quick) allow-discrete;
    }
    .more-panel:not(:popover-open) {
      opacity: 0;
      transform: translateY(-4px);
    }
    @starting-style {
      .more-panel:popover-open {
        opacity: 0;
        transform: translateY(-4px);
      }
    }
  }

  .grid-tiles {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--s-5);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }
  .grid-tiles[hidden],
  .grid-tiles > li[hidden] {
    display: none;
  }
  .empty {
    padding: var(--s-5);
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }

  /* Phones: the area and skill rows scroll sideways and stay one line high, so the stories start on the first
     screen; the shelf control takes its own line and "More filters" is a sheet from the bottom edge. */
  @media (max-width: 599px) {
    .row {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(-1 * var(--gutter));
      padding: 2px var(--gutter) 6px;
      scroll-padding-inline: var(--gutter);
    }
    .sub {
      border-inline-start: 0;
    }
    .shelves {
      order: 1;
      inline-size: 100%;
    }
    .segment {
      flex: 1;
    }
    .segment > span {
      inline-size: 100%;
      justify-content: center;
    }
    .more-panel {
      position-area: none;
      inset: auto 0 0;
      margin: 0;
      inline-size: 100%;
      max-block-size: 85dvh;
      overflow-y: auto;
      border-block-end: 0;
      border-radius: var(--r-l) var(--r-l) 0 0;
    }
    .more-panel::backdrop {
      background: rgb(0 0 0 / 0.4);
