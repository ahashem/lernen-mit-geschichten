---
import BaseLayout from '@layouts/BaseLayout.astro';
import StoryTile from '@components/StoryTile.astro';
import { getCatalogue, SHELF_KEY } from '@utils/catalogue';
import { getSkillsByCategory, getSkillsByIds, getSkills } from '@utils/skills-taxonomy';
import { endonyms, fmt, getTranslation, type Locale } from '@utils/i18n';
import { LOCALES } from '@utils/story-availability';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key);
const items = await getCatalogue(locale);
const allSkills = await getSkillsByIds(
  (await getSkills()).map(s => s.id),
  locale
);
const label = new Map(allSkills.map(s => [s.id, s.label]));

const counts = new Map<string, number>();
for (const item of items) for (const id of item.skills) counts.set(id, (counts.get(id) ?? 0) + 1);
// Areas first; ticking one shows its skills, most used first. Only skills with a story here are offered.
const areas = (await getSkillsByCategory(locale))
  .map(g => ({
    ...g,
    skills: g.skills
      .filter(s => counts.has(s.id))
      .sort((a, b) => counts.get(b.id)! - counts.get(a.id)!),
  }))
  .filter(g => g.skills.length > 0);

const bands = [1, 2, 3, 4].filter(b => items.some(i => i.band === b));
// A length is offered only when it adds stories the shorter one does not; one length alone filters nothing.
const reach = [5, 15, 30, Infinity];
const lengths = [
  { id: '5', text: fmt(t('lengthUpTo'), { n: 5 }) },
  { id: '15', text: fmt(t('lengthUpTo'), { n: 15 }) },
  { id: '30', text: fmt(t('lengthUpTo'), { n: 30 }) },
  { id: '30+', text: fmt(t('lengthOver'), { n: 30 }) },
].filter((_, i) => items.some(it => it.minutes > (reach[i - 1] ?? 0) && it.minutes <= reach[i]));
const languages = LOCALES.filter(l => items.some(i => i.languages.includes(l)));
// Length and language are rarely what a grown-up comes for, so they wait behind "More filters".
const hasMore = lengths.length > 1 || languages.length > 1;
const countText = (n: number) => fmt(n === 1 ? t('libraryCountOne') : t('libraryCount'), { n });
const hasShelves = bands.length > 1;
// The filters read as one sentence, "Stories about {topic} {shelf}", in each language's own word order. Its blanks are
// buttons that open a picker; with a single shelf there is nothing to pick, so that blank is left out.
const sentence = t('filterSentence')
  .split(/(\{topic\}|\{shelf\})/)
  .filter(part => part && (part !== '{shelf}' || hasShelves));

const data = items.map(i => ({
  title: i.title,
  text: `${i.summary} ${i.skills.map(id => label.get(id) ?? '').join(' ')}`,
  skills: i.skills,
  languages: i.languages,
  band: i.band,
  minutes: i.minutes,
}));
const strings = {
  count: t('libraryCount'),
  countOne: t('libraryCountOne'),
  more: t('moreFilters'),
  anyTopic: t('anyTopic'),
  shelfAny: t('shelfAny'),
  shelfOne: t('shelfOne'),
  shelfMany: t('shelfMany'),
  moreWith: t('moreFiltersWithCount'),
  noFit: t('noStoryFits'),
  removeNamed: t('removeFilterNamed'),
  searchWord: t('searchWord'),
  shelfLabel: t('shelfLabel'),
  lengthLabel: t('lengthLabel'),
  skills: t('skills'),
  availableIn: t('availableInLabel'),
  show: t('showStories'),
  showOne: t('showStoriesOne'),
};
---

<BaseLayout title={t('library')} locale={locale}>
  <div class="container library" data-strings={JSON.stringify(strings)}>
    <h1 class="squiggle">{t('library')}</h1>

    <form class="search" role="search" method="get" data-search>
      <label class="visually-hidden" for="q">{t('searchStories')}</label>
      <input id="q" name="q" type="search" autocomplete="off" placeholder={t('searchStories')} />
      <button class="btn btn--primary" type="submit">{t('searchWord')}</button>
    </form>

    <!-- Filters (ux/03 §2) as one sentence: "Stories about [any topic] [on every shelf]". Each blank opens a picker;
         the whole skill taxonomy waits in the topic picker, length and language behind "More filters". Every option
         shows how many stories it would leave, and a card's skill tag filters by that skill ("more like this"). -->
    <div class="filters" data-filters>
      <p class="sentence">
        {
          sentence.map(part =>
            part === '{topic}' ? (
              <button
                class="blank blank--topic"
                type="button"
                popovertarget="pick-topic"
                data-topic
              >
                {t('anyTopic')}
              </button>
            ) : part === '{shelf}' ? (
              <button
                class="blank blank--shelf"
                type="button"
                popovertarget="pick-shelf"
                data-shelf
              >
                {t('shelfAny')}
              </button>
            ) : (
              <span>{part}</span>
            )
          )
        }
      </p>
      <div class="bar">
        {
          hasMore && (
            <button class="btn more" type="button" popovertarget="more-filters" data-more>
              {t('moreFilters')}
            </button>
          )
        }
        <p class="count" role="status" data-count>{countText(items.length)}</p>
        <button class="btn" type="button" data-clear hidden>{t('clearFilters')}</button>
      </div>

      <div id="pick-topic" class="picker picker--topic" popover aria-labelledby="pick-topic-title">
        <h2 id="pick-topic-title">{t('skills')}</h2>
        <div class="areas">
          {
            areas.map(a => (
              <fieldset class="area" data-group={a.id}>
                <legend class="visually-hidden">{a.label}</legend>
                <label class="opt opt--area">
                  <input type="checkbox" name="area" value={a.id} />
                  <span class="opt-label">{a.label}</span>
                  <small class="n" data-n />
                </label>
                <ul class="opts">
                  {a.skills.map(sk => (
                    <li>
                      <label class="opt">
                        <input type="checkbox" name="skill" value={sk.id} data-area={a.id} />
                        <span class="opt-label">{sk.label}</span>
                        <small class="n" data-n />
                      </label>
                    </li>
                  ))}
                </ul>
              </fieldset>
            ))
          }
        </div>
        <button
          class="btn btn--primary show"
          type="button"
          popovertarget="pick-topic"
          popovertargetaction="hide"
          data-show
        >
          {fmt(t('showStories'), { n: items.length })}
        </button>
      </div>

      {
        hasShelves && (
          <div id="pick-shelf" class="picker" popover aria-labelledby="pick-shelf-title">
            <h2 id="pick-shelf-title">{t('shelfLabel')}</h2>
            <div class="opts">
              {bands.map(b => (
                <label class="opt">
                  <input type="checkbox" name="shelf" value={b} />
                  <span class="opt-label">{t(SHELF_KEY[b as 1 | 2 | 3 | 4])}</span>
                  <small class="n" data-n />
                </label>
              ))}
            </div>
            <button
              class="btn btn--primary show"
              type="button"
              popovertarget="pick-shelf"
              popovertargetaction="hide"
              data-show
            >
              {fmt(t('showStories'), { n: items.length })}
            </button>
          </div>
        )
      }

      {
        hasMore && (
          <div id="more-filters" class="picker" popover aria-labelledby="more-title">
            <h2 id="more-title">{t('moreFilters')}</h2>
            {lengths.length > 1 && (
              <fieldset>
                <legend>{t('lengthLabel')}</legend>
                <div class="opts">
                  {lengths.map(l => (
                    <label class="opt">
                      <input type="checkbox" name="length" value={l.id} />
                      <span class="opt-label">{l.text}</span>
                      <small class="n" data-n />
                    </label>
                  ))}
                </div>
              </fieldset>
            )}
            {languages.length > 1 && (
              <fieldset>
                <legend>{t('availableInLabel')}</legend>
                <div class="opts">
                  {languages.map(l => (
                    <label class="opt">
                      <input type="checkbox" name="lang" value={l} />
                      <span class="opt-label" lang={l}>
                        {endonyms[l]}
                      </span>
                      <small class="n" data-n />
                    </label>
                  ))}
                </div>
              </fieldset>
            )}
            <button
              class="btn btn--primary show"
              type="button"
              popovertarget="more-filters"
              popovertargetaction="hide"
              data-show
            >
              {fmt(t('showStories'), { n: items.length })}
            </button>
          </div>
        )
      }
    </div>

    <section class="results" aria-labelledby="results-heading">
      <h2 id="results-heading" class="visually-hidden">{t('library')}</h2>
      <ul class="grid-tiles" data-grid>
        {
          items.map((item, i) => (
            <li data-i={i}>
              <StoryTile
                locale={locale}
                slug={item.slug}
                storyId={item.storyId}
                title={item.title}
                meta={item.meta}
                emoji={item.emoji}
                summary={item.summary}
                skill={
                  item.skills[0] && label.has(item.skills[0])
                    ? { id: item.skills[0], label: label.get(item.skills[0])! }
                    : undefined
                }
                minutes={item.minutes}
                shelf={t(SHELF_KEY[item.band as 1 | 2 | 3 | 4])}
                row
              />
            </li>
          ))
        }
      </ul>

      <div class="empty surface" data-empty hidden>
        <p data-empty-text></p>
        <button class="btn btn--primary" type="button" data-empty-remove hidden></button>
      </div>
    </section>
    <script type="application/json" id="library-data" set:html={JSON.stringify(data)} />
  </div>
</BaseLayout>

<script>
  import {
    LENGTH_BUCKETS,
    countWith,
    matchesFilter,
    mostRestrictiveFilter,
    type FilterCriteria,
    type FilterKey,
    type LengthBucket,
  } from '@utils/filter-stories';

  const root = document.querySelector<HTMLElement>('.library')!;
  const s = JSON.parse(root.dataset.strings!);
  const data = JSON.parse(document.getElementById('library-data')!.textContent!);
  const form = root.querySelector<HTMLFormElement>('[data-search]')!;
  const q = form.elements.namedItem('q') as HTMLInputElement;
  const boxes = [
    ...root.querySelectorAll<HTMLInputElement>('[data-filters] input[type="checkbox"]'),
  ];
  const skillBoxes = boxes.filter(b => b.name === 'skill');
  const areaBoxes = boxes.filter(b => b.name === 'area');
  const tiles = [...root.querySelectorAll<HTMLElement>('[data-grid] > li')];
  const count = root.querySelector<HTMLElement>('[data-count]')!;
  const clear = root.querySelector<HTMLButtonElement>('[data-clear]')!;
  const topic = root.querySelector<HTMLButtonElement>('[data-topic]')!;
  const shelf = root.querySelector<HTMLButtonElement>('[data-shelf]');
  const more = root.querySelector<HTMLButtonElement>('[data-more]');
  const shows = [...root.querySelectorAll<HTMLButtonElement>('[data-show]')];
  const empty = root.querySelector<HTMLElement>('[data-empty]')!;
  const emptyText = root.querySelector<HTMLElement>('[data-empty-text]')!;
  const emptyRemove = root.querySelector<HTMLButtonElement>('[data-empty-remove]')!;
  const grid = root.querySelector<HTMLElement>('[data-grid]')!;
  const fmt = (text: string, v: Record<string, string | number>) =>
    text.replace(/\{(\w+)\}/g, (_, k) => String(v[k] ?? ''));
  const labelOf = (b: HTMLInputElement) =>
    b.closest('label')!.querySelector('.opt-label')!.textContent!.trim();

  const names: Record<FilterKey, string> = {
    searchQuery: s.searchWord,
    selectedSkills: s.skills,
    selectedBands: s.shelfLabel,
    selectedLengths: s.lengthLabel,
    selectedLanguages: s.availableIn,
  };
  const keyOf: Record<string, Exclude<FilterKey, 'searchQuery'>> = {
    area: 'selectedSkills',
    skill: 'selectedSkills',
    shelf: 'selectedBands',
    length: 'selectedLengths',
    lang: 'selectedLanguages',
  };

  // The skills are the state; an area is ticked when all its skills are, and half-ticked when some are.
  const skillsIn = (area: string) => skillBoxes.filter(b => b.dataset.area === area);
  const values = (name: string) =>
    boxes.filter(b => b.name === name && b.checked).map(b => b.value);
  const read = (): FilterCriteria => ({
    searchQuery: q.value,
    selectedSkills: values('skill'),
    selectedBands: values('shelf').map(Number),
    selectedLengths: values('length') as LengthBucket[],
    selectedLanguages: values('lang'),
  });
  // What one option would choose on its own, for the count beside it.
  const alone = (b: HTMLInputElement) =>
    b.name === 'area'
      ? skillsIn(b.value).map(k => k.value)
      : b.name === 'shelf'
        ? [Number(b.value)]
        : [b.value];

  function syncAreas() {
    for (const a of areaBoxes) {
      const on = skillsIn(a.value).filter(b => b.checked).length;
      a.checked = on > 0 && on === skillsIn(a.value).length;
      a.indeterminate = on > 0 && !a.checked;
    }
  }

  // The URL is the state, so a shared link reproduces the view: a whole area as `area`, single skills as `skill`.
  // replaceState keeps Back from stepping through every tick.
  function writeUrl(c: FilterCriteria) {
    const p = new URLSearchParams();
    if (c.searchQuery?.trim()) p.set('q', c.searchQuery.trim());
    const whole = areaBoxes.filter(a => a.checked).map(a => a.value);
    const single = skillBoxes.filter(b => b.checked && !whole.includes(b.dataset.area!));
    if (whole.length) p.set('area', whole.join(','));
    if (single.length) p.set('skill', single.map(b => b.value).join(','));
    if (c.selectedBands?.length) p.set('shelf', c.selectedBands.join(','));
    if (c.selectedLengths?.length) p.set('length', c.selectedLengths.join(','));
    if (c.selectedLanguages?.length) p.set('lang', c.selectedLanguages.join(','));
    const query = p.toString();
    history.replaceState(null, '', location.pathname + (query ? `?${query}` : ''));
  }

  function fromUrl() {
    const p = new URLSearchParams(location.search);
    const list = (key: string) => (p.get(key) ?? '').split(',').filter(Boolean);
    q.value = p.get('q') ?? '';
    const areas = list('area');
    const skills = list('skill');
    const sets: Record<string, string[]> = {
      shelf: list('shelf'),
      length: list('length').filter(v => (LENGTH_BUCKETS as string[]).includes(v)),
      lang: list('lang'),
    };
    for (const b of boxes) {
      if (b.name === 'skill')
        b.checked = skills.includes(b.value) || areas.includes(b.dataset.area!);
      else if (b.name !== 'area') b.checked = sets[b.name].includes(b.value);
    }
  }

  // The topic blank names what is picked: a whole area by its name, otherwise the skill; more than one adds "+n".
  function topicText() {
    const picked: string[] = [];
    for (const a of areaBoxes) {
      if (a.checked) picked.push(labelOf(a));
      else for (const b of skillsIn(a.value)) if (b.checked) picked.push(labelOf(b));
    }
    return picked.length
      ? picked[0] + (picked.length > 1 ? ` +${picked.length - 1}` : '')
      : s.anyTopic;
  }

  function shelfText() {
    const picked = boxes.filter(b => b.name === 'shelf' && b.checked);
    if (!picked.length) return s.shelfAny;
    return picked.length === 1
      ? fmt(s.shelfOne, { shelf: labelOf(picked[0]) })
      : fmt(s.shelfMany, { n: picked.length });
  }

  function render() {
    syncAreas();
    const c = read();
    writeUrl(c);
    const shown = data.map((d: never) => matchesFilter(d, c));
    tiles.forEach(li => (li.hidden = !shown[Number(li.dataset.i)]));
    const n = shown.filter(Boolean).length;
    count.textContent = fmt(n === 1 ? s.countOne : s.count, { n });
    grid.hidden = n === 0;
    for (const b of shows) b.textContent = n === 1 ? s.showOne : fmt(s.show, { n });

    // Each option: how many stories it would show with everything else as it is. One that would show none is
    // dimmed and cannot be ticked, unless it already is (or holds a ticked skill), so it can always be unticked.
    for (const b of boxes) {
      const k = countWith(data, c, keyOf[b.name], alone(b) as never);
      b.closest('label')!.querySelector('[data-n]')!.textContent = String(k);
      b.disabled = k === 0 && !b.checked && !b.indeterminate;
    }

    topic.textContent = topicText();
    topic.toggleAttribute('data-set', values('skill').length > 0);
    if (shelf) {
      shelf.textContent = shelfText();
      shelf.toggleAttribute('data-set', values('shelf').length > 0);
    }
    const hidden = values('length').length + values('lang').length;
    if (more) more.textContent = hidden ? fmt(s.moreWith, { n: hidden }) : s.more;
    clear.hidden = !boxes.some(b => b.checked) && !c.searchQuery?.trim();

    empty.hidden = n > 0;
    if (n === 0) {
      const key = mostRestrictiveFilter(data, c);
      emptyRemove.hidden = !key;
      emptyText.textContent = s.noFit;
      if (key) {
        emptyRemove.textContent = fmt(s.removeNamed, { name: names[key] });
        emptyRemove.onclick = () => {
          if (key === 'searchQuery') q.value = '';
          else for (const b of boxes) if (keyOf[b.name] === key) b.checked = false;
          render();
        };
      }
    }
  }

  fromUrl();
  render();
  form.addEventListener('submit', e => {
    e.preventDefault();
    render();
  });
  // Ticking an area ticks or clears all its skills; every other box is its own choice.
  for (const a of areaBoxes)
    a.addEventListener('change', () => {
      skillsIn(a.value).forEach(b => (b.checked = a.checked));
      render();
    });
  for (const b of boxes) if (b.name !== 'area') b.addEventListener('change', render);
  // A card's skill tag: "more like this". The topic becomes that skill; the other filters stay.
  root.addEventListener('click', e => {
    const tag = (e.target as Element).closest<HTMLAnchorElement>('a.tile-skill');
    if (!tag || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    e.preventDefault();
    skillBoxes.forEach(b => (b.checked = b.value === tag.dataset.skill));
    render();
    root.querySelector('[data-filters]')!.scrollIntoView({ block: 'nearest' });
    topic.focus({ preventScroll: true });
  });
  clear.addEventListener('click', () => {
    q.value = '';
    boxes.forEach(b => (b.checked = false));
    render();
  });
  window.addEventListener('popstate', () => {
    fromUrl();
    render();
  });
</script>

<style>
  h1 {
    font-family: var(--font-display);
    font-size: var(--t-display-2);
    line-height: var(--lh-display);
    margin-block-end: var(--s-5);
    --squiggle: var(--lagoon);
  }
  .search {
    display: flex;
    gap: var(--s-3);
    margin-block-end: var(--s-4);
  }
  .search input {
    flex: 1;
    min-inline-size: 0;
    min-block-size: var(--tap-adult);
    padding-inline: var(--s-4);
    border: var(--outline);
    border-radius: var(--r-m);
    background: var(--card);
    color: var(--ink);
    font: inherit;
    box-shadow: var(--e-1);
  }
  .search input:focus-visible {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
  /* The narrowest phones give the field the room the gaps took, and a hint that still does not fit ends in "…". */
  .search input {
    text-overflow: ellipsis;
  }
  @media (max-width: 379px) {
    .search {
      gap: var(--s-2);
    }
    .search input,
    .search .btn {
      padding-inline: var(--s-3);
    }
  }
  fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-inline-size: 0;
  }
  legend {
    font-weight: 700;
    margin-block-end: var(--s-2);
    padding: 0;
  }

  /* One line of filters: the sentence, then "More filters", the count and "Clear". */
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-4);
    margin-block-end: var(--s-5);
  }
  .sentence {
    flex: 1 1 26rem;
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.9;
  }
  /* A blank is a fill-in line under the words; once something is picked it is filled in honey. */
  .blank {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    min-block-size: var(--tap-adult);
    margin-inline: 0.1em;
    padding: 0 0.35em;
    border: 0;
    border-block-end: 3px solid var(--edge);
    border-radius: var(--r-s) var(--r-s) 0 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    vertical-align: baseline;
    cursor: pointer;
    transition: background-color var(--dur-quick) var(--ease-out);
  }
  .blank::after {
    content: '▾';
    font-size: 0.7em;
    color: var(--ink-2);
  }
  .blank:hover {
    background: var(--paper-2);
  }
  .blank[data-set] {
    background: var(--honey-tint);
    border-block-end-color: var(--ink);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin-inline-start: auto;
  }
  .count {
    font-weight: 700;
  }

  /* Pickers: native popovers under their blank (anchor positioning; centred where that is missing) and sheets from
     the bottom edge on phones. Escape and a click outside close them without script. */
  .blank--topic {
    anchor-name: --pick-topic;
  }
  .blank--shelf {
    anchor-name: --pick-shelf;
  }
  .more {
    anchor-name: --more-filters;
  }
  .picker {
    inline-size: min(22rem, calc(100vw - 2 * var(--s-4)));
    max-block-size: calc(100dvh - 6rem);
    overflow-y: auto;
    padding: var(--s-4);
    border: var(--outline);
    border-radius: var(--r-l);
    background: var(--card);
    color: var(--ink);
    box-shadow: var(--e-2);
  }
  .picker--topic {
    inline-size: min(46rem, calc(100vw - 2 * var(--s-4)));
  }
  @supports (position-area: block-end) {
    .picker {
      inset: auto;
      margin: var(--s-2) 0 0;
      position-area: block-end span-inline-end;
      position-try-fallbacks: flip-inline;
    }
    #pick-topic {
      position-anchor: --pick-topic;
    }
    #pick-shelf {
      position-anchor: --pick-shelf;
    }
    #more-filters {
      position-anchor: --more-filters;
      position-area: block-end span-inline-start;
    }
  }
  .picker:popover-open {
    display: grid;
    gap: var(--s-4);
  }
  .picker h2 {
    font-size: var(--t-ui);
  }
  .show {
    justify-content: center;
  }

  /* The topic picker: each area with its skills under it, in two columns where there is room. */
  .areas {
    columns: 2 18rem;
    column-gap: var(--s-5);
  }
  .area {
    break-inside: avoid;
    margin-block-end: var(--s-3);
  }
  .area[data-group='self'] {
    --chip: var(--plum-tint);
  }
  .area[data-group='emotions'] {
    --chip: var(--poppy-tint);
  }
