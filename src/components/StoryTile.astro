---
import StoryArt from '@components/reader/StoryArt.astro';
import { coverOf, paletteFor } from '@utils/story-art';
import { getTranslation, type Locale } from '@utils/i18n';
import type { StoryMeta } from '@utils/stories';
import { BASE_PATH } from '@utils/site';

interface Props {
  locale: Locale;
  slug: string;
  storyId: string;
  title: string;
  meta?: StoryMeta;
  emoji?: string;
  /** One line under the title; omitted on the home shelves. */
  summary?: string;
  /** The first is the story's main skill; only it is shown. */
  skillLabels?: string[];
  minutes?: number;
  /** The shelf name, e.g. "Chapter stories". */
  shelf?: string;
  /** Phones: cover beside the text instead of above it, so a list of stories stays short. */
  row?: boolean;
}

const { locale, slug, storyId, title, meta, emoji, summary, skillLabels, minutes, shelf, row } =
  Astro.props;
const t = (key: Parameters<typeof getTranslation>[1]) => getTranslation(locale, key);
const href =
  locale === 'de' ? `${BASE_PATH}/stories/${slug}` : `${BASE_PATH}/${locale}/stories/${slug}`;
---

<article class:list={['tile', { 'tile--row': row }]}>
  <a class="tile-cover" href={href} tabindex="-1" aria-hidden="true">
    <StoryArt
      picture={coverOf(meta, locale)}
      emoji={emoji ?? meta?.emoji ?? '📖'}
      palette={paletteFor(storyId, meta)}
    />
  </a>
  <div class="tile-body">
    <h3 class="tile-title"><a href={href}>{title}</a></h3>
    {summary && <p class="tile-summary">{summary}</p>}
    <p class="tile-meta">
      {shelf && <span>{shelf}</span>}
      {
        minutes && (
          <span>
            {minutes} {t('minutes')}
          </span>
        )
      }
      {skillLabels && skillLabels.length > 0 && <span>{skillLabels[0]}</span>}
    </p>
  </div>
</article>

<style>
  .tile {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: var(--outline);
    border-radius: var(--r-l);
    box-shadow: var(--e-1);
    overflow: hidden;
    container-type: inline-size;
    transition:
      transform var(--dur-base) var(--ease-settle),
      box-shadow var(--dur-base) var(--ease-out);
  }
  /* The card lifts and tips a little, like picking a book off the pile; it lands when pressed. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tile:hover {
      transform: translateY(-3px) rotate(calc(-1deg * var(--shadow-x)));
      box-shadow: var(--e-2);
    }
  }
  .tile:active {
    transform: translate(calc(2px * var(--shadow-x)), 3px);
    box-shadow: var(--e-press);
  }
  .tile-cover {
    display: block;
    aspect-ratio: 4 / 3;
    background: var(--paper-2);
    border-block-end: var(--outline);
    text-decoration: none;
  }
  .tile-body {
    padding: var(--s-4);
    display: grid;
    gap: var(--s-2);
  }
  .tile-title {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: var(--t-ui);
    line-height: var(--lh-display);
  }
  /* The whole card is the target, but only the title is a link for assistive technology. */
  .tile-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .tile-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .tile {
    position: relative;
  }
  .tile-summary {
    font-size: var(--t-ui-sm);
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tile-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-3);
    font-size: var(--t-ui-sm);
    color: var(--ink-2);
  }
  @media (max-width: 599px) {
    .tile--row {
      flex-direction: row;
    }
    .tile--row .tile-cover {
      border-block-end: 0;
      border-inline-end: var(--outline);
      flex: 0 0 7rem;
      aspect-ratio: auto;
      min-block-size: 7rem;
    }
    .tile--row .tile-body {
      padding: var(--s-3);
      align-content: center;
    }
  }
  .tile:focus-within {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }
</style>
