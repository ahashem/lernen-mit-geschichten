---
/**
 * Streak Tracker Component
 * Displays visit streak with visual calendar and milestone rewards
 */
import type { Locale } from '../utils/i18n';

interface Props {
  locale?: Locale;
  compact?: boolean;
}

const { locale = 'de', compact = false } = Astro.props;
---

<div class="streak-tracker" data-locale={locale} data-compact={compact}>
  <div class="streak-header">
    <div class="streak-flame-display">
      <div class="flame-container">
        <div class="flame-icon">🔥</div>
        <div class="streak-count">
          <span class="count-number" id="streak-count">0</span>
          <span class="count-label" data-i18n="days">Tage</span>
        </div>
      </div>
    </div>
    <div class="streak-stats">
      <div class="stat-item">
        <span class="stat-label" data-i18n="currentStreak">Aktuelle Serie</span>
        <span class="stat-value" id="current-streak">0</span>
      </div>
      <div class="stat-item">
        <span class="stat-label" data-i18n="longestStreak">Längste Serie</span>
        <span class="stat-value" id="longest-streak">0</span>
      </div>
    </div>
  </div>

  {!compact && (
    <>
      <div class="streak-calendar" id="streak-calendar">
        <h3 data-i18n="visitHistory">Besuchsverlauf</h3>
        <div class="calendar-grid" id="calendar-grid">
          <!-- Generated by script -->
        </div>
        <div class="calendar-legend">
          <div class="legend-item">
            <div class="legend-box visited"></div>
            <span data-i18n="visited">Besucht</span>
          </div>
          <div class="legend-item">
            <div class="legend-box missed"></div>
            <span data-i18n="missed">Verpasst</span>
          </div>
        </div>
      </div>

      <div class="streak-milestones" id="streak-milestones">
        <h3 data-i18n="milestones">Meilensteine</h3>
        <div class="milestones-grid">
          <div class="milestone-card" data-days="3">
            <div class="milestone-icon">🌟</div>
            <div class="milestone-info">
              <span class="milestone-days">3 Tage</span>
              <span class="milestone-reward">50 Sterne</span>
            </div>
            <div class="milestone-status locked">🔒</div>
          </div>
          <div class="milestone-card" data-days="7">
            <div class="milestone-icon">⭐</div>
            <div class="milestone-info">
              <span class="milestone-days">7 Tage</span>
              <span class="milestone-reward">100 Sterne + Kartenpaket</span>
            </div>
            <div class="milestone-status locked">🔒</div>
          </div>
          <div class="milestone-card" data-days="14">
            <div class="milestone-icon">🎁</div>
            <div class="milestone-info">
              <span class="milestone-days">14 Tage</span>
              <span class="milestone-reward">200 Sterne + Haustier</span>
            </div>
            <div class="milestone-status locked">🔒</div>
          </div>
          <div class="milestone-card" data-days="30">
            <div class="milestone-icon">🏆</div>
            <div class="milestone-info">
              <span class="milestone-days">30 Tage</span>
              <span class="milestone-reward">500 Sterne + Legendäre Karte</span>
            </div>
            <div class="milestone-status locked">🔒</div>
          </div>
          <div class="milestone-card" data-days="100">
            <div class="milestone-icon">👑</div>
            <div class="milestone-info">
              <span class="milestone-days">100 Tage</span>
              <span class="milestone-reward">1000 Sterne + Super-Fan</span>
            </div>
            <div class="milestone-status locked">🔒</div>
          </div>
        </div>
      </div>

      <div class="streak-warning" id="streak-warning" style="display: none;">
        <div class="warning-icon">⚠️</div>
        <div class="warning-message">
          <p data-i18n="streakWarning">Deine Serie läuft heute ab!</p>
          <p data-i18n="dontForget">Vergiss nicht vorbeizuschauen!</p>
        </div>
      </div>
    </>
  )}
</div>

<style>
  .streak-tracker {
    background: linear-gradient(135deg, #FF6B35 0%, #FF9F40 100%);
    border-radius: 20px;
    padding: 2rem;
    color: white;
    box-shadow: 0 8px 24px rgba(255, 107, 53, 0.3);
  }

  .streak-tracker[data-compact="true"] {
    padding: 1.5rem;
  }

  .streak-header {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .streak-flame-display {
    flex-shrink: 0;
  }

  .flame-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .flame-icon {
    font-size: 5rem;
    animation: flame-flicker 2s ease-in-out infinite;
    filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
  }

  @keyframes flame-flicker {
    0%, 100% {
      transform: scale(1) rotate(-2deg);
      filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
    }
    50% {
      transform: scale(1.05) rotate(2deg);
      filter: drop-shadow(0 6px 12px rgba(0, 0, 0, 0.3));
    }
  }

  .streak-count {
    text-align: center;
  }

  .count-number {
    display: block;
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
  }

  .count-label {
    display: block;
    font-size: 0.875rem;
    opacity: 0.9;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .streak-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    flex-grow: 1;
  }

  .stat-item {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    padding: 1rem;
    text-align: center;
  }

  .stat-label {
    display: block;
    font-size: 0.75rem;
    opacity: 0.9;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
  }

  .stat-value {
    display: block;
    font-size: 2rem;
    font-weight: 700;
  }

  .streak-calendar {
    margin-bottom: 2rem;
  }

  .streak-calendar h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem;
    font-weight: 700;
  }

  .calendar-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .calendar-day {
    aspect-ratio: 1;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 600;
    transition: all 0.3s ease;
    position: relative;
  }

  .calendar-day.visited {
    background: rgba(76, 175, 80, 0.4);
    box-shadow: 0 0 10px rgba(76, 175, 80, 0.5);
  }

  .calendar-day.visited::after {
    content: '✓';
    position: absolute;
    top: 2px;
    right: 2px;
    font-size: 0.875rem;
  }

  .calendar-day.missed {
    background: rgba(158, 158, 158, 0.3);
    opacity: 0.5;
  }

  .calendar-day.today {
    border: 2px solid white;
    box-shadow: 0 0 15px rgba(255, 255, 255, 0.6);
  }

  .calendar-legend {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    margin-top: 1rem;
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  .legend-box {
    width: 20px;
    height: 20px;
    border-radius: 4px;
  }

  .legend-box.visited {
    background: rgba(76, 175, 80, 0.4);
  }

  .legend-box.missed {
    background: rgba(158, 158, 158, 0.3);
  }

  .streak-milestones {
    margin-bottom: 2rem;
  }

  .streak-milestones h3 {
    font-size: 1.25rem;
    margin: 0 0 1rem;
    font-weight: 700;
  }

  .milestones-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .milestone-card {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: all 0.3s ease;
  }

  .milestone-card.unlocked {
    background: rgba(76, 175, 80, 0.3);
    box-shadow: 0 0 20px rgba(76, 175, 80, 0.5);
  }

  .milestone-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
  }

  .milestone-info {
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .milestone-days {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .milestone-reward {
    font-size: 0.875rem;
    opacity: 0.9;
  }

  .milestone-status {
    font-size: 2rem;
    flex-shrink: 0;
  }

  .milestone-status.locked {
    opacity: 0.3;
  }

  .milestone-status.unlocked {
    animation: unlock-bounce 0.6s ease;
  }

  @keyframes unlock-bounce {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.3); }
  }

  .streak-warning {
    background: rgba(255, 193, 7, 0.3);
    border: 2px solid rgba(255, 193, 7, 0.6);
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    animation: warning-pulse 2s ease-in-out infinite;
  }

  @keyframes warning-pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(255, 193, 7, 0.7);
    }
    50% {
      box-shadow: 0 0 0 10px rgba(255, 193, 7, 0);
    }
  }

  .warning-icon {
    font-size: 2.5rem;
    flex-shrink: 0;
  }

  .warning-message p {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .streak-tracker {
      padding: 1.5rem;
    }

    .streak-header {
      flex-direction: column;
      gap: 1.5rem;
    }

    .flame-icon {
      font-size: 3.5rem;
    }

    .count-number {
      font-size: 2rem;
    }

    .streak-stats {
      width: 100%;
    }

    .stat-value {
      font-size: 1.5rem;
    }

    .calendar-grid {
      gap: 0.25rem;
    }

    .calendar-day {
      font-size: 0.625rem;
    }

    .milestone-icon {
      font-size: 2rem;
    }

    .milestone-days {
      font-size: 1rem;
    }

    .milestone-reward {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  import { dailySurpriseManager } from '../utils/daily-surprise';

  function initStreakTracker() {
    const streak = dailySurpriseManager.getStreak();

    // Update streak display
    updateStreakDisplay(streak);

    // Generate calendar
    generateCalendar();

    // Update milestones
    updateMilestones(streak);

    // Check for streak warning
    checkStreakWarning(streak);

    // Listen for streak updates
    window.addEventListener('streak-updated', (e: any) => {
      updateStreakDisplay(e.detail);
      updateMilestones(e.detail);
    });
  }

  function updateStreakDisplay(streak: any) {
    const countEl = document.getElementById('streak-count');
    const currentEl = document.getElementById('current-streak');
    const longestEl = document.getElementById('longest-streak');

    if (countEl) countEl.textContent = streak.currentStreak.toString();
    if (currentEl) currentEl.textContent = streak.currentStreak.toString();
    if (longestEl) longestEl.textContent = streak.longestStreak.toString();
  }

  function generateCalendar() {
    const calendarGrid = document.getElementById('calendar-grid');
    if (!calendarGrid) return;

    const calendar = dailySurpriseManager.getCalendar();
    const today = new Date().toISOString().split('T')[0];

    calendarGrid.innerHTML = '';

    calendar.forEach((day) => {
      const dayEl = document.createElement('div');
      dayEl.className = 'calendar-day';

      if (day.visited) {
        dayEl.classList.add('visited');
      } else {
        dayEl.classList.add('missed');
      }

      if (day.date === today) {
        dayEl.classList.add('today');
      }

      const dateNum = new Date(day.date).getDate();
      dayEl.textContent = dateNum.toString();

      calendarGrid.appendChild(dayEl);
    });
  }

  function updateMilestones(streak: any) {
    const milestoneCards = document.querySelectorAll('.milestone-card');

    milestoneCards.forEach((card) => {
      const days = parseInt((card as HTMLElement).dataset.days || '0');
      const statusEl = card.querySelector('.milestone-status');

      if (statusEl && streak.milestones.includes(days)) {
        card.classList.add('unlocked');
        statusEl.classList.remove('locked');
        statusEl.classList.add('unlocked');
        statusEl.textContent = '✓';
      }
    });
  }

  function checkStreakWarning(streak: any) {
    const warningEl = document.getElementById('streak-warning');
    if (!warningEl) return;

    const today = new Date().toISOString().split('T')[0];
    const lastVisit = streak.lastVisit;

    if (lastVisit) {
      const daysDiff = daysBetween(lastVisit, today);

      // Show warning if visited yesterday but not today yet
      if (daysDiff === 1 && streak.currentStreak > 0) {
        warningEl.style.display = 'flex';
      }
    }
  }

  function daysBetween(date1: string, date2: string): number {
    const d1 = new Date(date1);
    const d2 = new Date(date2);
    const diff = Math.abs(d2.getTime() - d1.getTime());
    return Math.floor(diff / (1000 * 60 * 60 * 24));
  }

  // Initialize on page load
  if (typeof window !== 'undefined') {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStreakTracker);
    } else {
      initStreakTracker();
    }
  }
</script>
