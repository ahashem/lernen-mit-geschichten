---
import BaseLayout from '../layouts/BaseLayout.astro';
import MazeGame from '../components/MazeGame.astro';
import { getCollection } from 'astro:content';
import { getTranslation } from '@utils/i18n';

const locale = 'de';

// Get story ID from query params (will be handled client-side)
const storyId = Astro.url.searchParams.get('story') || '001-bruno';
const difficulty = (Astro.url.searchParams.get('difficulty') || 'medium') as
  | 'easy'
  | 'medium'
  | 'hard'
  | 'expert';

// Get story data
const allStories = await getCollection('stories');
const story = allStories.find((s) => s.data.storyId === storyId);

if (!story) {
  return Astro.redirect('/story-mazes');
}

const title = `${story.data.title} - ${getTranslation(locale, 'mazeGame')}`;
const description = `Erkunde das Labyrinth für die Geschichte "${story.data.title}"`;

// Determine theme based on story or character
const themeMap: Record<string, any> = {
  forest: ['bear', 'fox', 'owl', 'rabbit', 'deer'],
  city: ['dog', 'cat', 'mouse'],
  beach: ['dolphin', 'turtle', 'crab'],
  space: ['alien', 'robot', 'astronaut'],
  underwater: ['fish', 'octopus', 'whale'],
  mountain: ['goat', 'eagle', 'yak'],
};

let selectedTheme: any = 'forest'; // default
for (const [theme, characters] of Object.entries(themeMap)) {
  if (
    story.data.characterType &&
    characters.includes(story.data.characterType)
  ) {
    selectedTheme = theme;
    break;
  }
}
---

<BaseLayout title={title} description={description} locale={locale}>
  <div class="maze-game-page">
    <!-- Story Context Banner -->
    <div class="story-banner">
      <div class="banner-content">
        <a href="/story-mazes" class="back-btn">
          <span>←</span>
          <span data-i18n="backToMazes">Zurück zu Labyrinthen</span>
        </a>
        <div class="story-info">
          <span class="story-emoji-large">{story.data.emoji}</span>
          <div class="story-details">
            <h1 class="story-title">{story.data.title}</h1>
            <p class="story-description">
              <span data-i18n="basedOnStory">Basierend auf der Geschichte</span>
              • <span>{difficulty}</span>
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Maze Game Component -->
    <MazeGame
      storyId={story.data.storyId}
      storyTitle={story.data.title}
      characterEmoji={story.data.emoji}
      locale={locale}
      difficulty={difficulty}
      theme={selectedTheme}
    />

    <!-- Story Tips -->
    <div class="story-tips">
      <div class="tips-container">
        <h2>
          <span>💡</span>
          <span data-i18n="mazeT ips">Labyrinth-Tipps</span>
        </h2>
        <div class="tips-grid">
          <div class="tip-card">
            <div class="tip-icon">🗺️</div>
            <h3 data-i18n="exploreCarefully">Erkunde sorgfältig</h3>
            <p>
              Nimm dir Zeit, das Labyrinth zu erkunden. Sammelobjekte sind
              überall versteckt!
            </p>
          </div>
          <div class="tip-card">
            <div class="tip-icon">💡</div>
            <h3 data-i18n="useHints">Nutze Hinweise</h3>
            <p>
              Wenn du feststeckst, nutze den Hinweis-Button. Er zeigt dir den
              Weg zum Ziel!
            </p>
          </div>
          <div class="tip-card">
            <div class="tip-icon">⭐</div>
            <h3 data-i18n="collectAll">Sammle alles</h3>
            <p>
              Sammle alle Sterne und Gegenstände für mehr Belohnungen und
              bessere Bewertungen!
            </p>
          </div>
          <div class="tip-card">
            <div class="tip-icon">🔑</div>
            <h3 data-i18n="findKeys">Finde Schlüssel</h3>
            <p>
              Einige Türen sind verschlossen. Finde die Schlüssel, um
              weiterzukommen!
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Stories -->
    {
      story.data.skills && story.data.skills.length > 0 && (
        <div class="related-stories">
          <div class="related-container">
            <h2>
              <span>📚</span>
              <span data-i18n="relatedStories">Ähnliche Geschichten</span>
            </h2>
            <p class="related-description">
              Mehr Geschichten mit ähnlichen Fähigkeiten
            </p>
            <div class="related-grid">
              {allStories
                .filter(
                  (s) =>
                    s.data.storyId !== story.data.storyId &&
                    s.data.skills.some((skill: string) =>
                      story.data.skills.includes(skill)
                    )
                )
                .slice(0, 3)
                .map((relatedStory) => (
                  <a
                    href={`/maze-game?story=${relatedStory.data.storyId}&difficulty=${difficulty}`}
                    class="related-card"
                  >
                    <div class="related-emoji">
                      {relatedStory.data.emoji}
                    </div>
                    <h3>{relatedStory.data.title}</h3>
                    <p class="play-label">
                      <span data-i18n="playMaze">Spielen</span>
                      <span>▶</span>
                    </p>
                  </a>
                ))}
            </div>
          </div>
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .maze-game-page {
    min-height: 100vh;
    background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
  }

  /* Story Banner */
  .story-banner {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-bottom: 2px solid rgba(255, 255, 255, 0.2);
    padding: 1rem 0;
  }

  .banner-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .back-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: rgba(255, 255, 255, 0.2);
    color: white;
    text-decoration: none;
    border-radius: 20px;
    font-weight: 500;
    transition: all 0.3s ease;
    align-self: flex-start;
  }

  .back-btn:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateX(-5px);
  }

  .story-info {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    color: white;
  }

  .story-emoji-large {
    font-size: 4rem;
    animation: float 3s ease-in-out infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-10px);
    }
  }

  .story-title {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }

  .story-description {
    font-size: 1.1rem;
    opacity: 0.9;
  }

  /* Story Tips */
  .story-tips {
    padding: 3rem 0;
  }

  .tips-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    color: white;
  }

  .tips-container h2 {
    font-size: 2rem;
    margin-bottom: 2rem;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .tips-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .tip-card {
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(10px);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 15px;
    padding: 1.5rem;
    text-align: center;
    transition: all 0.3s ease;
  }

  .tip-card:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-5px);
  }

  .tip-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .tip-card h3 {
    font-size: 1.2rem;
    margin-bottom: 0.5rem;
  }

  .tip-card p {
    font-size: 0.95rem;
    opacity: 0.9;
    line-height: 1.5;
  }

  /* Related Stories */
  .related-stories {
    padding: 3rem 0;
    background: rgba(0, 0, 0, 0.2);
  }

  .related-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    color: white;
  }

  .related-container h2 {
    font-size: 2rem;
    margin-bottom: 0.5rem;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .related-description {
    text-align: center;
    font-size: 1.1rem;
    opacity: 0.9;
    margin-bottom: 2rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .related-card {
    background: white;
    border-radius: 15px;
    padding: 2rem;
    text-align: center;
    text-decoration: none;
    color: #333;
    transition: all 0.3s ease;
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2);
  }

  .related-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
  }

  .related-emoji {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .related-card h3 {
    font-size: 1.3rem;
    margin-bottom: 1rem;
  }

  .play-label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: #667eea;
    font-weight: bold;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .story-info {
      flex-direction: column;
      text-align: center;
    }

    .story-title {
      font-size: 1.5rem;
    }

    .tips-grid,
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
