---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getTranslation } from '@utils/i18n';

const locale = 'de';
const title = getTranslation(locale, 'viewStory');
const description = 'Deine selbst erstellte Geschichte';
import { BASE_PATH as base } from '@utils/site';
---

<BaseLayout title={title} description={description} locale={locale}>
  <div class="story-viewer-page">
    <div class="container">
      <!-- Story Display -->
      <div id="story-display" class="story-display">
        <!-- Populated by JavaScript -->
      </div>

      <!-- Loading State -->
      <div id="loading-state" class="loading-state">
        <div class="spinner"></div>
        <p>Lädt Geschichte...</p>
      </div>

      <!-- Error State -->
      <div id="error-state" class="error-state" style="display: none;">
        <div class="error-icon">😕</div>
        <h2>Geschichte nicht gefunden</h2>
        <p>Diese Geschichte existiert nicht oder konnte nicht geladen werden.</p>
        <a href={`${base}/my-stories`} class="btn-back">Zurück zu Meine Geschichten</a>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .story-viewer-page {
    min-height: 80vh;
    padding: 2rem 0;
    background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
  }

  .story-display {
    background: white;
    border-radius: 24px;
    padding: 3rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    max-width: 900px;
    margin: 0 auto;
    animation: fadeIn 0.6s ease;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .story-header {
    text-align: center;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 3px solid #f0f0f0;
  }

  .story-hero-emoji {
    font-size: 6rem;
    margin-bottom: 1rem;
    animation: bounce 1s ease;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.1);
    }
  }

  .story-viewer-title {
    font-size: 2.5rem;
    color: #333;
    margin: 0 0 1rem 0;
  }

  .story-author-name {
    font-size: 1.2rem;
    color: #666;
    font-style: italic;
  }

  .story-metadata {
    display: flex;
    justify-content: center;
    gap: 2rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .metadata-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: #555;
  }

  .story-content {
    font-size: 1.3rem;
    line-height: 2.2;
    color: #333;
    margin-bottom: 3rem;
  }

  .story-event {
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
    border-radius: 16px;
    border-left: 5px solid #ff9f40;
    transition: all 0.3s ease;
    animation: slideIn 0.5s ease;
  }

  .story-event:hover {
    transform: translateX(10px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateX(-30px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .event-number {
    display: inline-block;
    width: 35px;
    height: 35px;
    background: #ff9f40;
    color: white;
    border-radius: 50%;
    text-align: center;
    line-height: 35px;
    font-weight: bold;
    margin-right: 1rem;
  }

  .story-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 2rem;
    border-top: 3px solid #f0f0f0;
  }

  .story-actions button,
  .story-actions a {
    padding: 1rem 2rem;
    border: none;
    border-radius: 12px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-decoration: none;
    display: inline-block;
    font-family: inherit;
    font-size: 1rem;
  }

  .btn-back {
    background: #e0e0e0;
    color: #333;
  }

  .btn-back:hover {
    background: #d0d0d0;
    transform: translateY(-2px);
  }

  .btn-edit {
    background: linear-gradient(135deg, #ffd93d 0%, #ffcf1a 100%);
    color: #333;
  }

  .btn-edit:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(255, 217, 61, 0.4);
  }

  .btn-share {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
  }

  .btn-share:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);
  }

  .btn-print {
    background: linear-gradient(135deg, #6bcf7f 0%, #4caf50 100%);
    color: white;
  }

  .btn-print:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(107, 207, 127, 0.4);
  }

  .btn-qr {
    background: linear-gradient(135deg, #ff9f40 0%, #ff6b35 100%);
    color: white;
  }

  .btn-qr:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(255, 159, 64, 0.4);
  }

  /* Loading State */
  .loading-state {
    text-align: center;
    padding: 4rem 2rem;
  }

  .spinner {
    width: 60px;
    height: 60px;
    border: 5px solid #f0f0f0;
    border-top: 5px solid #ff9f40;
    border-radius: 50%;
    margin: 0 auto 2rem;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .loading-state p {
    font-size: 1.2rem;
    color: #666;
  }

  /* Error State */
  .error-state {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: 16px;
  }

  .error-icon {
    font-size: 6rem;
    margin-bottom: 1rem;
  }

  .error-state h2 {
    font-size: 2rem;
    color: #333;
    margin-bottom: 1rem;
  }

  .error-state p {
    font-size: 1.2rem;
    color: #666;
    margin-bottom: 2rem;
  }

  @media (max-width: 768px) {
    .story-display {
      padding: 2rem 1.5rem;
    }

    .story-hero-emoji {
      font-size: 4rem;
    }

    .story-viewer-title {
      font-size: 1.8rem;
    }

    .story-content {
      font-size: 1.1rem;
      line-height: 1.9;
    }

    .story-metadata {
      flex-direction: column;
      gap: 1rem;
    }

    .story-actions {
      flex-direction: column;
    }

    .story-actions button,
    .story-actions a {
      width: 100%;
    }
  }

  /* Print Styles */
  @media print {
    .story-actions,
    header,
    footer {
      display: none !important;
    }

    .story-display {
      box-shadow: none;
      padding: 0;
    }

    .story-event {
      break-inside: avoid;
    }
  }
</style>

<script>
  import {
    getStoryById,
    decodeSharedStory,
    generateShareLink,
    type CreatedStory,
  } from '@utils/story-builder';
  import { BASE_PATH as base } from '@utils/site';

  document.addEventListener('DOMContentLoaded', () => {
    loadAndDisplayStory();
  });

  function loadAndDisplayStory() {
    const urlParams = new URLSearchParams(window.location.search);
    const storyId = urlParams.get('id');
    const sharedData = urlParams.get('data');

    let story: CreatedStory | null = null;

    if (storyId) {
      story = getStoryById(storyId);
    } else if (sharedData) {
      story = decodeSharedStory(sharedData);
    }

    const loadingState = document.getElementById('loading-state');
    const errorState = document.getElementById('error-state');
    const storyDisplay = document.getElementById('story-display');

    if (loadingState) loadingState.style.display = 'none';

    if (!story) {
      if (errorState) errorState.style.display = 'block';
      if (storyDisplay) storyDisplay.style.display = 'none';
      return;
    }

    renderStory(story);
  }

  function renderStory(story: CreatedStory) {
    const display = document.getElementById('story-display');
    if (!display) return;

    const characterEmoji = getCharacterEmoji(story.character);
    const settingName = getSettingName(story.setting);
    const moodName = getMoodName(story.mood);

    display.innerHTML = `
      <div class="story-header">
        <div class="story-hero-emoji">${characterEmoji}</div>
        <h1 class="story-viewer-title">${story.title}</h1>
        ${story.author ? `<p class="story-author-name">von ${story.author}</p>` : ''}

        <div class="story-metadata">
          <div class="metadata-item">📍 ${settingName}</div>
          <div class="metadata-item">🎭 ${moodName}</div>
          <div class="metadata-item">📖 ${story.events.length} Ereignisse</div>
        </div>
      </div>

      <div class="story-content">
        ${story.events
          .map(
            (event, index) => `
          <div class="story-event" style="animation-delay: ${index * 0.1}s">
            <span class="event-number">${index + 1}</span>
            ${event.text}
          </div>
        `
          )
          .join('')}
      </div>

      <div class="story-actions">
        <a href="${base}/my-stories" class="btn-back">← Zurück</a>
        ${story.id ? `<a href="${base}/story-builder?edit=${story.id}" class="btn-edit">✏️ Bearbeiten</a>` : ''}
        ${story.id ? `<a href="${base}/qr-generator?id=${story.id}" class="btn-qr">📱 QR-Code</a>` : ''}
        <button class="btn-share" onclick="shareStory()">🔗 Teilen</button>
        <button class="btn-print" onclick="window.print()">🖨️ Drucken</button>
      </div>
    `;
  }

  // Global share function
  (window as any).shareStory = function () {
    const urlParams = new URLSearchParams(window.location.search);
    const storyId = urlParams.get('id');

    if (storyId) {
      const story = getStoryById(storyId);
      if (story) {
        const link = generateShareLink(story);
        navigator.clipboard.writeText(link);
        alert('Link in Zwischenablage kopiert!');
      }
    } else {
      // Already viewing shared story
      navigator.clipboard.writeText(window.location.href);
      alert('Link in Zwischenablage kopiert!');
    }
  };

  // Helper functions
  function getCharacterEmoji(id: string): string {
    const characters: Record<string, string> = {
      bruno: '🐻',
      fritz: '🦊',
      lina: '🦁',
      mila: '🐭',
      tobi: '🐯',
      moritz: '🐶',
      leo: '🐰',
      timmi: '👦',
      elephant: '🐘',
      panda: '🐼',
      owl: '🦉',
      penguin: '🐧',
    };
    return characters[id] || '🎭';
  }

  function getSettingName(id: string): string {
    const settings: Record<string, string> = {
      forest: 'Wald 🌲',
      city: 'Stadt 🏙️',
      beach: 'Strand 🏖️',
      home: 'Zuhause 🏠',
      space: 'Weltraum 🚀',
      underwater: 'Unterwasser 🌊',
      mountain: 'Berge ⛰️',
      farm: 'Bauernhof 🚜',
    };
    return settings[id] || id;
  }

  function getMoodName(mood: string): string {
    const moods: Record<string, string> = {
      happy: 'Fröhlich',
      adventurous: 'Abenteuerlich',
      calm: 'Ruhig',
      funny: 'Lustig',
      mysterious: 'Geheimnisvoll',
      exciting: 'Aufregend',
    };
    return moods[mood] || mood;
  }
</script>
