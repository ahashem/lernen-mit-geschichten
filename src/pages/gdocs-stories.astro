---
/**
 * Google Docs Stories Discovery Page
 *
 * Lists all available stories from Google Drive folders.
 * Allows filtering by language and skills.
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import StoryCard from '../components/StoryCard.astro';
import FilterSidebar from '../components/FilterSidebar.astro';
import StorySync from '../components/StorySync.astro';
import { GoogleDriveClient } from '../utils/google-drive';
import { googleDriveConfig, isGoogleDriveEnabled, languageFolders } from '../config/google-drive.config';
import { getTranslation } from '../utils/i18n';
import type { Locale } from '../utils/i18n';

// Get language from URL
const language = (Astro.url.searchParams.get('lang') as Locale) || 'de';

// Check if Google Drive is enabled
const gdEnabled = isGoogleDriveEnabled();

let stories: any[] = [];
let error: string | null = null;

if (gdEnabled) {
  try {
    const client = new GoogleDriveClient(googleDriveConfig);

    // Get folder ID for current language
    const folderId = languageFolders[language] || googleDriveConfig.folderId;

    if (folderId) {
      // List files in folder
      const files = await client.listFilesInFolder(folderId);

      // Fetch basic metadata for each story (without full content)
      stories = files.map(file => ({
        id: file.id,
        title: file.name,
        webViewLink: file.webViewLink,
        thumbnailLink: file.thumbnailLink,
        description: file.description,
        modifiedTime: file.modifiedTime,
      }));
    }
  } catch (err) {
    console.error('Error fetching stories:', err);
    error = err instanceof Error ? err.message : 'Failed to load stories';
  }
}

const pageTitle = getTranslation(language, 'googleDriveStories');
const pageDescription = getTranslation(language, 'googleDriveStoriesDescription');

// Check if user is admin (simple check - can be enhanced)
const isAdmin = Astro.url.searchParams.has('admin');
---

<BaseLayout title={pageTitle} description={pageDescription} lang={language}>
  <div class="gdocs-stories-page" dir={language === 'ar' || language === 'ur' ? 'rtl' : 'ltr'}>
    <div class="page-header">
      <h1>{pageTitle}</h1>
      <p class="page-description">{pageDescription}</p>

      {!gdEnabled && (
        <div class="alert alert-warning">
          <strong>⚠️ {getTranslation(language, 'notice')}:</strong>
          {getTranslation(language, 'googleDriveNotConfigured')}
        </div>
      )}

      {error && (
        <div class="alert alert-error">
          <strong>❌ {getTranslation(language, 'error')}:</strong>
          {error}
        </div>
      )}
    </div>

    {isAdmin && gdEnabled && (
      <div class="admin-section">
        <StorySync language={language} />
      </div>
    )}

    {gdEnabled && !error && (
      <div class="stories-section">
        <div class="stories-header">
          <h2>{getTranslation(language, 'availableStories')}</h2>
          <div class="stories-count">
            {stories.length} {stories.length === 1 ? getTranslation(language, 'story') : getTranslation(language, 'stories')}
          </div>
        </div>

        {stories.length === 0 ? (
          <div class="empty-state">
            <div class="empty-icon">📭</div>
            <h3>{getTranslation(language, 'noStoriesFound')}</h3>
            <p>{getTranslation(language, 'checkBackLater')}</p>
          </div>
        ) : (
          <div class="stories-grid">
            {stories.map((story) => (
              <a href={`/stories/gdocs/${story.id}?lang=${language}`} class="story-card-link">
                <div class="gdocs-story-card">
                  <div class="card-badge">
                    <span>📄 Google Drive</span>
                  </div>

                  {story.thumbnailLink && (
                    <div class="card-thumbnail">
                      <img src={story.thumbnailLink} alt={story.title} loading="lazy" />
                    </div>
                  )}

                  <div class="card-content">
                    <h3 class="card-title">{story.title}</h3>

                    {story.description && (
                      <p class="card-description">{story.description}</p>
                    )}

                    <div class="card-meta">
                      <span class="meta-item">
                        🕐 {new Date(story.modifiedTime).toLocaleDateString(language)}
                      </span>
                    </div>
                  </div>

                  <div class="card-actions">
                    <span class="read-btn">
                      {getTranslation(language, 'readStory')} →
                    </span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        )}
      </div>
    )}

    <div class="info-section">
      <h2>{getTranslation(language, 'howItWorks')}</h2>
      <div class="info-cards">
        <div class="info-card">
          <div class="info-icon">📝</div>
          <h3>{getTranslation(language, 'step1Title')}</h3>
          <p>{getTranslation(language, 'step1Description')}</p>
        </div>

        <div class="info-card">
          <div class="info-icon">☁️</div>
          <h3>{getTranslation(language, 'step2Title')}</h3>
          <p>{getTranslation(language, 'step2Description')}</p>
        </div>

        <div class="info-card">
          <div class="info-icon">✨</div>
          <h3>{getTranslation(language, 'step3Title')}</h3>
          <p>{getTranslation(language, 'step3Description')}</p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .gdocs-stories-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .page-header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .page-header h1 {
    font-size: 2.5rem;
    color: #333;
    margin-bottom: 1rem;
  }

  .page-description {
    font-size: 1.125rem;
    color: #666;
    max-width: 700px;
    margin: 0 auto 2rem;
  }

  .alert {
    padding: 1rem 1.5rem;
    border-radius: 8px;
    margin: 1rem auto;
    max-width: 700px;
  }

  .alert-warning {
    background: #fff3cd;
    border: 2px solid #ffc107;
    color: #856404;
  }

  .alert-error {
    background: #f8d7da;
    border: 2px solid #f44336;
    color: #721c24;
  }

  .admin-section {
    margin-bottom: 3rem;
  }

  .stories-section {
    margin-bottom: 3rem;
  }

  .stories-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 2px solid #eee;
  }

  .stories-header h2 {
    font-size: 2rem;
    color: #333;
    margin: 0;
  }

  .stories-count {
    padding: 0.5rem 1rem;
    background: #6BCF7F;
    color: white;
    border-radius: 20px;
    font-weight: 600;
  }

  .empty-state {
    text-align: center;
    padding: 4rem 2rem;
  }

  .empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
  }

  .empty-state h3 {
    font-size: 1.5rem;
    color: #333;
    margin-bottom: 0.5rem;
  }

  .empty-state p {
    color: #666;
    font-size: 1.125rem;
  }

  .stories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
  }

  .story-card-link {
    text-decoration: none;
    color: inherit;
  }

  .gdocs-story-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .gdocs-story-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
  }

  .card-badge {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 0.5rem 1rem;
    font-size: 0.85rem;
    font-weight: 600;
    text-align: center;
  }

  .card-thumbnail {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background: #f5f5f5;
  }

  .card-thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card-content {
    padding: 1.5rem;
    flex: 1;
  }

  .card-title {
    font-size: 1.25rem;
    color: #333;
    margin: 0 0 1rem 0;
  }

  .card-description {
    color: #666;
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-meta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .meta-item {
    padding: 0.25rem 0.75rem;
    background: #f0f0f0;
    border-radius: 16px;
    font-size: 0.85rem;
    color: #666;
  }

  .card-actions {
    padding: 1rem 1.5rem;
    background: #f9f9f9;
    border-top: 1px solid #eee;
  }

  .read-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: #FF9F40;
    color: white;
    border-radius: 8px;
    font-weight: 600;
    text-align: center;
    width: 100%;
    transition: background 0.2s;
  }

  .gdocs-story-card:hover .read-btn {
    background: #E88F30;
  }

  .info-section {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 2px solid #eee;
  }

  .info-section h2 {
    font-size: 2rem;
    text-align: center;
    color: #333;
    margin-bottom: 2rem;
  }

  .info-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .info-card {
    text-align: center;
    padding: 2rem;
    background: #f9f9f9;
    border-radius: 12px;
  }

  .info-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .info-card h3 {
    font-size: 1.25rem;
    color: #333;
    margin-bottom: 0.75rem;
  }

  .info-card p {
    color: #666;
    line-height: 1.6;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }

    .stories-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .stories-grid {
      grid-template-columns: 1fr;
    }

    .info-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
