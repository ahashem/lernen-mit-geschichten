---
/**
 * Dynamic Story Page for Google Drive Stories
 *
 * Fetches and displays stories from Google Drive by document ID.
 * URL format: /stories/gdocs/YOUR_DOCUMENT_ID
 */

import BaseLayout from '../../../layouts/BaseLayout.astro';
import QuizInteractive from '../../../components/QuizInteractive.astro';
import { GoogleDriveClient } from '../../../utils/google-drive';
import { googleDriveConfig, isGoogleDriveEnabled } from '../../../config/google-drive.config';
import type { Locale } from '../../../utils/i18n';
import { getTranslation } from '../../../utils/i18n';

// Get document ID from params
const { id } = Astro.params;

if (!id) {
  return Astro.redirect('/404');
}

// Get language from URL query or default to German
const language = (Astro.url.searchParams.get('lang') as Locale) || 'de';

// Check if Google Drive is enabled
if (!isGoogleDriveEnabled()) {
  return new Response('Google Drive integration is not configured', { status: 503 });
}

let story;
let error: string | null = null;

try {
  // Fetch story from Google Drive
  const client = new GoogleDriveClient(googleDriveConfig);
  story = await client.fetchStory(id, language);
} catch (err) {
  console.error('Error fetching story:', err);
  error = err instanceof Error ? err.message : 'Failed to load story';
}

// If error, show error page
if (error || !story) {
  return new Response(error || 'Story not found', { status: 404 });
}

const pageTitle = story.title;
const metaDescription = story.content.substring(0, 150) + '...';
---

<BaseLayout title={pageTitle} description={metaDescription} lang={language}>
  <article class="story-page gdocs-story" dir={language === 'ar' || language === 'ur' ? 'rtl' : 'ltr'}>
    <div class="story-header">
      <div class="story-badge">
        <span class="badge-icon">📄</span>
        <span class="badge-text">{getTranslation(language, 'googleDriveStory')}</span>
      </div>

      <h1 class="story-title">
        {story.metadata.emoji && <span class="title-emoji">{story.metadata.emoji}</span>}
        {story.title}
      </h1>

      <div class="story-meta">
        {story.metadata.skills && story.metadata.skills.length > 0 && (
          <div class="meta-skills">
            <span class="meta-label">{getTranslation(language, 'skills')}:</span>
            <div class="skills-tags">
              {story.metadata.skills.map((skill: string) => (
                <span class="skill-tag">{skill}</span>
              ))}
            </div>
          </div>
        )}

        {story.metadata.difficulty && (
          <div class="meta-difficulty">
            <span class="meta-label">{getTranslation(language, 'difficulty')}:</span>
            <span class="difficulty-badge" data-difficulty={story.metadata.difficulty}>
              {story.metadata.difficulty}
            </span>
          </div>
        )}

        {story.metadata.estimatedReadTime && (
          <div class="meta-read-time">
            <span class="meta-label">⏱️</span>
            <span>{story.metadata.estimatedReadTime} {getTranslation(language, 'minutes')}</span>
          </div>
        )}

        {story.metadata.author && (
          <div class="meta-author">
            <span class="meta-label">✍️</span>
            <span>{story.metadata.author}</span>
          </div>
        )}
      </div>

      <div class="sync-info">
        <small>
          {getTranslation(language, 'lastUpdated')}:
          {new Date(story.metadata.lastModified).toLocaleDateString(language)}
        </small>
        <button class="refresh-btn" data-doc-id={id}>
          🔄 {getTranslation(language, 'refresh')}
        </button>
      </div>
    </div>

    <div class="story-content">
      {story.images && story.images.length > 0 && (
        <div class="story-images">
          {story.images.map((img: any) => (
            <img src={img.url} alt={img.alt} loading="lazy" />
          ))}
        </div>
      )}

      <div class="story-text" set:html={story.content} />
    </div>

    {story.questions && story.questions.length > 0 && (
      <div class="story-quiz">
        <QuizInteractive
          questions={story.questions}
          language={language}
          storyId={story.id}
          title={getTranslation(language, 'testYourKnowledge')}
        />
      </div>
    )}

    <div class="story-actions">
      <a href={`/${language}`} class="back-link">
        ← {getTranslation(language, 'backToStories')}
      </a>
    </div>
  </article>
</BaseLayout>

<style>
  .story-page {
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }

  .story-header {
    margin-bottom: 2rem;
  }

  .story-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .badge-icon {
    font-size: 1.2rem;
  }

  .story-title {
    font-size: 2.5rem;
    margin: 1rem 0;
    color: #333;
    line-height: 1.2;
  }

  .title-emoji {
    font-size: 2rem;
    margin-right: 0.5rem;
  }

  .story-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 1.5rem 0;
    padding: 1rem;
    background: #f9f9f9;
    border-radius: 12px;
  }

  .meta-label {
    font-weight: 600;
    color: #555;
    margin-right: 0.5rem;
  }

  .skills-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-tag {
    padding: 0.25rem 0.75rem;
    background: #FFD93D;
    border-radius: 16px;
    font-size: 0.85rem;
    font-weight: 600;
    color: #333;
  }

  .difficulty-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 16px;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .difficulty-badge[data-difficulty="beginner"] {
    background: #4CAF50;
    color: white;
  }

  .difficulty-badge[data-difficulty="intermediate"] {
    background: #FF9F40;
    color: white;
  }

  .sync-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem;
    background: #e3f2fd;
    border-radius: 8px;
    margin-top: 1rem;
  }

  .sync-info small {
    color: #1976d2;
    font-size: 0.85rem;
  }

  .refresh-btn {
    padding: 0.5rem 1rem;
    background: #2196F3;
    color: white;
    border: none;
    border-radius: 6px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: background 0.2s;
  }

  .refresh-btn:hover {
    background: #0b7dda;
  }

  .story-content {
    margin: 2rem 0;
  }

  .story-images {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .story-images img {
    width: 100%;
    height: auto;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .story-text {
    font-size: 1.125rem;
    line-height: 1.8;
    color: #333;
  }

  .story-text :global(h2) {
    font-size: 1.75rem;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: #FF9F40;
  }

  .story-text :global(h3) {
    font-size: 1.5rem;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: #6BCF7F;
  }

  .story-text :global(p) {
    margin-bottom: 1rem;
  }

  .story-text :global(ul),
  .story-text :global(ol) {
    margin-left: 2rem;
    margin-bottom: 1rem;
  }

  .story-text :global(li) {
    margin-bottom: 0.5rem;
  }

  .story-text :global(strong) {
    color: #FF9F40;
    font-weight: 700;
  }

  .story-quiz {
    margin: 3rem 0;
  }

  .story-actions {
    margin: 2rem 0;
    padding-top: 2rem;
    border-top: 2px solid #eee;
  }

  .back-link {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: #6BCF7F;
    color: white;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
    transition: background 0.2s;
  }

  .back-link:hover {
    background: #5BB86E;
  }

  /* RTL Support */
  [dir="rtl"] .title-emoji {
    margin-right: 0;
    margin-left: 0.5rem;
  }

  [dir="rtl"] .story-text :global(ul),
  [dir="rtl"] .story-text :global(ol) {
    margin-left: 0;
    margin-right: 2rem;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .story-title {
      font-size: 2rem;
    }

    .story-meta {
      flex-direction: column;
      gap: 1rem;
    }

    .sync-info {
      flex-direction: column;
      gap: 0.75rem;
      align-items: flex-start;
    }
  }
</style>

<script>
  import { GoogleDriveClient } from '../../../utils/google-drive';
  import { googleDriveConfig } from '../../../config/google-drive.config';

  // Handle refresh button
  document.addEventListener('DOMContentLoaded', () => {
    const refreshBtn = document.querySelector('.refresh-btn');
    if (!refreshBtn) return;

    refreshBtn.addEventListener('click', async () => {
      const docId = refreshBtn.getAttribute('data-doc-id');
      if (!docId) return;

      // Clear cache and reload
      const client = new GoogleDriveClient(googleDriveConfig);
      client.clearCache(docId);

      // Reload page
      window.location.reload();
    });
  });
</script>
