---
/**
 * Fruit Slicer Quiz Game Launcher
 * Standalone page for fruit slicing quiz game
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FruitSlicer from '../components/FruitSlicer.astro';
import { getCollection } from 'astro:content';
import { getTranslation } from '../utils/i18n';

const locale = 'de';
const t = (key: string) => getTranslation(locale, key as any);

// Get all stories for quiz questions
const allStories = await getCollection('stories');

// Get stories with questions
const storiesWithQuestions = allStories.filter((story) => story.data.questions && story.data.questions.length > 0);

// Default to first story with questions
const selectedStory = storiesWithQuestions[0];

const questions = selectedStory?.data.questions || [];
---

<BaseLayout title={t(locale, 'fruitSlicerTitle')} description={t(locale, 'fruitSlicerDescription')}>
  <div class="fruit-slicer-page">
    <header class="page-header">
      <h1>🍎 {t(locale, 'fruitSlicerTitle')} 🍌</h1>
      <p class="page-description">{t(locale, 'fruitSlicerDescription')}</p>
    </header>

    <div class="game-info-panel">
      <div class="info-card">
        <h3>🎮 {t(locale, 'howToPlay')}</h3>
        <ul>
          <li>{t(locale, 'fruitSlicerInstruction1')}</li>
          <li>{t(locale, 'fruitSlicerInstruction2')}</li>
          <li>{t(locale, 'fruitSlicerInstruction3')}</li>
          <li>{t(locale, 'fruitSlicerInstruction4')}</li>
        </ul>
      </div>

      <div class="info-card">
        <h3>⭐ {t(locale, 'rewards')}</h3>
        <ul>
          <li>{t(locale, 'fruitSlicerReward1')}</li>
          <li>{t(locale, 'fruitSlicerReward2')}</li>
          <li>{t(locale, 'fruitSlicerReward3')}</li>
        </ul>
      </div>

      <div class="info-card">
        <h3>🏆 {t(locale, 'achievements')}</h3>
        <ul>
          <li>🍎 {t(locale, 'achievementFruitMaster')}</li>
          <li>🔥 {t(locale, 'achievementComboKing')}</li>
          <li>🎯 {t(locale, 'achievementPerfectSlicer')}</li>
        </ul>
      </div>
    </div>

    <div class="story-selector">
      <label for="storySelect">{t(locale, 'selectStory')}:</label>
      <select id="storySelect">
        {
          storiesWithQuestions.map((story) => (
            <option value={story.data.storyId} selected={story.data.storyId === selectedStory?.data.storyId}>
              {story.data.emoji} {story.data.title}
            </option>
          ))
        }
      </select>
    </div>

    {
      selectedStory && questions.length > 0 ? (
        <FruitSlicer storyId={selectedStory.data.storyId} questions={questions} locale={locale} />
      ) : (
        <div class="no-questions-message">
          <p>{t(locale, 'noQuestionsAvailable')}</p>
          <a href={`/${locale}/stories`} class="back-link">
            {t(locale, 'backToStories')}
          </a>
        </div>
      )
    }

    <div class="high-scores-panel">
      <h2>🏆 {t(locale, 'highScores')}</h2>
      <div class="high-scores-grid" id="highScoresGrid">
        <div class="high-score-card">
          <h3>{t(locale, 'practiceMode')}</h3>
          <p class="high-score-value" id="practiceHighScore">0</p>
        </div>
        <div class="high-score-card">
          <h3>{t(locale, 'timedMode')}</h3>
          <p class="high-score-value" id="timedHighScore">0</p>
        </div>
        <div class="high-score-card">
          <h3>{t(locale, 'endlessMode')}</h3>
          <p class="high-score-value" id="endlessHighScore">0</p>
        </div>
      </div>
    </div>

    <div class="stats-panel">
      <h2>📊 {t(locale, 'yourStats')}</h2>
      <div class="stats-grid">
        <div class="stat-item">
          <span class="stat-label">{t(locale, 'gamesPlayed')}</span>
          <span class="stat-value" id="gamesPlayed">0</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">{t(locale, 'totalScore')}</span>
          <span class="stat-value" id="totalScore">0</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">{t(locale, 'averageAccuracy')}</span>
          <span class="stat-value" id="averageAccuracy">0%</span>
        </div>
        <div class="stat-item">
          <span class="stat-label">{t(locale, 'bestCombo')}</span>
          <span class="stat-value" id="bestCombo">0x</span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .fruit-slicer-page {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-description {
    font-size: 1.2rem;
    color: #666;
  }

  .game-info-panel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .info-card {
    background: #f8f9fa;
    border-radius: 10px;
    padding: 1.5rem;
  }

  .info-card h3 {
    margin-bottom: 1rem;
    color: #667eea;
  }

  .info-card ul {
    list-style: none;
    padding: 0;
  }

  .info-card li {
    padding: 0.5rem 0;
    padding-left: 1.5rem;
    position: relative;
  }

  .info-card li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: #4CAF50;
    font-weight: bold;
  }

  .story-selector {
    text-align: center;
    margin-bottom: 2rem;
  }

  .story-selector label {
    font-weight: bold;
    margin-right: 1rem;
  }

  .story-selector select {
    padding: 0.5rem 1rem;
    border-radius: 5px;
    border: 2px solid #667eea;
    font-size: 1rem;
    min-width: 250px;
  }

  .no-questions-message {
    text-align: center;
    padding: 3rem;
    background: #f8f9fa;
    border-radius: 10px;
    margin-bottom: 2rem;
  }

  .back-link {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.8rem 2rem;
    background: #667eea;
    color: white;
    text-decoration: none;
    border-radius: 25px;
    font-weight: bold;
  }

  .back-link:hover {
    background: #764ba2;
  }

  .high-scores-panel {
    margin-top: 3rem;
    margin-bottom: 2rem;
  }

  .high-scores-panel h2 {
    text-align: center;
    margin-bottom: 1.5rem;
    color: #667eea;
  }

  .high-scores-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .high-score-card {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    border-radius: 15px;
    padding: 2rem;
    text-align: center;
  }

  .high-score-card h3 {
    font-size: 1rem;
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  .high-score-value {
    font-size: 2.5rem;
    font-weight: bold;
    margin: 0;
  }

  .stats-panel {
    margin-top: 2rem;
    background: #f8f9fa;
    border-radius: 15px;
    padding: 2rem;
  }

  .stats-panel h2 {
    text-align: center;
    margin-bottom: 1.5rem;
    color: #667eea;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .stat-item {
    text-align: center;
    padding: 1rem;
  }

  .stat-label {
    display: block;
    font-size: 0.9rem;
    color: #666;
    margin-bottom: 0.5rem;
  }

  .stat-value {
    display: block;
    font-size: 2rem;
    font-weight: bold;
    color: #333;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 2rem;
    }

    .game-info-panel {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Load and display high scores
  function loadHighScores() {
    const modes: Array<'practice' | 'timed' | 'endless'> = ['practice', 'timed', 'endless'];

    modes.forEach((mode) => {
      const saved = localStorage.getItem(`fruit-slicer-highscore-${mode}`);
      const score = saved ? parseInt(saved, 10) : 0;
      const el = document.getElementById(`${mode}HighScore`);
      if (el) {
        el.textContent = score.toString();
      }
    });
  }

  // Load and display stats
  function loadStats() {
    try {
      const allStats = JSON.parse(localStorage.getItem('fruit-slicer-stats') || '[]');

      if (allStats.length === 0) return;

      // Calculate aggregated stats
      const gamesPlayed = allStats.length;
      const totalScore = allStats.reduce((sum: number, stat: any) => sum + stat.score, 0);
      const averageAccuracy =
        allStats.reduce((sum: number, stat: any) => sum + stat.accuracy, 0) / gamesPlayed;
      const bestCombo = Math.max(...allStats.map((stat: any) => stat.maxCombo));

      // Update UI
      document.getElementById('gamesPlayed')!.textContent = gamesPlayed.toString();
      document.getElementById('totalScore')!.textContent = totalScore.toLocaleString();
      document.getElementById('averageAccuracy')!.textContent = `${Math.round(averageAccuracy)}%`;
      document.getElementById('bestCombo')!.textContent = `${bestCombo}x`;
    } catch (e) {
      console.error('Failed to load stats:', e);
    }
  }

  // Initialize
  loadHighScores();
  loadStats();

  // Story selector handler (for future dynamic loading)
  document.getElementById('storySelect')?.addEventListener('change', (e) => {
    const storyId = (e.target as HTMLSelectElement).value;
    window.location.href = `/fruit-slicer?story=${storyId}`;
  });
</script>
