---
import { getPublishedStories } from '@utils/stories';
import StoryPage from '@components/reader/StoryPage.astro';

export async function getStaticPaths() {
  const stories = await getPublishedStories(({ id }) => !id.startsWith('de/'));
  return stories.map(story => {
    const [locale, ...rest] = story.id.split('/');
    return { params: { locale, slug: rest.join('/') }, props: { story } };
  });
}

const { story } = Astro.props;
---

<StoryPage story={story} />
