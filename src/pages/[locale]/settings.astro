---
import SettingsPage from '@components/SettingsPage.astro';
import type { Locale } from '@utils/i18n';

export function getStaticPaths() {
  return ['ar', 'en', 'tr', 'ur'].map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<SettingsPage locale={locale} />
