---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MemoryGame from '../../components/MemoryGame.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getTranslation } from '../../utils/i18n';

const locale = 'de';
const title = 'Gedächtnisspiel';
const description = 'Finde die passenden Kartenpaare!';
import { BASE_PATH as base } from '@utils/site';
---

<BaseLayout title={title} description={description} locale={locale}>
  <div class="memory-game-page">
    <div class="page-header">
      <Breadcrumbs
        locale={locale}
        items={[{ label: getTranslation(locale, 'gamesHub'), url: `${base}/games` }]}
        currentPage={title}
      />
      <h1 class="page-title">🎴 Gedächtnisspiel</h1>
    </div>
    <div class="container">
      <MemoryGame locale={locale} />
    </div>
  </div>
</BaseLayout>

<style>
  .memory-game-page {
    min-height: 100vh;
    padding: 2rem 0;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  .page-header {
    max-width: 1200px;
    margin: 0 auto 2rem;
    padding: 0 2rem;
  }

  .page-title {
    font-size: 2.5rem;
    color: white;
    text-align: center;
    margin: 1rem 0;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }

  .container {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 20px;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 768px) {
    .memory-game-page {
      padding: 1rem 0;
    }

    .page-header {
      padding: 0 1rem;
    }

    .page-title {
      font-size: 1.8rem;
    }

    .container {
      padding: 1rem;
      border-radius: 12px;
    }
  }
</style>
