  { id: 'action', name: 'Action', emoji: '⚡', color: '#FF6B6B' },
  { id: 'word', name: 'Wörter', emoji: '🔤', color: '#FFD93D' },
  { id: 'adventure', name: 'Abenteuer', emoji: '🗺️', color: '#764ba2' },
  { id: 'creative', name: 'Kreativ', emoji: '🎨', color: '#FF9F40' },
];

// Difficulty translations
const difficultyLabels = {
  easy: 'Leicht',
