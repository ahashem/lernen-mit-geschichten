---
import '@styles/fonts.css';
import '@styles/tokens.css';
import '@styles/global.css';
import '@styles/rtl.css';
import ClassLinkCard from '@components/ClassLinkCard.astro';
import LanguageSelector from '@components/LanguageSelector.astro';
import GrownUpsMenu from '@components/GrownUpsMenu.astro';
import Icon from '@components/reader/Icon.astro';
import Logo from '@components/Logo.astro';
import GTMTracking from '@components/GTMTracking.astro';
import ConsentBanner from '@components/ConsentBanner.astro';
import type { Locale } from '@utils/i18n';
import { getTranslation, isRTL } from '@utils/i18n';
import { BASE_PATH as base, OFFLINE } from '@utils/site';
import { buildMarker } from '@utils/build-marker';
import { LOCALES } from '@utils/story-availability';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  image?: string;
  type?: 'website' | 'article';
  /** Story pages: this story's own path in each language it exists in (slugs can differ between translations). */
  storyHrefs?: Partial<Record<Locale, string>>;
}

const { title, description, locale = 'de', image, type = 'website', storyHrefs } = Astro.props;
const dir = isRTL(locale) ? 'rtl' : 'ltr';
const siteName = getTranslation(locale, 'siteName');
// The wordmark stacks the name: the last word, the one that carries it ("Geschichten", "Stories", "القصص"), goes big on
// its own line over a swash. A one-word name stays on one line.
const nameSplit = siteName.lastIndexOf(' ');
const nameLead = nameSplit > 0 ? siteName.slice(0, nameSplit) : '';
const nameMain = nameSplit > 0 ? siteName.slice(nameSplit + 1) : siteName;
const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const pageUrl = `${siteUrl}${Astro.url.pathname}`;
const defaultDescription = getTranslation(locale, 'tagline');
const ogDescription = description || defaultDescription;
// No default image: a placeholder file would be a broken link, and the site has no art of its own to share.
const ogImage = image;
const pageTitle = `${title} | ${siteName}`;

// robots.txt only works at a host root, so staging and the moderators' preview also say it on every page.
const noindex = ['1', 'true', true].includes(import.meta.env.NOINDEX);
const build = buildMarker();

// The same page in every language it exists in, for hreflang. German has no prefix.
const bare =
  Astro.url.pathname.replace(new RegExp(`^${base}`), '').replace(/^\/(ar|en|tr|ur)(?=\/|$)/, '') ||
  '/';
const alternates = LOCALES.filter(code => !storyHrefs || storyHrefs[code]).map(code => ({
  code,
  href:
    `${siteUrl}${storyHrefs?.[code] ?? `${base}${code === 'de' ? '' : `/${code}`}${bare === '/' && code !== 'de' ? '' : bare}`}` ||
    `${siteUrl}/`,
}));
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Article',
        headline: title,
        description: ogDescription,
        inLanguage: locale,
        isAccessibleForFree: true,
        ...(image ? { image } : {}),
        publisher: { '@type': 'Organization', name: siteName },
      }
    : null;
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="build" content={build} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <script is:inline>
      // Scripts are on: pages can lay out their script-only controls in the first frame instead of jumping later.
      document.documentElement.dataset.js = '';
      // Apply the saved Lamp theme before first paint so a bedtime reader is never flashed with day colours.
      try {
        if (JSON.parse(localStorage.getItem('reader-prefs') || '{}').theme === 'lamp')
          document.documentElement.dataset.theme = 'lamp';
      } catch (e) {}
    </script>
    <script is:inline>
      // Page transitions (global.css): a story's cover grows out of the card that was opened and shrinks back into
      // it on the way home. The motion is CSS; this only says which card is in play, which CSS cannot know. A name
      // may sit on one element per page, so only that card gets it. Inline in the head so `pagereveal` is heard
      // before the first frame.
      (function () {
        var NAME = 'story-art';
        var KEY = 'lmg-story-cover';
        var named = null;
        var path = function (href) {
          return new URL(href, location.href).pathname.replace(/\/$/, '');
        };
        var name = function (el) {
          if (named) named.style.viewTransitionName = '';
          named = el;
          if (el) el.style.viewTransitionName = NAME;
        };
        document.addEventListener('click', function (e) {
          if (
            e.defaultPrevented ||
            e.button !== 0 ||
            e.metaKey ||
            e.ctrlKey ||
            e.shiftKey ||
            e.altKey
          )
            return;
          var link = e.target.closest && e.target.closest('a[href]');
          var card = link && link.closest('.tile, .hero');
          var cover = card && card.querySelector('.tile-cover, .hero-cover');
          if (cover) name(cover);
        });
        // The story page remembers itself, so the page it leaves for can find the card that belongs to it.
        document.addEventListener('DOMContentLoaded', function () {
          try {
            if (document.querySelector('.cover-art'))
              sessionStorage.setItem(KEY, path(location.href));
          } catch {
            // Storage blocked: the cover simply fades instead.
          }
        });
        addEventListener('pageshow', function () {
          name(null);
        });
        addEventListener('pagereveal', function (e) {
          if (!e.viewTransition) return;
          var story = null;
          try {
            story = sessionStorage.getItem(KEY);
          } catch {
            return;
          }
          if (!story) return;
          var covers = document.querySelectorAll('a.tile-cover, a.hero-cover');
          for (var i = 0; i < covers.length; i++) {
            if (covers[i].offsetParent && path(covers[i].href) === story) {
              name(covers[i]);
              e.viewTransition.finished.finally(function () {
                name(null);
              });
              return;
            }
          }
        });
      })();
    </script>

    <GTMTracking />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={ogDescription} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta
      property="og:locale"
      content={locale === 'de'
        ? 'de_DE'
        : locale === 'ar'
          ? 'ar_AR'
          : locale === 'tr'
            ? 'tr_TR'
            : locale === 'ur'
              ? 'ur_PK'
              : 'en_US'}
    />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta property="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta property="twitter:url" content={pageUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={ogDescription} />
    {ogImage && <meta property="twitter:image" content={ogImage} />}

    <!-- Canonical URL and the page in its other languages -->
    <link rel="canonical" href={pageUrl} />
    {alternates.map(a => <link rel="alternate" hreflang={a.code} href={a.href} />)}
    {
      alternates.length > 1 && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={(alternates.find(a => a.code === 'de') ?? alternates[0]).href}
        />
      )
    }
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {OFFLINE && <link rel="manifest" href={`${base}/manifest.webmanifest`} />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <a href="#main-content" class="visually-hidden">{getTranslation(locale, 'skipToContent')}</a>

    <header>
      <div class="container bar">
        <a class="wordmark" href={locale === 'de' ? `${base}/` : `${base}/${locale}`}>
          <Logo size={44} />
          <span class="name">
            {nameLead && <span class="name-lead">{nameLead}</span>}
            <span class="name-main">
              {nameMain}
              <svg class="swash" viewBox="0 0 120 10" preserveAspectRatio="none" aria-hidden="true">
                <path d="M2 6c20-6 40-6 58 0s38 5 58-2"></path>
              </svg>
            </span>
          </span>
        </a>
        <nav class="bar-end" aria-label={getTranslation(locale, 'mainNav')}>
          <a
            class="bar-link"
            href={locale === 'de' ? `${base}/library` : `${base}/${locale}/library`}
          >
            <Icon name="search" size={22} />
            <span class="bar-label">{getTranslation(locale, 'library')}</span>
          </a>
          <LanguageSelector
            currentLocale={locale}
            currentPath={Astro.url.pathname}
            storyHrefs={storyHrefs}
          />
          <GrownUpsMenu locale={locale} />
        </nav>
      </div>
    </header>

    <ClassLinkCard locale={locale} />

    {
      OFFLINE && (
        <>
          <div
            class="offline-bar notice notice--problem"
            role="status"
            hidden
            data-offline-bar
            data-sw={`${base}/sw.js`}
            data-scope={`${base}/`}
          >
            <span>{getTranslation(locale, 'offlineBanner')}</span>
            <button class="btn" type="button" data-offline-dismiss>
              {getTranslation(locale, 'dismiss')}
            </button>
          </div>
        </>
      )
    }

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <svg class="hills" viewBox="0 0 1200 80" preserveAspectRatio="none" aria-hidden="true">
        <path class="hills-back" d="M0 60C180 10 330 20 470 50s300 10 450-25 220 10 280 30V80H0z"
        ></path>
        <path class="hills-front" d="M0 70c160-35 320-40 520-12s420 20 680-28V80H0z"></path>
      </svg>
      <div class="container foot">
        <ul class="foot-links">
          <li>
            <a href={locale === 'de' ? `${base}/folio` : `${base}/${locale}/folio`}
              >{getTranslation(locale, 'folioTitle')}</a
            >
          </li>
          <li>
            <a href={locale === 'de' ? `${base}/privacy` : `${base}/${locale}/privacy`}
              >{getTranslation(locale, 'privacyTitle')}</a
            >
          </li>
          <li>
            <a
              href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
              target="_blank"
              rel="noopener"
            >
              CC BY-NC-SA 4.0
            </a>
          </li>
        </ul>
        <p>{getTranslation(locale, 'footerArt')}</p>
        <p>&copy; {new Date().getFullYear()} {siteName}</p>
      </div>
    </footer>

    <ConsentBanner locale={locale} />

    {OFFLINE && <script src="../scripts/offline.ts" />}

    <style>
      .offline-bar {
        position: fixed;
        inset-inline: var(--s-4);
        inset-block-end: var(--s-4);
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--s-3);
      }
      .offline-bar[hidden] {
        display: none;
      }

      header {
        background: var(--card);
        position: sticky;
        inset-block-start: 0;
        z-index: 1000;
      }
      /* A scalloped paper edge instead of a hairline: the bar reads as a strip of card laid on the page. */
      header::after {
        content: '';
        position: absolute;
        inset-inline: 0;
        inset-block-start: 100%;
        block-size: 10px;
        background: var(--card);
        -webkit-mask: radial-gradient(10px 10px at 10px 0, #000 98%, transparent) 0 0 / 20px 10px
          repeat-x;
        mask: radial-gradient(10px 10px at 10px 0, #000 98%, transparent) 0 0 / 20px 10px repeat-x;
        filter: drop-shadow(0 2px 0 rgb(110 62 28 / 0.12));
      }
      @media (forced-colors: active) {
        header {
          border-block-end: 1px solid CanvasText;
        }
        header::after {
          display: none;
        }
      }

      /* One 56 px bar on every width (ux/03 §1a): the wordmark, then Library, language and the grown-ups menu. */
      .bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--s-3);
        min-block-size: 64px;
        padding-block: var(--s-1);
      }

      .wordmark {
        display: inline-flex;
        align-items: center;
        gap: var(--s-2);
        font-family: var(--font-display, inherit);
        font-size: 1.375rem;
        font-weight: 700;
        line-height: 1;
        color: var(--poppy-ink);
        text-decoration: none;
        min-inline-size: 0;
      }
      .name {
        display: grid;
        justify-items: start;
      }
      .name-lead {
        font-size: max(0.6em, 13px);
        color: var(--ink);
      }
      .name-main {
        display: grid;
      }
      .swash {
        inline-size: 100%;
        block-size: 8px;
        margin-block-start: 2px;
        fill: none;
        stroke: var(--sun);
        stroke-width: 3.2;
        stroke-linecap: round;
      }
      /* Naskh and Nastaliq need room above and below the line. */
      .wordmark:lang(ar) {
        line-height: 1.35;
      }
      .wordmark:lang(ur) {
        line-height: 2;
      }
      .wordmark:lang(ur) .name-lead {
        margin-block-end: -0.2em;
      }
      .wordmark:lang(ur) .swash {
        margin-block-start: -0.45em;
      }
      @media (forced-colors: active) {
        .swash {
          stroke: CanvasText;
        }
      }
      :root[data-theme='lamp'] .wordmark {
        color: var(--ink);
      }

      .bar-end {
        display: flex;
        align-items: center;
        gap: var(--s-2);
        flex-shrink: 0;
      }

      .bar-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: var(--s-2);
        min-block-size: var(--tap-adult);
        min-inline-size: var(--tap-adult);
        padding-inline: var(--s-2);
        border-radius: var(--r-m);
        font-weight: 600;
        color: var(--ink);
        text-decoration: none;
      }

      @media (min-width: 900px) {
        .wordmark {
          font-size: 1.75rem;
        }
      }

      /* The narrowest phones keep the name and drop the book. */
      @media (max-width: 359px) {
        .wordmark :global(.logo) {
          display: none;
        }
        .wordmark.wordmark {
          font-size: 1.125rem;
        }
      }

      @media (max-width: 599px) {
        .wordmark {
          font-size: 1.25rem;
          gap: var(--s-1);
        }
        .name-lead {
          white-space: nowrap;
        }
        .wordmark :global(.logo) {
          inline-size: 32px;
          block-size: 32px;
        }
      }

      /* The Library link shows its word only once the stacked wordmark and both menus have room beside it. */
      @media (max-width: 767px) {
        .bar-label {
          position: absolute;
          inline-size: 1px;
          block-size: 1px;
          overflow: hidden;
          clip-path: inset(50%);
          white-space: nowrap;
        }
      }

      /* Short pages keep the footer at the foot of the window. */
      main {
        flex: 1 0 auto;
        min-block-size: 60vh;
        padding-block: var(--s-6);
      }

      footer {
        color: var(--ink);
        margin-block-start: var(--s-8);
        text-align: center;
      }
      .hills {
        display: block;
        inline-size: 100%;
        block-size: 64px;
      }
      .hills-back {
        fill: var(--hill-back);
      }
      .hills-front {
        fill: var(--hill-front);
      }
      .foot {
        background: var(--paper-2);
        padding-block: var(--s-4) var(--s-6);
        max-inline-size: none;
      }
      .foot-links {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: var(--s-1) var(--s-5);
        margin-block-end: var(--s-3);
        font-weight: 700;
      }
      .foot-links a {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--tap-adult);
      }
      footer p {
        margin-block: var(--s-1);
        font-size: var(--t-ui-sm);
        color: var(--ink-2);
      }
      @media (forced-colors: active) {
        .hills {
          display: none;
        }
      }
    </style>
  </body>
</html>
