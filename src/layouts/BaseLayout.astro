---
import '@styles/global.css';
import '@styles/rtl.css';
import '@styles/accessibility-themes.css';
import LanguageSelector from '@components/LanguageSelector.astro';
import AccessibilityPanel from '@components/AccessibilityPanel.astro';
import AchievementToast from '@components/AchievementToast.astro';
import GTMTracking from '@components/GTMTracking.astro';
import WeatherOverlay from '@components/WeatherOverlay.astro';
import WeatherWidget from '@components/WeatherWidget.astro';
import SeasonalTheme from '@components/SeasonalTheme.astro';
import type { Locale } from '@utils/i18n';
import { getTranslation, isRTL } from '@utils/i18n';
import { BASE_PATH as base } from '@utils/site';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  image?: string;
  type?: 'website' | 'article';
}

const { title, description, locale = 'de', image, type = 'website' } = Astro.props;
const dir = isRTL(locale) ? 'rtl' : 'ltr';
const siteName = getTranslation(locale, 'siteName');
const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? '';
const pageUrl = `${siteUrl}${Astro.url.pathname}`;
const defaultDescription = getTranslation(locale, 'tagline');
const ogDescription = description || defaultDescription;
const ogImage = image || `${siteUrl}${base}/og-image.png`;
const pageTitle = `${title} | ${siteName}`;

// Google Tag Manager ID from environment variable
const gtmId = import.meta.env.PUBLIC_GTM_ID;
---

<!doctype html>
<html lang={locale} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <GTMTracking gtmId={gtmId} />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={ogDescription} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={ogImage} />
    <meta
      property="og:locale"
      content={locale === 'de'
        ? 'de_DE'
        : locale === 'ar'
          ? 'ar_AR'
          : locale === 'tr'
            ? 'tr_TR'
            : locale === 'ur'
              ? 'ur_PK'
              : 'en_US'}
    />
    <meta property="og:site_name" content={siteName} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={pageUrl} />
    <meta property="twitter:title" content={pageTitle} />
    <meta property="twitter:description" content={ogDescription} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Canonical URL -->
    <link rel="canonical" href={pageUrl} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <a href="#main-content" class="visually-hidden">Skip to main content</a>

    <header>
      <div class="container">
        <nav>
          <div class="nav-brand">
            <a href={locale === 'de' ? `${base}/` : `${base}/${locale}`}>
              <h1 class="site-title">{siteName}</h1>
              <p class="site-tagline">{getTranslation(locale, 'tagline')}</p>
            </a>
          </div>

          <div class="nav-links">
            <a href={locale === 'de' ? `${base}/` : `${base}/${locale}`}
              >{getTranslation(locale, 'home')}</a
            >
            <a href={locale === 'de' ? `${base}/about` : `${base}/${locale}/about`}
              >{getTranslation(locale, 'about')}</a
            >
            <a href={locale === 'de' ? `${base}/story-builder` : `${base}/${locale}/story-builder`}
              >✨ {getTranslation(locale, 'storyBuilder')}</a
            >
            <a href={locale === 'de' ? `${base}/my-stories` : `${base}/${locale}/my-stories`}
              >📚 {getTranslation(locale, 'myStories')}</a
            >
            <a href={locale === 'de' ? `${base}/progress` : `${base}/${locale}/progress`}
              >📊 {getTranslation(locale, 'progressDashboard')}</a
            >
            <a href={locale === 'de' ? `${base}/achievements` : `${base}/${locale}/achievements`}
              >🏆 {getTranslation(locale, 'achievements')}</a
            >
            <a href={locale === 'de' ? `${base}/shop` : `${base}/${locale}/shop`}
              class="nav-shop-link"
              >⭐ {getTranslation(locale, 'starShop')}</a
            >
            <a href={locale === 'de' ? `${base}/story-map` : `${base}/${locale}/story-map`}
              >🗺️ {getTranslation(locale, 'storyMap')}</a
            >
            <a href={locale === 'de' ? `${base}/games` : `${base}/${locale}/games`}
              >🎮 {getTranslation(locale, 'games')}</a
            >
            <a href={locale === 'de' ? `${base}/character-designer` : `${base}/${locale}/character-designer`}
              >🎭 {getTranslation(locale, 'characterDesigner')}</a
            >
            <a href={locale === 'de' ? `${base}/print-studio` : `${base}/${locale}/print-studio`}
              >🖨️ {getTranslation(locale, 'printStudio')}</a
            >
            <a href={locale === 'de' ? `${base}/challenges` : `${base}/${locale}/challenges`}
              >🔥 {getTranslation(locale, 'challenges')}</a
            >
            <a href={locale === 'de' ? `${base}/adventure-quests` : `${base}/${locale}/adventure-quests`}
              class="nav-quest-link"
              >⚔️ {getTranslation(locale, 'adventureQuests')}</a
            >
            <a href={locale === 'de' ? `${base}/weather-settings` : `${base}/${locale}/weather-settings`}
              >⛅ {getTranslation(locale, 'weatherSettings')}</a
            >
            <button
              class="nav-accessibility-btn"
              aria-label={getTranslation(locale, 'accessibility')}
              title={getTranslation(locale, 'accessibility')}
            >
              <span aria-hidden="true">♿</span>
            </button>
          </div>

          <LanguageSelector currentLocale={locale} currentPath={Astro.url.pathname} />
        </nav>
      </div>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <div class="container">
        <p>&copy; {new Date().getFullYear()} {siteName}</p>
        <p>
          <a
            href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
            target="_blank"
            rel="noopener"
          >
            CC BY-NC-SA 4.0
          </a>
        </p>
      </div>
    </footer>

    <!-- Accessibility Panel (Global) -->
    <AccessibilityPanel locale={locale} />

    <!-- Achievement Toast (Global) -->
    <AchievementToast />

    <!-- Weather System (Global) -->
    <WeatherOverlay />
    <WeatherWidget locale={locale} />
    <SeasonalTheme />

    <script>
      // Connect nav accessibility button to panel
      document.addEventListener('DOMContentLoaded', () => {
        const navBtn = document.querySelector('.nav-accessibility-btn');
        const panelToggle = document.querySelector('.a11y-toggle-btn');

        if (navBtn && panelToggle) {
          navBtn.addEventListener('click', () => {
            (panelToggle as HTMLElement).click();
          });
        }
      });
    </script>

    <style>
      header {
        background: white;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        position: sticky;
        top: 0;
        z-index: 1000;
      }

      nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 0;
        gap: 1rem;
        flex-wrap: wrap;
      }

      .nav-brand a {
        text-decoration: none;
        color: inherit;
      }

      .site-title {
        font-size: 1.5rem;
        margin: 0;
        color: var(--color-primary);
      }

      .site-tagline {
        font-size: 0.9rem;
        color: var(--color-text-light);
        margin: 0;
      }

      .nav-links {
        display: flex;
        gap: 1.5rem;
        align-items: center;
      }

      .nav-links a {
        font-weight: 500;
        color: var(--color-text);
        transition: color 0.2s;
      }

      .nav-links a:hover {
        color: var(--color-primary);
      }

      .nav-shop-link {
        background: linear-gradient(135deg, #FFD700, #FFA500);
        color: white !important;
        padding: 0.5rem 1rem;
        border-radius: 50px;
        box-shadow: 0 2px 8px rgba(255, 215, 0, 0.3);
        animation: shop-pulse 2s ease-in-out infinite;
      }

      .nav-shop-link:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(255, 215, 0, 0.4);
      }

      @keyframes shop-pulse {
        0%, 100% {
          box-shadow: 0 2px 8px rgba(255, 215, 0, 0.3);
        }
        50% {
          box-shadow: 0 2px 12px rgba(255, 215, 0, 0.5);
        }
      }

      .nav-accessibility-btn {
        background: transparent;
        border: 2px solid var(--color-accent);
        color: var(--color-accent);
        padding: 0.4rem 0.75rem;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.2s;
        font-size: 1.2rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: inherit;
      }

      .nav-accessibility-btn:hover {
        background: var(--color-accent);
        color: white;
        transform: scale(1.05);
      }

      .nav-accessibility-btn:active {
        transform: scale(0.95);
      }

      main {
        min-height: calc(100vh - 200px);
        padding: 2rem 0;
      }

      footer {
        background: var(--color-text);
        color: white;
        padding: 2rem 0;
        margin-top: 4rem;
        text-align: center;
      }

      footer p {
        margin: 0.25rem 0;
      }

      footer a {
        color: var(--color-secondary);
      }

      @media (max-width: 768px) {
        nav {
          flex-direction: column;
          align-items: stretch;
        }

        .nav-links {
          justify-content: center;
        }

        .site-title {
          font-size: 1.25rem;
        }
      }
    </style>
  </body>
</html>
