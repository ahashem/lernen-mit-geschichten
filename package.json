{
  "name": "lernen-mit-geschichten",
  "version": "1.0.0",
  "description": "Teaching children values and behavioral skills through interactive multilingual stories - A non-profit educational platform",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . && stylelint \"src/**/*.{css,astro}\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.{css,astro}\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "npm run format:check && npm run lint && npm run test && node scripts/publish-gates.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "keywords": [
    "education",
    "children",
    "stories",
    "multilingual",
    "i18n",
    "astro",
    "learning",
    "skills",
    "values",
    "interactive",
    "tts",
    "text-to-speech",
    "rtl",
    "accessibility",
    "german",
    "arabic",
    "turkish",
    "urdu"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ahashem/lernen-mit-geschichten.git"
  },
  "bugs": {
    "url": "https://github.com/ahashem/lernen-mit-geschichten/issues"
  },
  "homepage": "https://ahashem.github.io/lernen-mit-geschichten/",
  "author": "Lernen mit Geschichten Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/react": "^7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/andika": "^5.3.0",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/baloo-bhaijaan-2": "^5.3.0",
    "@fontsource/gulzar": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-nastaliq-urdu": "^5.3.0",
    "astro": "^7.4.7",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "swiper": "^14.4.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.67.4",
    "@rollup/rollup-linux-x64-musl": "^4.67.4"
  },
  "devDependencies": {
    "@capsizecss/unpack": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^18.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "minimatch@^10.2.2": "^11.0.5",
    "minimatch@^10.2.4": "^11.0.5",
    "minimatch@^10.2.6": "^11.0.5"
  }
}
